# Independent service only; do not inherit production environment groups or volumes.
CGU_DEMO_HOST=127.0.0.1
PORT=8000
PYTHONUNBUFFERED=1
# Local HTTP: 0. Hosted HTTPS (including TLS terminated by a trusted proxy): 1.
CGU_DEMO_SECURE_COOKIE=0
# Set when an HTTPS proxy forwards plain HTTP to the demo. No forwarded headers
# are trusted. Windows compose.yml sets this for the hosted demo automatically.
# CGU_DEMO_PUBLIC_ORIGIN=https://demo.uniway-tw.com
# No Supabase, OAuth, AI, SMTP or school-system credentials required.
# Single worker, ephemeral data; restarting the service removes all demo workspaces.
# Proxy must preserve Host. Keep --no-proxy-headers with the configured origin.
