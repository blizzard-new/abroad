# Copy of what scripts/02-generate-secrets.ps1 writes to deploy/selfhost/.env (that file is secret and never committed).
# Listed here so you can see every setting. Do not paste real values into this template.

# --- the site's address -------------------------------------------------------------------------------------------
DOMAIN=app.example.com
ACME_EMAIL=you@example.com        # Let's Encrypt writes here when a certificate is about to expire

# --- generated secrets (random, made on the server computer) -----------------------------------------------------
DB_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
VAULT_MASTER_KEY=                 # once users upload documents this can never change; keep an encrypted copy
EMAIL_VERIFICATION_SECRET=

# --- the operator's own settings ---------------------------------------------------------------------------------
CONTACT_EMAIL=                    # shown on /privacy and /terms
ADMIN_EMAILS=                     # Gmail addresses (comma separated) that may open /admin pages
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- optional ----------------------------------------------------------------------------------------------------
EXCHANGE_SEO_INDEXABLE=true       # Set false on any staging/preview deployment.
GOOGLE_SITE_VERIFICATION=        # Optional HTML verification token; keep existing DNS verification if already verified.
APP_WORKERS=1                     # Compare 1, 2, then 4 on staging; see docs/self-host-capacity.md.
                                  # OAuth/session/workspace state is in PostgreSQL. Analytics ingestion limits remain
                                  # per process; hourly metrics are merged atomically in the database.
APP_THREADS=2                     # Per worker. Compare 16 on isolated staging before increasing.
APP_CATALOGUE_CONCURRENCY=1        # Per worker. Compare 2 on staging; larger catalogues use more memory.
