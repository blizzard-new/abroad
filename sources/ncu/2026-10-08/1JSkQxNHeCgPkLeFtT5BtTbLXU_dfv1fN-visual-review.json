  "page_transcriptions": [
    {
      "page": 1,
      "text": "2026--2027 上海财经大学来校交换生信息手册。适用于持港澳台身份证件或中国护照申请人。",
      "scope": "selected_original_passages",
      "method": "human_visual"
    },
    {
      "page": 3,
      "text": "2026年秋季学期：2026年5月31日；2027年春季学期：2026年11月15日。",
      "scope": "selected_original_passages",
      "method": "human_visual"
    },
    {
      "page": 4,
      "text": "交换生申请表（所在院校提名后另行提供申请表模板供学生填写）。在校成绩单（PDF档，加盖所在院校成绩管理部门公章）。个人简历（一页A4纸篇幅，格式不限，Word档或PDF档）。个人有效身份证件扫描件。",
      "scope": "selected_original_passages",
      "method": "human_visual"
    },
    {
      "page": 5,
      "text": "我校对交换生不设定选课总学分的下限要求，具体取决于派出院校对于交换学习期间的学分要求。",
      "scope": "selected_original_passages",
      "method": "human_visual"
    },
    {
      "page": 6,
      "text": "成绩单电子版将于本学年春季学期3月前后发送，春季学期交换生成绩单电子版将于下学年秋季学期9月前后发送。",
      "scope": "selected_original_passages",
      "method": "human_visual"
    },
    {
      "page": 7,
      "text": "交换生免缴交换对应学期的上海财经大学学费。预估生活费用（衣食行等）：每月1000–1500人民币左右（仅供参考，按当地一般水平计算）。住宿通常位于上海财经大学27号楼（国定路校区后门，靠近18号线地铁站上海财经大学站）。",
      "scope": "selected_original_passages",
      "method": "human_visual"
    },
    {
      "page": 8,
      "text": "2025--2026 上海财经大学来校交换生信息手册——适用于持港澳台身份证件、中国护照申请人。",
      "scope": "selected_original_passages",
      "method": "human_visual"
    }
  ]
