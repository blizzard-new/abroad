c="/_nuxt/A.b6f36bed.png" alt="通過A無障礙網頁檢測" data-v-5cc32dd2></a><a href="https://wwwc.moex.gov.tw/main/content/wfrmContent.aspx?menu_id=159" target="_blank" title="[另開新視窗] 國家考試-電腦化測驗專區" data-v-5cc32dd2><img src="/_nuxt/moex.0bd06812.png" alt="" data-v-5cc32dd2><span class="sr-only" data-v-5cc32dd2>國家考試-電腦化測驗專區</span></a></div></div></div></div></div></footer></div></div><!--]--><!----><!--]--></div><script type="application/json" id="__NUXT_DATA__" data-ssr="true">[["Reactive",1],{"data":2,"state":488,"_errors":489,"serverRendered":24,"path":490,"pinia":491},{"webInfozh-TW":3,"customBlockzh-TW2":25,"homeNewszh-TW":56,"customBlockzh-TW1":89,"menufooterzh-TW":144,"eventIndexzh-TW":235,"menuListzh-TW":286,"bannerzh-TW":446,"newsCategoryzh-TW":478,"newsListzh-TW":486},{"data":4,"status":24,"message":5},{"style":5,"type":6,"name":7,"tel":8,"fax":9,"email":10,"service":5,"address":11,"fb_link":12,"ig_link":13,"yt_link":14,"image_path":15,"thumb_path":15,"seo_title":16,"seo_keywords":17,"seo_description":18,"ai_show":19,"ai_name":20,"ai_icon":21,"ai_iframe":22,"ai_memo":23},null,0,"校本部","(07)6577711","(07)6577056","u1208@isu.edu.tw","高雄市84001大樹區學城路一段1號","https://www.facebook.com/isu.edu.tw?fref=ts","https://instagram.com/isupublic?utm_medium=copy_link","https://www.youtube.com/channel/UCJ7lbrEbG-SOp5a1jkbKYbg","","義守大學","義守大學,ai,黃仁勳","義守大學以『跨域創新 競逐全球』為辦學特色發展主軸，強調全校將跨域整合『健康醫學x智慧科技』為核心，並以聯合國所公布的全球永續發展目標(Sustainable Development Goals, SDGs)為指導方針，引導學生跨領域、跨疆域學習，培育出有能力適應未來產業的變化、解決未來社會問題的人才，發揮豐富的跨學科領域優勢，成為最具跨域創新、產學服務能力之國際化綜合型大學。","1","AI小精靈","https://www.isu.edu.tw/storage/images/7du03ttn0bTtxx3F5gw3lBQMvUsrp8HmDof7a2Y5.png","https://ai.isu.edu.tw/isubot/","您好!我是AI小精靈，很高興為您服務~",true,{"data":26,"status":24,"message":5},[27],{"type":28,"title":29,"content":5,"blocks":30},2,"校園精​選 精彩義守",[31,38,42,47,51],{"title":32,"content":33,"ext":34,"file_path":35,"video_url":5,"url":36,"target":37},"招生資訊","招生活動","jpg","https://www.isu.edu.tw/storage/images/u9qCfYLDN7HjgRg9WdHauC3n2fd72bDWjl6xnYW