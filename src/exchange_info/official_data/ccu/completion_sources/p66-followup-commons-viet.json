"value":"2021-07-06 22:41:04","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"H\u1ed9i th\u00e1nh Tin L\u00e0nh Vi\u1ec7t Nam - Ng\u1ecdc Giao","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"PD ineligible|PD-Vietnam|PD-old missing SDC copyright status|Images of flags from Ng\u1ecdc Giao","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"ImageDescription":{"value":"A historical Vietnamese political flag image digitally recreated by Ng\u1ecdc Giao with a simple design.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"Before 1975 (original design).","source":"commons-desc-page"},"Credit":{"value":"<ul><li><a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/photos/101942465@N04/10524598083/\">Gi\u00e1o h\u1ed9i C\u00f4ng gi\u00e1o Vi\u1ec7t Nam</a> (<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/people/101942465@N04/\">Ng\u1ecdc Giao</a>).</li></ul>\n<ul><li><a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/photos/101942465@N04/10524504956/\">H\u1ed9i th\u00e1nh Tin L\u00e0nh Vi\u1ec7t Nam</a> (<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/people/101942465@N04/\">Ng\u1ecdc Giao</a>).</li></ul>\n<ul><li><a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/photos/101942465@N04/10675528116/\">\u0110\u1ea1i H\u00f9ng \u0110\u1ebf qu\u1ed1c</a> (<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/people/101942465@N04/\">Ng\u1ecdc Giao</a>).</li></ul>\n<ul><li><a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/photos/101942465@N04/10675476875/\">Vi\u1ec7t Nam Quang ph\u1ee5c H\u1ed9i</a> (<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/people/101942465@N04/\">Ng\u1ecdc Giao</a>).</li></ul>\n<ul><li><a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/photos/101942465@N04/10675749123/\">Vi\u1ec7t Nam Quang ph\u1ee5c qu\u00e2n</a> (<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/people/101942465@N04/\">Ng\u1ecdc Giao</a>).</li></ul>\n<ul><li><a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/photos/101942465@N04/10282501725/\">Li\u00ean minh D\u00e2n ch\u1ee7 Vi\u1ec7t Nam</a> (<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/people/101942465@N04/\">Ng\u1ecdc Giao</a>).</li></ul>\n<ul><li><a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/photos/101942465@N04/9898231554/\">Ph\u1eadt gi\u00e1o H\u00f2a H\u1ea3o</a> (<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/people/101942465@N04/\">Ng\u1ecdc Giao</a>).</li></ul>\n<ul><li><a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/photos/101942465@N04/9860460665/\">Tri\u1ec1u Nguy\u1ec5n (1885 - 1890)</a> (<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/people/101942465@N04/\">Ng\u1ecdc Giao</a>).</li></ul>\n<ul><li><a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/photos/101942465@N04/9897705603/\">\u0110\u1ea3ng D\u00e2n t\u1ed9c Vi\u1ec7t Nam</a> (<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/people/101942465@N04/\">Ng\u1ecdc Giao</a>).</li></ul>\n<ul><li><a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/photos/101942465@N04/9871299474/\">C\u1edd long tinh</a> (<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/people/101942465@N04/\">Ng\u1ecdc Giao</a>).</li></ul>\n<ul><li><a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/photos/101942465@N04/9774628842/\">H\u1ed9i \u00c1nh S\u00e1ng</a> (<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/people/101942465@N04/\">Ng\u1ecdc Giao</a>).</li></ul>\n<ul><li><a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/photos/101942465@N04/9774489671/\">C\u1edd Nh\u00e2n Sinh - \u0110\u1ec3 c\u1ea7u ph\u00fac cho \u0111\u1ea5t n\u01b0\u1edbc Vi\u1ec7t Nam v\u1eefng b\u01b0\u1edbc v\u01b0\u1ee3t qua nh\u1eefng kh\u00f3 kh\u0103n ch\u1ed3ng ch\u1ea5t do n\u0103m c\u0169 ph\u00e1t sinh, c\u1ed9ng \u0111\u1ed3ng blogger Vi\u1ec7t Nam m\u1eebng ng\u1ecdn c\u1edd nh\u00e2n sinh v\u00e0o n\u0103m m\u1edbi. Kh\u00e1c bi\u1ec7t so v\u1edbi nh\u1eefng ng\u1ecdn c\u1edd mang \u00fd th\u1ee9c h\u1ec7 ch\u00ednh tr\u1ecb t\u1eebng t\u1ed3n t\u1ea1i \u0111\u1ea1i di\u1ec7n cho giai c\u1ea5p th\u1ed1ng tr\u1ecb x\u00e3 h\u1ed9i, ng\u1ecdn c\u1edd m\u1edbi mang \u00fd ngh\u0129a V\u1eca NH\u00c2N SINH th\u1ec3 hi\u1ec7n mong mu\u1ed1n x\u00e2y d\u1ef1ng kinh t\u1ebf ph\u00e1t tri\u1ec3n ph\u1ee5c v\u1ee5 \u0111\u1eddi s\u1ed1ng ng\u01b0\u1eddi d\u00e2n Vi\u1ec7t Nam ng\u00e0y m\u1ed9t sung t\u00fac h\u01a1n. Ng\u1ecdn c\u1edd nh\u00e2n sinh kh\u00f4ng thay th\u1ebf cho b\u1ea5t c\u1ee9 ng\u1ecdn c\u1edd n\u00e0o v\u00ec \u0111\u00e2y l\u00e0 gi\u1ea5c m\u01a1 sinh k\u1ebf c\u1ee7a ng\u01b0\u1eddi d\u00e2n lao \u0111\u1ed9ng. Khi \u01b0\u1edbc m\u01a1 kh\u00f4ng c\u00f2n, ho\u1eb7c kh\u00f4ng c\u00f2n ng\u01b0\u1eddi m\u01a1 \u01b0\u1edbc cu\u1ed9c s\u1ed1ng t\u1ed1t \u0111\u1eb9p h\u01a1n th\u00ec ng\u1ecdn c\u1edd s\u1ebd t\u1ef1 sinh t\u1ef1 di\u1ec7t theo quy lu\u1eadt t\u1ef1 nhi\u00ean. Ng\u1ecdn c\u1edd nh\u00e2n sinh h\u01b0\u1edbng \u0111\u1ebfn 3 m\u1ee5c ti\u00eau x\u00e3 h\u1ed9i\u00a0: Gi\u00e1o d\u1ee5c kh\u00f4ng h\u1ecdc ph\u00ed - X\u00e3 h\u1ed9i kh\u00f4ng tham nh\u0169ng - Y t\u1ebf kh\u00f4ng vi\u1ec7n ph\u00ed</a> (<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/people/101942465@N04/\">Ng\u1ecdc Giao</a>).\n<ul><li>M\u00e0u c\u1edd ch\u1ee7 \u0111\u1ea1o\u00a0: M\u00e0u tr\u1eafng (#FFFFFF) v\u00e0 m\u00e0u \u0111\u1ecf (#EF4135) t\u01b0\u01a1ng ph\u1ea3n hai m\u00e0u n\u00f3ng v\u00e0 l\u1ea1nh, l\u00e0 hai m\u00e0u bi\u1ec3u t\u01b0\u1ee3ng sinh kh\u00ed \u00e2m d\u01b0\u01a1ng c\u1ee7a v\u0169 tr\u1ee5.</li></ul></li></ul>\n<ul><li><a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/photos/101942465@N04/9775469214/\">\u0110\u1ea3ng Nh\u00e2n d\u00e2n H\u00e0nh \u0111\u1ed9ng Vi\u1ec7t Nam</a> (<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/people/101942465@N04/\">Ng\u1ecdc Giao</a>).</li></ul>","source":"commons-desc-page"},"Artist":{"value":"See title for the organisation concerned.","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Public domain","source":"commons-desc-page"},"AttributionRequired":{"value":"false","source":"commons-desc-page","hidden":""},"Copyrighted":{"value":"False","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"pd","source":"commons-templates","hidden":""}}}]},"107300158":{"pageid":107300158,"ns":6,"title":"File:Ph\u1eadt gi\u00e1o H\u00f2a H\u1ea3o - Ng\u1ecdc Giao.png","index":4,"imagerepository":"local","imageinfo":[{"size":12523,"width":2000,"height":1328,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/6c/Ph%E1%BA%ADt_gi%C3%A1o_H%C3%B2a_H%E1%BA%A3o_-_Ng%E1%BB%8Dc_Giao.png/1280px-Ph%E1%BA%ADt_gi%C3%A1o_H%C3%B2a_H%E1%BA%A3o_-_Ng%E1%BB%8Dc_Giao.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":1200,"thumbheight":797,"responsiveUrls":{"2":"https://upload.wikimedia.org/wikipedia/commons/6/6c/Ph%E1%BA%ADt_gi%C3%A1o_H%C3%B2a_H%E1%BA%A3o_-_Ng%E1%BB%8Dc_Giao.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/6c/Ph%E1%BA%ADt_gi%C3%A1o_H%C3%B2a_H%E1%BA%A3o_-_Ng%E1%BB%8Dc_Giao.png/1280px-Ph%E1%BA%ADt_gi%C3%A1o_H%C3%B2a_H