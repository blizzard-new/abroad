campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":1000,"height":1333,"srcset":"https://upload.wikimedia.org/wikipedia/commons/4/49/Plantation_of_Metasequoia%2C_Dalian_University_of_Technology.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/4/49/Plantation_of_Metasequoia%2C_Dalian_University_of_Technology.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Plantation_of_Metasequoia,_Dalian_University_of_Technology.jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=82426915","extmetadata":{"DateTime":{"value":"2019-09-22 15:22:24","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Plantation of Metasequoia, Dalian University of Technology","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"China photographs taken on 2019-09-19|Metasequoia glyptostroboides in China|Plantations in China|Dalian University of Technology|Self-published work|Taken with Vivo Z3i","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"ImageDescription":{"value":"It's mid-autumn, and I thought - to find somewhere for a walk alone is a good idea... Afterwards, I found a green pine wood in the campus of Dalian University of Technology, alongside the road...  It's a normal wood, but with the uprightness like soldiers in lines.  Walking in it, the sunshine gave the warmth which made the shadow of leaves transparently yellowing your eyes with a big embrace... The wind, near noon, of that day was neither too cold nor hot, which kissed your face tenderly... I just wished to walk in quietly and slowly, as if time terminated beside my shoulder...and, we are together waiting something, someone, or somewhere... I am here and on my feet... Hopefully, your breathing of self-being will get the wind between sky and earth, and breeze onto my face and skin... Oh, it's a mid-autumn pine wood where we are in...","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2019-09-19 13:00:17","source":"commons-desc-page"},"Credit":{"value":"<span class=\"int-own-work\" lang=\"en\">Own work</span>","source":"commons-desc-page"},"Artist":{"value":"<a href=\"//commons.wikimedia.org/wiki/User:Jason_M._C.,_Han\" title=\"User:Jason M. C., Han\">Jason M. C., Han</a>","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY-SA 4.0","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Creative Commons Attribution-Share Alike 4.0","source":"commons-desc-page"},"AttributionRequired":{"value":"true","source":"commons-desc-page","hidden":""},"LicenseUrl":{"value":"https://creativecommons.org/licenses/by-sa/4.0","source":"commons-desc-page"},"Copyrighted":{"value":"True","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"cc-by-sa-4.0","source":"commons-templates","hidden":""}}}]}}}}