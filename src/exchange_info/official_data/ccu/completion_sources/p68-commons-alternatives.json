{"batchcomplete":"","continue":{"gsroffset":4,"continue":"gsroffset||"},"query":{"pages":{"81509419":{"pageid":81509419,"ns":6,"title":"File:1-s2.0-S0168900216306957-main.pdf","index":4,"imagerepository":"local","imageinfo":[{"size":4954244,"width":1239,"height":1652,"pagecount":40,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/be/1-s2.0-S0168900216306957-main.pdf/page1-960px-1-s2.0-S0168900216306957-main.pdf.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":1000,"thumbheight":1333,"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/be/1-s2.0-S0168900216306957-main.pdf/page1-960px-1-s2.0-S0168900216306957-main.pdf.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":1000,"height":1333},"url":"https://upload.wikimedia.org/wikipedia/commons/b/be/1-s2.0-S0168900216306957-main.pdf?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:1-s2.0-S0168900216306957-main.pdf","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=81509419","extmetadata":{"DateTime":{"value":"2019-08-21 13:56:40","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"1-s2.0-S0168900216306957-main","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"Geant4|2016-11-01|Media from Nuclear Instruments and Methods in Physics Research Section A","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"ImageDescription":{"value":"Geant4 is a software toolkit for the simulation of the passage of particles through matter. It is used by a large number of experiments and projects in a variety of application domains, including high energy physics, astrophysics and space science, medical physics and radiation protection. Over the past several years, major changes have been made to the toolkit in order to accommodate the needs of these user communities, and to efficiently exploit the growth of computing power made available by advances in technology. The adaptation of Geant4 to multithreading, advances in physics, detector modeling and visualization, extensions to the toolkit, including biasing and reverse Monte Carlo, and tools for physics and release validation are discussed here.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2016-11-01","source":"commons-desc-page"},"Credit":{"value":"<p><a rel=\"nofollow\" class=\"external free\" href=\"https://www.sciencedirect.com/science/article/pii/S0168900216306957\">https://www.sciencedirect.com/science/article/pii/S0168900216306957</a>\n</p>\n<a rel=\"nofollow\" class=\"external free\" href=\"https://doi.org/10.1016/j.nima.2016.06.125\">https://doi.org/10.1016/j.nima.2016.06.125</a>","source":"commons-desc-page"},"Artist":{"value":"J.Allison et al.","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY 4.0","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Creative Commons Attribution 4.0","source":"commons-desc-page"},"AttributionRequired":{"value":"true","source":"commons-desc-page","hidden":""},"LicenseUrl":{"value":"https://creativecommons.org/licenses/by/4.0","source":"commons-desc-page"},"Copyrighted":{"value":"True","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"cc-by-4.0","source":"commons-templates","hidden":""}}}]},"99081791":{"pageid":99081791,"ns":6,"title":"File:Congressional Record 1966-06-01- Vol 112 (IA sim congressional-record-proceedings-and-debates 1966-06-01 112).pdf","index":3,"imagerepository":"local","imageinfo":[{"size":333794191,"width":1043,"height":1500,"pagecount":624,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/0c/Congressional_Record_1966-06-01-_Vol_112_%28I