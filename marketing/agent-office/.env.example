# 複製成 .env 後填入。.env 不會進 Git。

# ---- 辦公室 ----
OFFICE_DRY_RUN=1                 # 1＝模擬發佈（只寫進 var/outbox/，不會真的發）；確認都設定好再改成 0
OFFICE_APPROVAL=manual           # manual＝每則都等你核准；auto＝審稿通過就自動排程（留言回覆永遠要人工核准）
OFFICE_WRITER=auto               # auto＝有 Claude 金鑰就用 Claude，否則用離線範本；也可指定 claude / offline
OFFICE_MODEL=claude-opus-5-5     # 想省錢可改 claude-sonnet-5-5
OFFICE_TIMEZONE=Asia/Taipei
OFFICE_DAILY_AT=07:30            # 每天幾點開工（企劃、寫稿、做圖、剪片）
OFFICE_THREADS_SLOTS=12:30,21:00 # Threads 發文時間，一個時間一篇
OFFICE_INSTAGRAM_SLOT=19:30      # IG 輪播或 Reels；限動在 15 分鐘後
OFFICE_YOUTUBE_SLOT=18:00        # YouTube Shorts；週日長影片晚一小時
OFFICE_LONG_VIDEO_WEEKDAY=6      # 0＝週一 … 6＝週日
OFFICE_ANALYTICS_AT=23:30
OFFICE_VIDEO_FPS=30
# OFFICE_ACCESS_TOKEN=換成一串很長的亂數   # 辦公室網頁要對外開放時一定要設；開啟網址加 ?token=…
# CHROMIUM_PATH=/path/to/chrome           # Playwright 找不到瀏覽器時指定

# ---- Claude（寫稿與審稿）----
# ANTHROPIC_API_KEY=sk-ant-...

# ---- Threads ----
# THREADS_USER_ID=
# THREADS_ACCESS_TOKEN=          # 也可以用 `uv run office auth threads --short-token …` 換長期 token
# THREADS_APP_SECRET=

# ---- Instagram（Instagram API with Instagram Login）----
# INSTAGRAM_USER_ID=
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_APP_SECRET=
# INSTAGRAM_GRAPH_HOST=graph.instagram.com

# ---- YouTube ----
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REFRESH_TOKEN=         # 用 `uv run office auth youtube` 取得
# YOUTUBE_PRIVACY=private        # API 專案通過 YouTube 稽核前，上傳的影片一律是私人

# ---- 圖片／影片的公開網址（Instagram、Threads 只能從網址抓檔）----
# OFFICE_MEDIA_HOST=supabase     # supabase 或 static
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_MARKETING_BUCKET=marketing-media
# OFFICE_PUBLIC_BASE_URL=https://office.example.com   # static 模式：這台機器對外的網址
