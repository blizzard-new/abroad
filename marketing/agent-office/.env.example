# 複製成 .env 後填入。.env 不會進 Git。

# ---- 辦公室 ----
OFFICE_DRY_RUN=1                 # 1＝模擬發佈（只寫進 var/outbox/，不會真的發）；確認都設定好再改成 0
OFFICE_APPROVAL=manual           # manual＝每則都等你核准；auto＝審稿通過就自動排程（留言回覆永遠要人工核准）
OFFICE_TIMEZONE=Asia/Taipei
OFFICE_DAILY_AT=07:30            # 每天幾點開工（企劃、寫稿、做圖、剪片）
OFFICE_THREADS_SLOTS=12:30,21:00 # Threads 發文時間，一個時間一篇
# OFFICE_THREADS_IMAGES=0          # Threads 預設附一張 4:5 圖卡；設 0 只發純文字
OFFICE_INSTAGRAM_SLOT=19:30      # IG 輪播或 Reels；限動在 15 分鐘後
OFFICE_YOUTUBE_SLOT=18:00        # YouTube Shorts；週日長影片晚一小時
OFFICE_LONG_VIDEO_WEEKDAY=6      # 0＝週一 … 6＝週日
OFFICE_ANALYTICS_AT=23:30
OFFICE_VIDEO_FPS=30
# OFFICE_ACCESS_TOKEN=換成一串很長的亂數   # 辦公室網頁要對外開放時一定要設；開啟網址加 ?token=…
# CHROMIUM_PATH=/path/to/chrome           # Playwright 找不到瀏覽器時指定

# ---- 每張桌子用哪個 AI ----
# 主腦（總管，你跟它聊天、它分派工作）：Antigravity；寫文案與影片腳本：Claude Code；審稿與生圖：Codex；
# 查資料、數據、發文前檢查：Antigravity。
# 可用：claude-code、codex、antigravity、api（Claude API）、offline（離線範本）、auto（有 Claude API 金鑰就用，否則離線）
# 這台電腦要先安裝並登入要用的工具（claude、codex、agy）。沒裝或額度用完時，依 OFFICE_BRAIN_FALLBACK 往下換。
OFFICE_BRAINS=chief=antigravity,research=antigravity,strategist=claude-code,threads=claude-code,designer=claude-code,video=claude-code,community=claude-code,reviewer=codex,publisher=antigravity,analyst=antigravity
OFFICE_BRAIN_FALLBACK=claude-code,api,offline
OFFICE_IMAGES=codex              # IG 封面插圖交給 Codex 畫（none＝只用版型）
OFFICE_BRAIN_TIMEOUT=600         # 每次呼叫最多等幾秒
# OFFICE_CLAUDE_CODE_MODEL=opus  # 不填就用 Claude Code 的預設模型
# OFFICE_CODEX_MODEL=
# OFFICE_ANTIGRAVITY_COMMAND=agy -p   # Antigravity CLI 的參數還在變，先跑 `agy --help` 確認，必要時改這行
# OFFICE_CLAUDE_CODE_COMMAND=claude
# OFFICE_CODEX_COMMAND=codex

# ---- Claude API（選用：當備援，或改用 api 當某張桌子的大腦）----
# ANTHROPIC_API_KEY=sk-ant-...   # Claude Code 執行時會自動拿掉這個變數，讓它用你的訂閱
# OFFICE_MODEL=claude-opus-5-5   # api 用的模型；想省錢可改 claude-sonnet-5-5

# ---- Threads ----
# 只要填 APP_SECRET，再跑 `uv run office auth threads --token <後台產生的權杖>`：會換成約 60 天的長期權杖、
# 查出是哪個帳號，存進 var/office.sqlite3，下面兩行就不用填（想手動貼才填）。
# THREADS_APP_SECRET=
# THREADS_USER_ID=
# THREADS_ACCESS_TOKEN=

# ---- Instagram（Instagram API with Instagram Login）----
# 同上：`uv run office auth instagram --token <後台產生的權杖>`。
# INSTAGRAM_APP_SECRET=
# INSTAGRAM_USER_ID=
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_GRAPH_HOST=graph.instagram.com

# ---- YouTube ----
# 填好 ID 和密鑰後跑 `uv run office auth youtube`，授權會自動存好。
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REFRESH_TOKEN=         # 想手動貼才填
# YOUTUBE_PRIVACY=private        # API 專案通過 YouTube 稽核前，上傳的影片一律是私人

# ---- GitHub：同事發現官網和平台資料有落差時，你核准的「資料更新提案」由 Pat 開成 draft PR ----
# 權杖建一個只選 blizzard-new/abroad 這個 repo、只給 Contents 與 Pull requests 讀寫的 fine-grained 權杖（見 README「資料更新提案與 draft PR」），
# 再跑 `uv run office auth github`（會問你貼權杖，存進 var/office.sqlite3）；想手動貼也可以填下面這行。
# OFFICE_GITHUB_TOKEN=github_pat_...
# OFFICE_GITHUB_REPO=blizzard-new/abroad
# OFFICE_GITHUB_BASE=main
# 1＝模擬（PR 只寫進 var/outbox/，不會真的開）；0＝真的開。不填就跟著 OFFICE_DRY_RUN，所以想先真的開 PR、社群貼文繼續模擬，就設 0。
# OFFICE_GITHUB_DRY_RUN=1

# ---- 圖片／影片的公開網址（Instagram、Threads 只能從網址抓檔）----
# OFFICE_MEDIA_HOST=supabase     # supabase 或 static
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_MARKETING_BUCKET=marketing-media
# OFFICE_PUBLIC_BASE_URL=https://office.example.com   # static 模式：這台機器對外的網址

# ---- 手機：跟 Leo 說話、收通知（見 README「用手機跟 Leo 說話」）----
# TELEGRAM_BOT_TOKEN=            # 在 Telegram 找 @BotFather 傳 /newbot 取得；再跑 `uv run office auth telegram`
# OFFICE_URL=http://my-pc:8780   # 手機打開辦公室的網址（例如 Tailscale），通知裡會附上
