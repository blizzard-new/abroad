  "source_fetches_this_round": 0,
  "scope_note": "All 39 briefing pages and all four non-Japanese table pages were text-read and visually reviewed. This completes reading these two archived mother-school PDFs, not verification of every partner datum, current host factsheet, or current nomination quota.",
  "review_recovery_note": "The first multi-image display for pages 25-31 was truncated; these pages were displayed again in batches of three or fewer before recording completed visual review.",
  "followups": [
    {
      "pages": [
        25,
        26
      ],
      "finding": "The slide expressly distinguishes agreement quotas from current selection quotas; the latest factsheets require FJU M365 login. The embedded Seoul fee/course screenshot has no visible effective term and is not current cost verification."
    },
    {
      "pages": [
        24,
        28
      ],
      "finding": "Historical table screenshots and general English-taught Japan examples do not override the individual non-Japanese table, including suspended Osaka University of Commerce."
    },
    {
      "pages": [
        30
      ],
      "finding": "The general US TOEIC prohibition conflicts with the Temple row listing listening/reading 390 each. Keep the individual row as mother-reference evidence and require current host confirmation."
    },
    {
      "pages": [
        12
      ],
      "finding": "The generic spring May application month does not independently establish or replace the historical 115-2 exact deadline; obtain that specific notice before changing its April text."
    },
    {
      "pages": [
        5,
        9,
        14,
        30,
        38
      ],
      "finding": "Enrollment, transfer, graduating-student exceptions, one school-level exchange per degree, major compatibility, and cancellation conditions remain only partially represented in qualification inputs and paths."
    },
    {
      "pages": [
        14
      ],
      "finding": "The mixed undergraduate/graduate slide list and news 1062 undergraduate-specific 70 average cannot establish a graduate 70 minimum without clarification."
    },
    {
      "pages": [
        16,
        33,
        34
      ],
      "finding": "Generic dean-stamp wording is broader than the application form conditional endorsement rules. Retain the form-specific conditions; CV at most two pages, Chinese study plan at least 500 characters and at most two A4 pages."
    },
    {
      "pages": [
        21,
        36
      ],
      "finding": "Recommendation months are not exact deadlines or host admission. Deposit amount and waiver details require the current notice; rejection does not authorize reassignment to another school."
    },
    {
      "pages": [
        37
      ],
      "finding": "The regional credit-conversion table is reference guidance, not a promise of recognition. Examples show 3 ECTS to 1 FJU credit and 5 ECTS to 2; departmental approval and specific course context remain necessary."
    },
    {
      "pages": [
        7,
        25,
        29,
        31
      ],
      "finding": "Housing, scholarship, credit recognition and admission are not guaranteed; host calendar, courses, current fees, rankings and living costs require their own dated sources. General regional examples are not individual host verification."
    }
  ],
