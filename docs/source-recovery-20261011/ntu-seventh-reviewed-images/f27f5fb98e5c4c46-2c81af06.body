    <div class="page-header support">
        <h1 class="page-header-ttl">Support and Exchange Activities</h1>
    </div>

    <div class="page-body">
        <main>
            <div class="breadcrumb">
                <ul>
                    <li><a href="https://global.ynu.ac.jp/en/">Home</a></li>
                                            <li><a href="https://global.ynu.ac.jp/en/support/">Support and Exchange Activities</a></li>
                        <li>Accommodations for International Students</li>
                                    </ul>
            </div>
            <div class="main-inner">
                <article>
                    <div class="article-head">
                                                    <h2 class="ttl">Accommodations for International Students</h2>
                                                                            <div class="anchor-link">
                                <ul>
                                                                            <li>
                                            <a href="#section-1">
                                                <span class="txt">Guideline for how to search for rental properties and how to live there</span>
