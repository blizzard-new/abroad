    <!--==Table Area Start================-->
    <div class="table-area">
        <table>
                            <tr>
                                                                        <td style="background-color:#a9f5f2" width="%"><span class="strong">Fees</span></td>
                                                                                                <td style="background-color:#a9f5f2" width="%"><span class="strong">Estimated Amount</span></td>
                                                            </tr>
                            <tr>
                                                                        <td width="%">Room rent including utilities</td>
                                                                                                <td width="%">35,000 JPY / month</td>
                                                            </tr>
                            <tr>
                                                                        <td width="%">National Health Insurance</td>
                                                                                                <td width="%">2,000 JPY / month</td>
                                                            </tr>
                            <tr>
                                                                        <td width="%">Food</td>
                                                                                                <td width="%">30,000 JPY - 50,000 JPY (varies depending on your lifestyle)</td>
                                                            </tr>
                            <tr>
                                                                        <td width="%">Others (books, travel, medical, etc.)</td>
                                                                                                <td width="%">30,000 JPY - 50,000 JPY (varies depending on your lifestyle)</td>
                                                            </tr>
                            <tr>
                                                                        <td width="%"><span class="strong">Total</span></td>
                                                                                                <td width="%"><span class="strong">97,000 JPY - 137,000 JPY (varies depending on your lifestyle)</span></td>
                                                            </tr>
