                            <tr>
                                                                        <td style="background-color:#a9f5f2" width="%"><span class="strong">Fees</span></td>
                                                                                                <td style="background-color:#a9f5f2" width="%"><span class="strong">Estimated Amount</span></td>
                                                            </tr>
                            <tr>
                                                                        <td width="%">Admission</td>
                                                                                                <td width="%">N/A</td>
                                                            </tr>
                            <tr>
                                                                        <td width="%">Tuition</td>
                                                                                                <td width="%">None for exchange students</td>
                                                            </tr>
                            <tr>
                                                                        <td width="%">Non-refundable application and<br />
maintenance fee for dormitory</td>
                                                                                                <td width="%">10,000 JPY / upon move-in only</td>
                                                            </tr>
                            <tr>
                                                                        <td width="%">Rental bedding (if needed)</td>
                                                                                                <td width="%">6,600 JPY / once only</td>
                                                            </tr>
                            <tr>
                                                                        <td width="%">Text books</td>
                                                                                                <td width="%">15,000 JPY - 30,000 JPY (varies depending on classes) / semester</td>
                                                            </tr>
                            <tr>
                                                                        <td rowspan="4" colspan="1" width="%"><span class="strong">Total</span></td>
                                                                                                <td rowspan="4" colspan="1" width="%"><span class="strong">31,600 JPY - 46,600 JPY </span></td>
                                                            </tr>
                            <tr>
                                                                                                                            </tr>
                            <tr>
                                                                                                                            </tr>
                            <tr>
                                                                                                                            </tr>
                    </table>
