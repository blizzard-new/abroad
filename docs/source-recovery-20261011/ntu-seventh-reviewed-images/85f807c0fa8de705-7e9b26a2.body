                                                    <div class="img">
                                                        <img src="https://global.ynu.ac.jp/en/wp-content/uploads/sites/2/2025/01/20250122_030958560_iOS-scaled-e1738206947741.jpg" >
                                                                                                            </div>
                                                    <div class="img">
                                                        <img src="https://global.ynu.ac.jp/en/wp-content/uploads/sites/2/2025/01/20250122_032536412_iOS-scaled.jpg" >
                                                                                                            </div>
                                                </div>
                                                                                    
                                                                                
                                        
                                        
                                                                            
                                        
                                        
                                        
                                        
                                                                                                                                                                            <div class="imgs">
                                                    <div class="img">
                                                        <img src="https://global.ynu.ac.jp/en/wp-content/uploads/sites/2/2025/01/20250122_031409112_iOS.jpg" >
                                                                                                            </div>
                                                    <div class="img">
                                                        <img src="https://global.ynu.ac.jp/en/wp-content/uploads/sites/2/2025/01/20250122_033119910_iOS-scaled.jpg" >
                                                                                                            </div>
                                                </div>
                                                                                    
                                                                                
                                        
                                        
                                                                    </div>
                                                            <div class="article-content" id="section-7">
                                    
                                                                            
                                                                                    <h5>Voices from Former JOY Program Students</h5>
                                        
                                                                                                                                    <p>※Please note that the experiences and host university described reflect the circumstances at the time of the exchange.</p>
                                                                                    
                                        
                                        
                                                                                
                                                                                
                                        
                                        
                                                                            
                                        
