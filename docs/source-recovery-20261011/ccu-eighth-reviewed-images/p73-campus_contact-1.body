<script>
document.addEventListener("DOMContentLoaded", function () {

  const cuTabs = document.querySelectorAll(".cuLab-tab");
  const cuCards = document.querySelectorAll(".cuLab-card");

  function filterCards(filter) {
    cuCards.forEach(card => {
      if (filter === "all" || card.classList.contains(filter)) {
        card.style.display = "block"; // or "" if using flex/grid
      } else {
        card.style.display = "none";
      }
    });
  }

  // Click event
  cuTabs.forEach(tab => {
    tab.addEventListener("click", () => {

      cuTabs.forEach(btn => btn.classList.remove("active"));
      tab.classList.add("active");

      const filter = tab.getAttribute("data-filter");
      filterCards(filter);

    });
  });

  // ✅ Apply default active tab filter on page load
  const activeTab = document.querySelector(".cuLab-tab.active");
  if (activeTab) {
    filterCards(activeTab.getAttribute("data-filter"));
  }

});
</script>
<script>

/*const sections = document.querySelectorAll('.infra-section');
