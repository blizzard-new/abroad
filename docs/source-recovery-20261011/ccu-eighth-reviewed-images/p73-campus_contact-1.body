.footer-links-desktop h4 { font-style: normal;font-weight: bold;font-size: 18px;line-height: 40px;color: #FFFFFF; margin: 0;font-family: var(--menu-font);}
.footer-links-desktop ul {margin: 0;padding: 0;}
.footer-links-desktop ul li {margin: 0; padding: 4px 0;}
.footer-links-desktop ul li a {font-style: normal; font-weight: normal;font-size: 16px;line-height: 25px; letter-spacing: -0.02em; color: #FFFFFF; text-decoration: none;
    font-family: var(--menu-font);   text-decoration: none;}
.footer-links-desktop {padding-left: 26px; border-left: 0.5px solid #82828275;}
.mob-foot-logos { width: 100%; display: flex; align-items: center;  justify-content: flex-start;  margin-bottom: 14px;}
.chitkara-address { width: 100%; float: left;  padding: 10px 0px;}
.chitkara-address p {  font-style: normal;    font-weight: normal;    font-size: 16px;    line-height: 22px;    color: #ffffff;    margin: 0px 0px 6px 0px;}
.chitkara-address span {    font-style: normal;    font-weight: normal;    font-size: 14px;    line-height: 20px;    color: #ffffff;}


.social-icons {  list-style: none;  display: flex;  gap: 8px;  padding: 0;  margin: 0px 0px 30px 0px; }
.social-icons li {width: 40px;  height: 40px;  background: var(--foundation-grey-200, #272727);  display: flex;  align-items: center;  justify-content: center;  cursor: pointer;  border: 1px solid transparent; transition: background 0.3s ease, border-color 0.3s ease; flex-basis: calc(20% - 0px) !important;  max-width: 40px;}
.social-icons li:hover {/*background: #000;*/ border-color: #fff;}
.social-icons li img{vertical-align: middle;}


.footerCUTxt {background: #000; overflow:hidden;}
.footerCUTxt h2{text-align: center; margin:0px 1px -15px 0px;
font-family:'Inter Tight', sans-serif !important;
font-size: clamp(36px, 8vw, 106px);
font-style: normal;
font-weight: 900;
line-height: 100%; 
text-transform: uppercase;
background: linear-gradient(180deg, rgba(48, 48, 48, 0.50) 0%, rgba(150, 150, 150, 0.40) 100%);
background-clip: text;
-webkit-background-clip: text;
-webkit-text-fill-color: transparent;}

.social-wrapper{clear:both;}
@media only screen and (min-width: 768px) and (max-width: 1199px) {
	.cAddressCU b{font-size: 13px;  line-height: 22px;}
	.cAddressCU p{font-size: 13px;  line-height: 22px;}
	.footerMenuTabNew li a{font-size: 13px;  line-height: 22px; padding: 7px 15px 7px 0;}
	.footerMenuTabNew li a:hover{font-size: 13px; line-height: 22px;}
	.footerMenuTabNew li a:hover::after{font-size: 13px;}
}


@media only screen and (max-width: 767px) {
	.formSection .container{background:#1a1a1a;padding: 20px 0px 80px;}
	.formSection{margin: 30px 0px 0px;}
	.footer_background{display:none;}
	.footerCUMainNew{display:none;}
	.testimonialsSection{margin-top: -30px;}	 
	.section3-mobile {width: 100%; float: left; padding: 30px 0px; background: #EAEAEA;}
	.CUMobileFooterNew {width: 100%; background: #000; padding: 40px 0px; display: block;margin-top: 0px;}
	.cAddress b{font-weight: 500;font-size:14px;margin-bottom:4px;}
	.cAddress p{font-size: 12px;  line-height: 20px;}
	.mob-foot-logos {width: 100%;display: flex;margin-bottom: 14px;}
	.foot-copy-right-text { width: 100%;margin-bottom: 25px; margin-top: 0px; float: left}
	.foot-copy-right-text span {font-style: normal; font-weight: normal;font-size: 12px;line-height: 24px;color: #FFFFFF;}
	.foot-copy-right-textNew{width: 100%;padding-bottom: 4px;}
	.foot-copy-right-textNew span { font-style: normal;     font-weight: 500; font-size: 12px;  line-height: 24px;   color: #f9f9f9;font-family: var(--menu-font); }
	.footer-term-text { width: 100%;}
	.footer-term-text a {font-style: normal; font-weight: 500;font-size: 12px;line-height: 24px; color: #f9f9f9; cursor: pointer;font-family: var(--menu-font);    }
	.footer-term-text a:hover{color:#f9f9f9;font-family: var(--menu-font);}
	.footer-term-text span {font-style: normal;font-weight: normal;font-size: 14px; line-height: 24px;color: #FFFFFF; padding: 0 4px; display: block;}
	
	.footerAccordianMobileNew .accordion-item {background-color: transparent; border: none;    border-radius: 0px !important;   margin-bottom: 0px; font-family: var(--menu-font);  }
	.footerAccordianMobileNew .accordion-item button.accordion-button.collapsed {  background: #000 !important; height: 50px !important; border-bottom: 1px solid #363636;font-family: var(--menu-font); 
	border-radius: 0px !important; box-shadow: none; font-style: normal;  font-weight: 500;  font-size: 14px;  color: #f9f9f9;    padding: 0;  }
	.footerAccordianMobileNew .accordion-button:not(.collapsed) { background-color: #000; font-size: 14px; padding: 0px; height: 50px;font-weight:500; font-family: var(--menu-font);color: #fff; }
	.footerAccordianMobileNew .accordion-item .accordion-collapse ul { width: 100%;  padding: 0px 0px 10px 0px;  margin-top: 0;margin-bottom: 0px;border-bottom: 1px solid #363636;}
	.footerAccordianMobileNew .accordion-item .accordion-collapse ul li { text-align: left; border-bottom: 0px; padding: 7px 0px; margin: 0; }
	.footer-links li a {text-decoration: none;color: #f9f9f9; font-family: var(--menu-font); font-size: 12px;font-weight:400;}
	.footerAccordianMobileNew { width: 100%;  margin-bottom: 30px; position:relative; }
	
	
	.footerAccordianMobileNew .accordion-item .accordion-collapse { border: 0px solid #E3000F; border-top-width: 0px; border-top-style: solid; border-top-color: rgb(227, 0, 15);
	border-top: none;  width: 100%;   float: left;    margin-bottom: 8px;  }
	.footerAccordianMobileNew .accordion-item .accordion-collapse .accordion-body {  padding: 0;  }
	.footerAccordianMobileNew .accordion-button:not(.collapsed)::after {  background-position: 0px;   width: 14px;  height: 8px; 
	background-image: url(https://www.chitkara.edu.in/wp-content/themes/chitkara/images/2025/home-page/footer-acc-iconD.svg); }
	.footerAccordianMobileNew .accordion-button::after { background-image: url(https://www.chitkara.edu.in/wp-content/themes/chitkara/images/2025/home-page/footer-acc-icon.svg);
	width: 8px;    height: 14px;  }
	
	.footerAccordianMobileNew .accordion-button::after {flex-shrink: 0; margin-left: auto;content: ""; background-repeat: no-repeat;  background-size: 100%;
  transition: transform .2s ease-in-out;}
  .footerAccordianMobileNew .accordion-button {  position: relative;  display: flex;  align-items: center;  width: 100%; -webkit-appearance: none; border:0px; cursor: pointer;}
	.footerAccordianMobileNew .accordion-header { margin-bottom: 0;}
	.footerAccordianMobileNew .accordion-button:not(.collapsed):hover {}
	.accordion-button:focus {    border-color: none!important;    box-shadow: none!important; outline: 0px dotted;}
	.social-icons{position:relative; margin: 0px 0px 28px 0px;    padding-bottom: 36px;}
	.social-icons:after{content: "";  bottom: 0px;  position: absolute;  width: 100%;  height: 1px; background: linear-gradient(270deg, rgba(255, 255, 255, 0.06) 0%, rgba(255, 255, 255, 0.70) 50%, rgba(255, 255, 255, 0.06) 100%);}
	.footerCUTxt {padding-bottom: 100px;}
	.footerCUTxt h2{margin: 0;font-size: clamp(29px, 7vw, 106px); }
}
</style>

