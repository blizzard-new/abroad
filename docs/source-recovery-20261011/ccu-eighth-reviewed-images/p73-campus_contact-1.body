<script>

function openLeadershipPopup(card) {

    document.getElementById('popupNameMDclousre').textContent =
        card.dataset.name;

    document.getElementById('popupDesignationMDclousre').textContent =
        card.dataset.designation;

    document.getElementById('popupDepartmentMDclousre').textContent =
        card.dataset.department;

    document.getElementById('popupJoiningMDclousre').textContent =
        card.dataset.joining;

    document.getElementById('popupEmailMDclousre').textContent =
        card.dataset.email;

    document.getElementById('popupAcademicMDclousre').textContent =
        card.dataset.academic;

    document.getElementById('popupResearchMDclousre').textContent =
        card.dataset.research;

    document.getElementById('popupAdministrativeMDclousre').textContent =
        card.dataset.administrative;

    document.getElementById('popupPublicationsMDclousre').textContent =
        card.dataset.publications;

    document.getElementById('popupAwardsMDclousre').textContent =
        card.dataset.awards;

    document.getElementById('popupImageMDclousre').src =
        card.dataset.image;

    document.getElementById('popupImageMDclousre').alt =
        card.dataset.name;

    document.getElementById('leadershipPopupMDclousre').classList.add('active');

    document.body.style.overflow = 'hidden';
}


/* Close button */

document.querySelector('.leadership-popup-closeMDclousre')
    .addEventListener('click', function () {

        document.getElementById('leadershipPopupMDclousre')
            .classList.remove('active');

        document.body.style.overflow = '';

    });


/* Click outside popup */

document.querySelector('.leadership-popup-overlayMDclousre')
    .addEventListener('click', function () {

        document.getElementById('leadershipPopupMDclousre')
            .classList.remove('active');

        document.body.style.overflow = '';

    });


/* ESC */

document.addEventListener('keydown', function (e) {

    if (e.key === 'Escape') {

        document.getElementById('leadershipPopupMDclousre')
            .classList.remove('active');

        document.body.style.overflow = '';

    }

});

</script>
<script>
    $(document).ready(function() {

        // Scroller 1 - .scrollWrapper
        const scrollWrapper = document.querySelector('.scrollWrapper');
        if (scrollWrapper) {
            const scrollItems = [...scrollWrapper.children];
            scrollItems.forEach((item) => {
                const clonedItem = item.cloneNode(true);
                scrollWrapper.appendChild(clonedItem);
            });
        }

        // Scroller 2 - .scrollWrapperN (gallery with fancybox)
        const scrollWrapperN = document.querySelector('.scrollWrapperN');
        if (scrollWrapperN) {
            // Mark originals BEFORE cloning
            [...scrollWrapperN.querySelectorAll('[data-fancybox="gallery"]')].forEach(el => {
                el.classList.add('gallery-original');
            });

            // Clone all items
            const originalItems = [...scrollWrapperN.children];
            originalItems.forEach((item) => {
                const clonedItem = item.cloneNode(true);
                // Remove gallery-original from clones
                clonedItem.querySelectorAll('.gallery-original').forEach(el => {
                    el.classList.remove('gallery-original');
                });
                scrollWrapperN.appendChild(clonedItem);
            });

            // Remove data-fancybox from ALL links to prevent auto-bind
            $('[data-fancybox="gallery"]').removeAttr('data-fancybox');
        }

        // Fancybox manual click handler
        $(document).on('click', '.gallery-original', function(e) {
            e.preventDefault();

            const items = [];
            $('.gallery-original').each(function() {
                items.push({ src: $(this).attr('href'), type: 'image' });
            });

            const index = $('.gallery-original').index(this);

            $.fancybox.open(items, {
                loop: true,
                buttons: ["zoom", "slideShow", "fullScreen", "download", "thumbs", "close"],
            }, index);
        });

    });
</script>


