<script>

 

function trim(s)
{
	var l=0; var r=s.length -1;
	while(l < s.length && s[l] == ' ')
	{	l++; }
	while(r > l && s[r] == ' ')
	{	r-=1;	}
	return s.substring(l, r+1);
}
function ValidateEmail(inputText)  
{  
    var mailformat = /^\w+([\.-]?\w+)*@\w+([\.-]?\w+)*(\.\w{2,3})+$/;  
     if(inputText.match(mailformat)) {  
      return true;  
    }  
    else  {  
      return false;  
    }  
}  

function showValidationMessage(message) {
	document.getElementById('err3PF').innerHTML=message;
	document.getElementById('err3PF').style.display='';
	document.getElementById('btnLPF').style.display='none';
	document.getElementById('btnS').style.display='';
	
	setTimeout(function() {
        document.getElementById('err3PF').innerHTML="";
		document.getElementById('err3PF').style.display='none';
		document.getElementById('btnLPF').style.display='none';
		document.getElementById('btnS').style.display='';
    }, 2000); // 3000 milliseconds = 3 seconds
}

function innerValidatePF()
{
			
           var x = trim(document.getElementById('your-namePF').value);
           var y = trim(document.getElementById('tel-426PF').value);
		   var z = trim(document.getElementById('emailPF').value);
           
		    document.getElementById('btnLPF').style.display=''; 
		   document.getElementById('btnS').style.display='none';
		   document.getElementById('err1PF').style.display='none';
		   document.getElementById('err3PF').style.display='none';
		   document.getElementById('err2PF').style.display='none';
		   document.getElementById('err4PF').style.display='none';
		   var regex = /^[a-zA-Z. ]*$/;
		   if (x=='') {
			  document.getElementById('err1PF').innerHTML='Enter your name';
			  document.getElementById('err1PF').style.display='';
			  document.getElementById('btnS').style.display='';
				document.getElementById('btnLPF').style.display='none'; 
			  document.getElementById('your-namePF').focus();
            
           }
           else if (!regex.test(x)) {
			  document.getElementById('err1PF').innerHTML='Invalid Name';
			  document.getElementById('err1PF').style.display='';
			  document.getElementById('btnS').style.display='';
				document.getElementById('btnLPF').style.display='none'; 
			  document.getElementById('your-namePF').focus();
            
           }
           if (y=='') {
  			  document.getElementById('err2PF').innerHTML='Enter your mobile no.';
			  document.getElementById('err2PF').style.display='';
			  document.getElementById('btnS').style.display='';
				document.getElementById('btnLPF').style.display='none'; 
			  document.getElementById('tel-426PF').focus();
             
           }
           else if(isNaN(y)||y.indexOf(" ")!=-1)
           {
			  document.getElementById('err2PF').innerHTML='Enter numeric value';
			  document.getElementById('err2PF').style.display='';
			  document.getElementById('btnS').style.display='';
