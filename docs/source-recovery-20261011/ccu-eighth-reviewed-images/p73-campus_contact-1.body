<script>
$(window).scroll(function() {

    if ($(this).scrollTop()>100)
     {
        $('#logo1').hide();
     }
    else
     {
      $('#logo1').hide();
     }
 });
 
 $(window).scroll(function() {

    if ($(this).scrollTop()>100)
     {
        $('#logo2').show();
     }
    else
     {
      $('#logo2').hide();
     }
 });
</script>

