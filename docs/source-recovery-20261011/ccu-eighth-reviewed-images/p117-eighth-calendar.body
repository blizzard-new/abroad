               <table class="table"><caption>Fall 2027 Calendar</caption><thead><tr><th style="width:20%;">Date(s)</th><th style="width:20%;">Day(s)</th><th style="width:60%;">Description</th></tr></thead><tbody><tr><td style="width:20%;">August 20-22</td><td style="width:20%;">Friday-Sunday</td><td style="width:60%;">New Student Arrival &amp; Orientation</td></tr><tr><td style="width:20%;">August 23</td><td style="width:20%;">Monday</td><td style="width:60%;">Classes Begin</td></tr><tr><td style="width:20%;">September 6</td><td style="width:20%;">Monday</td><td style="width:60%;">Labor Day. No classes.</td></tr><tr><td style="width:20%;">September 22</td><td style="width:20%;">Wednesday</td><td style="width:60%;">Grow, Thrive, Live Day</td></tr><tr><td style="width:20%;">October 11</td><td style="width:20%;">Monday</td><td style="width:60%;">No classes</td></tr><tr><td style="width:20%;">October 12</td><td style="width:20%;">Tuesday</td><td style="width:60%;">No classes</td></tr><tr><td style="width:20%;">November 4</td><td style="width:20%;">Thursday</td><td style="width:60%;">Grow, Thrive, Live Day</td></tr><tr><td style="width:20%;">November 20</td><td style="width:20%;">Saturday</td><td style="width:60%;">Break Begins (No Classes)</td></tr><tr><td style="width:20%;">November 29</td><td style="width:20%;">Monday</td><td style="width:60%;">Classes Resume</td></tr><tr><td style="width:20%;">December 10</td><td style="width:20%;">Friday</td><td style="width:60%;">Follow Monday Schedule</td></tr><tr><td style="width:20%;">December 12</td><td style="width:20%;">Sunday</td><td style="width:60%;">Commencement</td></tr><tr><td style="width:20%;">December 13-17</td><td style="width:20%;">Monday-Friday</td><td style="width:60%;">Finals Week</td></tr><tr><td style="width:20%;">December 18, 19, 20</td><td style="width:20%;">Saturday-Monday</td><td style="width:60%;">Dates reserved for campus-wide final exam rescheduling, as determined by the President's Office or designee</td></tr></tbody></table><p>&nbsp;</p><table class="table"><caption>Spring 2028 Calendar</caption><thead><tr><th style="width:20%;">Date(s)</th><th style="width:20%;">Day(s)</th><th style="width:60%;">Description</th></tr></thead><tbody><tr><td style="width:20%;">January 20-22</td><td style="width:20%;">Thursday-Saturday</td><td style="width:60%;">New Student Arrival &amp; Orientation</td></tr><tr><td style="width:20%;">January 24</td><td style="width:20%;">Monday</td><td style="width:60%;">Classes Begin</td></tr><tr><td style="width:20%;">February 8</td><td style="width:20%;">Tuesday</td><td style="width:60%;">Grow, Thrive, Live Day</td></tr><tr><td style="width:20%;">February 23</td><td style="width:20%;">Wednesday</td><td style="width:60%;">Grow, Thrive, Live Day</td></tr><tr><td style="width:20%;">March 11</td><td style="width:20%;">Saturday</td><td style="width:60%;">Break Begins (No Classes)</td></tr><tr><td style="width:20%;">March 20</td><td style="width:20%;">Monday</td><td style="width:60%;">Classes Resume</td></tr><tr><td style="width:20%;">April 6</td><td style="width:20%;">Thursday</td><td style="width:60%;">Grow, Thrive, Live Day</td></tr><tr><td style="width:20%;">April 17</td><td style="width:20%;">Monday</td><td style="width:60%;">Grow, Thrive, Live Day</td></tr><tr><td style="width:20%;">May 12</td><td style="width:20%;">Friday</td><td style="width:60%;">Study Day</td></tr><tr><td style="width:20%;">May 15-19</td><td style="width:20%;">Monday-Friday</td><td style="width:60%;">Finals Week</td></tr><tr><td style="width:20%;">May 19</td><td style="width:20%;">Friday</td><td style="width:60%;">Masters Commencement Ceremony</td></tr><tr><td style="width:20%;">May 20</td><td style="width:20%;">Saturday</td><td style="width:60%;">Undergraduate Commencement Ceremony</td></tr></tbody></table><p>&nbsp;</p>
