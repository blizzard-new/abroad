            <div class="clearfix text-formatted field field--name-body field--type-text-with-summary field--label-hidden field__item"><table class="table"><caption>Spring 2027 Calendar</caption><thead><tr><th style="width:20%;">Date(s)</th><th style="width:20%;">Day(s)</th><th style="width:60%;">Description</th></tr></thead><tbody><tr><td style="width:20%;">January 21-23</td><td style="width:20%;">Thursday-Saturday</td><td style="width:60%;">New Student Arrival &amp; Orientation</td></tr><tr><td style="width:20%;">January 25</td><td style="width:20%;">Monday</td><td style="width:60%;">Classes Begin</td></tr><tr><td style="width:20%;">February 8</td><td style="width:20%;">Monday</td><td style="width:60%;"><span class="ckeditor-tooltip-text" data-tippy-content='&lt;span class="tooltip-title"&gt;Grow, Thrive, Live Day&lt;/span&gt;Classes will not meet on Grow, Thrive, Live (GTL) Days, which will provide opportunities for faculty, staff, and students to come together in community and engage in activities that strengthen our academic enterprise and support student success.' data-tooltip-title="Grow, Thrive, Live Day" data-tooltip-content="Classes will not meet on Grow, Thrive, Live (GTL) Days, which will provide opportunities for faculty, staff, and students to come together in community and engage in activities that strengthen our academic enterprise and support student success." data-tooltip-placeholder-is-selection="true" data-tooltip-placeholder-is-selection-text="Grow, Thrive, Live Day" data-tooltip-data="%5B%7B%22tooltipTitle%22%3A%22Grow%2C%20Thrive%2C%20Live%20Day%22%2C%22tooltipContent%22%3A%22Classes%20will%20not%20meet%20on%20Grow%2C%20Thrive%2C%20Live%20(GTL)%20Days%2C%20which%20will%20provide%20opportunities%20for%20faculty%2C%20staff%2C%20and%20students%20to%20come%20together%20in%20community%20and%20engage%20in%20activities%20that%20strengthen%20our%20academic%20enterprise%20and%20support%20student%20success.%22%2C%22placeholderIsSelection%22%3A%22true%22%