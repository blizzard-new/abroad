      <div id="block-virtual-tour" class="virtual-tour-block block block-block-content block-block-contentd5a93a55-1461-4b2b-ad7e-7ee6e27643c6">
  
      <h2 class="item-overline pt-1 pt-lg-3 pb-lg-2">Take a virtual tour</h2>
    
      <div class="content-wrapper">
      
<div data-block="footer_top" block="block-virtual-tour" class="block-content block-content--type-basic block-content--69 block-content--view-mode-full">
  
  
  <div class="block-content__content">
    
            <div class="clearfix text-formatted field field--name-body field--type-text-with-summary field--label-hidden field__item"><div class="raw-html-embed"><div class="yt-block">
  <div class="yt-playlist-wrapper" id="yt-main-player">
    <img class="yt-thumb" id="yt-thumb-img" src="https://suny.oneonta.edu/sites/default/files/styles/original_webp/public/2026-07/virtual-tour-placeholder.jpg.webp" alt="Video preview" loading="lazy">
    <button class="yt-play-btn" type="button" aria-label="Play video">
      <svg viewbox="0 0 68 48" width="68" height="48" aria-hidden="true">
        <path d="M66.52,7.74c-0.78-2.93-2.49-5.41-5.42-6.19C55.79,.13,34,0,34,0S12.21,.13,6.9,1.55 C3.97,2.33,2.27,4.81,1.48,7.74C0.06,13.05,0,24,0,24s0.06,10.95,1.48,16.26c0.78,2.93,2.49,5.41,5.42,6.19 C12.21,47.87,34,48,34,48s21.79-0.13,27.1-1.55c2.93-0.78,4.64-3.26,5.42-6.19C67.94,34.95,68,24,68,24 S67.94,13.05,66.52,7.74z" fill="#f00"></path>
        <path d="M45,24 27,14 27,34" fill="#fff"></path>
      </svg>
    </button>
  </div>
  <div id="yt-live-region" aria-live="polite" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;"></div>

  <div class="yt-strip" id="yt-strip" tabindex="0" role="group" aria-label="Video playlist, scroll left or right"></div>
</div>

<style>
.yt-block { width: 100%; max-width: 700px; margin: 0 auto; }

.yt-playlist-wrapper {
  position: relative;
  width: 100%;
  padding-bottom: 56.25%;
  height: 0;
  overflow: hidden;
  background: #000;
  cursor: pointer;
}
.yt-thumb { position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; }
.yt-play-btn {
  position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
  background: none; border: none; cursor: pointer; padding: 0;
  transition: transform 0.15s ease;
}
.yt-play-btn:hover { transform: translate(-50%, -50%) scale(1.1); }
.yt-playlist-wrapper iframe { position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: 0; }

.yt-strip {
  display: flex;
  gap: 8px;
  overflow-x: auto;
  margin-top: 10px;
  padding-bottom: 6px;
}
.yt-strip-item {
  flex: 0 0 auto;
  width: 300px;
  cursor: pointer;
  opacity: 0.90;
  transition: opacity 0.15s ease;
}
.yt-strip-item:hover { opacity: 1; }
.yt-strip-item.active { opacity: 1; }
.yt-strip-item:focus { outline: 3px solid #1a73e8; outline-offset: 2px; }
.yt-strip-item:focus:not(:focus-visible) { outline: none; }
.yt-strip-item:focus-visible { outline: 3px solid #1a73e8; outline-offset: 2px; }
.yt-strip-item.active .yt-strip-thumb { outline: 3px solid #f00; }
.yt-strip-thumb { width: 100%; display: block; border-radius: 4px; }
.yt-strip-title {
  font-size: 12px;
  margin-top: 4px;
  line-height: 1.3;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  color: #000;
}
</style>

<script>
(function () {
  var videos = [
    { id: '5mG6IbmZ3ks', title: 'Living On Campus at SUNY Oneonta' },
    { id: 'W-cY7WFI4VA', title: 'Fitzelle Hall - Inside Oneonta' },
    { id: 'W1QPH_youMo', title: 'Alumni Field House - Inside Oneonta' },
    { id: 'As7l4E-3pGY', title: 'Wilsbach Dining Hall - Inside Oneonta' },
    { id: '5in8EQDbd6M', title: 'Mills Dining Hall - Inside Oneonta' },
    { id: '6f8W60N5YSk', title: 'Physical Science - Inside Oneonta' },
    { id: 'zL0nZwz4VaQ', title: 'Science Discovery Center - Inside Oneonta' },
    { id: 'SFCCz9q1gtA', title: 'Milne Library - Inside Oneonta' },
    { id: 'RWAJkCD4Y0M', title: 'College Camp - Inside Oneonta' },
    { id: 'v3d5R6F6TnI', title: 'Alumni Hall - Inside Oneonta' },
    { id: 'F5yUYiNIZtc', title: 'Fine Arts Building - Inside Oneonta' },
    { id: 'JotR_-ka-Ag', title: 'Human Ecology Building - Inside Oneonta' },
    { id: '2rssthMr-w8', title: 'Perna Science - Inside Oneonta' },
    { id: 'zfVuHt8xbbg', title: 'Hunt Union - Inside Oneonta' }
  ];

  var playerWrapper = document.getElementById('yt-main-player');
  var strip = document.getElementById('yt-strip');
  var liveRegion = document.getElementById('yt-live-region');
  var currentIndex = 0;

  function renderStrip() {
    strip.innerHTML = '';
    videos.forEach(function (video, i) {
      var item = document.createElement('div');
      item.className = 'yt-strip-item' + (i === currentIndex ? ' active' : '');
      item.setAttribute('role', 'button');
      item.setAttribute('tabindex', '0');
      item.setAttribute('aria-label', 'Play ' + video.title + (i === currentIndex ? ' (currently playing)' : ''));
      if (i === currentIndex) item.setAttribute('aria-current', 'true');
      item.innerHTML =
        '<img class="yt-strip-thumb" src="https://img.youtube.com/vi/' + video.id + '/mqdefault.jpg" alt="" loading="lazy">' +
        '<div class="yt-strip-title">' + video.title + '</div>';
      item.addEventListener('click', function () { playVideo(i, true); });
      item.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ' || e.key === 'Spacebar') {
          e.preventDefault();
          playVideo(i, true);
        }
      });
      strip.appendChild(item);
    });
  }

  function playVideo(index, restoreFocus) {
    currentIndex = index;
    var video = videos[index];
    playerWrapper.innerHTML = '<iframe src="https://www.youtube.com/embed/' + video.id + '?autoplay=1" title="' + video.title + '" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>';
    renderStrip();
    liveRegion.textContent = 'Now playing: ' + video.title;
    if (restoreFocus) {
      var newActive = strip.children[index];
      if (newActive) newActive.focus();
    }
  }

  playerWrapper.addEventListener('click', function loadFirst() {
    playVideo(currentIndex);
    playerWrapper.removeEventListener('click', loadFirst);
  });

  renderStrip();
})();
</script></div></div>
      
