/* ========================= 
Global Affairs - Reusable Card 
========================= 
Usage:  ...  
You can override the variables inline or via extra classes. 
*/
.ga-card {
--ga-card-bg:#e6f2ff;
/* light blue background */
--ga-card-border:#c7dbf7;
/* border color */
--ga-card-text:#0a1f44;
/* body text color */
--ga-card-link:#036;
/* link color */
--ga-card-shadow:0 2px 8px #0000000f;
--ga-card-radius:0;
/* square corners */
--ga-card-padding:1rem 1.25rem;
--ga-card-maxw:560px;
/* max width; remove/adjust as needed */
--ga-card-gap:.35rem;
/* vertical spacing between lines */
/* ---- Base card ---- */
box-sizing:border-box;
background:var(--ga-card-bg);
color:var(--ga-card-text);
border:1px solid var(--ga-card-border);
border-radius:var(--ga-card-radius);
padding:var(--ga-card-padding);
max-width:var(--ga-card-maxw);
width:100%;
margin:0 auto;
/* center in its column */
box-shadow:var(--ga-card-shadow);
font-family:system-ui,-apple-system,"Segoe UI",Roboto,"Helvetica Neue",Arial,"Noto Sans",sans-serif;
line-height:1.45
}

.ga-card .ga-card-title {
margin:0 0 .5rem;
font-size:18x;
font-weight:800
}

.ga-card p {
margin:var(--ga-card-gap) 0;
font-size:14px
}

.ga-card strong {
font-weight:700
}

.ga-card a {
display:inline;
color:var(--ga-card-link);
text-decoration:underline;
font-weight:700
}

.ga-card a:hover,.ga-card a:focus {
text-decoration-thickness:2px;
outline:none
}

.ga-card .ga-divider {
border:0;
border-top:3px solid var(--ga-card-border);
margin:.75rem 0
}

.ga-card img {
max-width:100%;
height:auto;
display:block;
border:0
}

/* High-contrast mode accessibility */
@media (forced-colors: active) {
.ga-card {
border-color:CanvasText;
box-shadow:none
}
}

#uc-site-parent > a {
margin:/* extra vertical space above/below */
12px 0
}

/* Ensure container doesn't interfere */
#uc-site-parent {
margin-right:24px!important;
/* Maintains spacing from nav */
padding:0!important
}

.interior-menu li a,.main-navigation a,.navbar-nav a,.site-navigation a {
display:block!important;
min-height:24px!important;
padding:2px 0!important;
/* Adds vertical padding without widening */
line-height:1.4!important
}

footer a[href*="experiential"],.site-footer a,.footer-widgets a {
display:inline-block!important;
width:197px!important;
height:24px!important;
padding:0!important;
line-height:24px!important;
text-align:left!important;
box-sizing:border-box!important
}

/* Alternative if above doesn't catch it - universal footer links */
footer a,.site-footer a {
min-height:24px!important;
display:inline-block!important;
padding:2px 0!important
}

/* Extra spacing from adjacent elements */
#uc-site-parent,.site-branding {
margin-right:16px!important
}

/* Fix pagination arrows (← →) - prevents text clipping */
.pagination a,.page-numbers a,.nav-links a {
overflow:visible!important;
min-height:24px!important;
padding:2px 8px!important
}

/* Fix text clipping across all CISS pages */
.entry-content,.post-content,.site-content,.content-area,#content,.article,.article-content,.page-content {
overflow:visible!important;
height:auto!important;
max-height:none!important;
flex-wrap:wrap!important;
box-sizing:border-box!important;
word-wrap:break-word!important
}

footer a {
display:inline-block;
min-height:24px;
line-height:1.4;
padding-top:4px;
padding-bottom:4px;
box-sizing:border-box
}

.primary-menu a,.main-navigation a,.menu-item a {
width:auto!important;
height:auto!important;
line-height:normal!important;
padding:8px 12px!important;
display:block!important;
white-space:normal!important
}

/*vvvvvvvvvvvvvvvvvvvv| ADVISING SERVICES STAFF PAGE CUSTOM STYLING |vvvvvvvvvvvvvvvvvvvv*/
@media (min-width: 768px) {
.regional-adv-row {
display:flex;
flex-direction:row;
gap:20px;
align-items:end;
justify-content:space-evenly
}

.advisor-wrap {
max-width:220px
}

.regional-adv-row .mock-img {
position:relative;
width:100%;
max-width:220px;
margin-bottom:15px;
overflow:hidden
}

.mock-img img {
display:block;
width:100%;
max-width:253px;
height:220px;
object-fit:cover;
position:relative;
z-index:0
}
}

#container {
--uc-grid-header-top:#0f2043;
--uc-grid-header-bottom:#d4403a;
--uc-grid-hover:#d4403a;
--uc-grid-text:#fff;
--uc-grid-heading-size:20px;
--uc-grid-link:#013ecd
}

.regional-adv-row > a {
display:block;
width:fit-content
}

.advisor-wrap a {
text-decoration:none;
max-width:220px
}

.region-title {
text-decoration:none;
color:#000;
font-size:20px;
font-weight:500
}

.text-bkg h2 {
position:static;
z-index:2;
color:#fff;
margin-left:20px;
font-weight:400;
font-size:20px;
margin-bottom:0;
align-self:center;
padding-top:10px;
padding-bottom:10px
}

.mock-img {
position:relative;
overflow:hidden;
border-radius:18px;
transition:background-color .3s ease,background-blend-mode .3s ease;
margin-bottom:30px;
height:220px
}

.mock-img img {
display:block;
width:100%;
height:220px;
object-fit:cover;
position:relative;
z-index:0
}

.mock-img::after {
content:"";
position:absolute;
inset:0;
opacity:0;
background:var(--uc-grid-hover);
z-index:1;
transition:opacity .5s ease
}

.regional-adv-row a:hover .mock-img::after {
opacity:.5;
animation:hoverEffect ease .5s forwards
}

.regional-adv-row a:not(:hover) .mock-img::after {
opacity:.5;
animation:notHover ease .5s forwards
}

.hover-filter {
position:absolute;
inset:0;
background:var(--uc-grid-hover);
transform:translateX(-100%);
z-index:1
}

.regional-adv-row a:hover .hover-filter {
animation:hoverEffect .5s ease forwards
}

.regional-adv-row a:not(:hover) .hover-filter {
animation:notHover ease .5s forwards
}

.text-bkg {
display:flex;
align-items:center;
z-index:2;
position:absolute;
top:175px;
max-height:45px;
padding:0;
width:100%;
background:var(--uc-grid-header-top);
background-image:linear-gradient(90deg,var(--uc-grid-hover) 0%,var(--uc-grid-hover) 100%),linear-gradient(180deg,var(--uc-grid-header-top) 0%,var(--uc-grid-header-bottom) 100%);
background-size:0 100%,100% 100%;
background-position:left bottom,left bottom;
background-repeat:no-repeat;
transition:background-size 400ms ease!important
}

@keyframes hoverEffect {
from {
transform:translateX(-100%);
background:var(--uc-grid-hover)
}

to {
transform:translateX(0%);
background:var(--uc-grid-hover)
}
}

@keyframes notHover {
from {
transform:translateX(0%);
background:var(--uc-grid-hover)
}

to {
transform:translateX(-100%);
background:var(--uc-grid-hover)
}
}

/*^^^^^^^^^^^^^^^^^^^^| ADVISING SERVICES STAFF PAGE CUSTOM STYLING |^^^^^^^^^^^^^^^^^^^^*/
/*
 * 
 * 
 * 
/*vvvvvvvvvvvvvvvvvvvv| ISSSS/IPS PAGE CUSTOM STYLING |vvvvvvvvvvvvvvvvvvvv*/
.staff-images-1,.staff-images-2 {
display:flex;
flex-direction:column;
align-items:center
}

@media(min-width: 768px) {
.staff-images-1,.staff-images-2 {
display:flex;
flex-direction:row;
justify-content:space-evenly;
align-items:stretch
}

.indiv-staff {
margin-bottom:0
}
}

.indiv-staff {
width:200px;
justify-content:center;
margin-bottom:40px
}

.indiv-staff img {
margin-bottom:12px
}

.indiv-staff h3 {
font-size:18px;
text-align:center;
margin-bottom:4px
}

.indiv-staff a {
text-decoration:none;
color:#000
}

.indiv-staff p {
color:#555;
text-align:center
}

/*^^^^^^^^^^^^^^^^^^^^| ISSSS/IPS PAGE CUSTOM STYLING |^^^^^^^^^^^^^^^^^^^^*/
