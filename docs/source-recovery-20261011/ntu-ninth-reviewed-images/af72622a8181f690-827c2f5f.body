<script type="application/ld+json">{"@context":"https:\/\/schema.org","@graph":[{"@type":"Organization","@id":"https:\/\/international.global.uconn.edu\/#schema-publishing-organization","url":"https:\/\/international.global.uconn.edu","name":"Center for International Students &amp; Scholars (CISS)"},{"@type":"WebSite","@id":"https:\/\/international.global.uconn.edu\/#schema-website","url":"https:\/\/international.global.uconn.edu","name":"International Student &amp; Scholar Services (ISSS)","encoding":"UTF-8","potentialAction":{"@type":"SearchAction","target":"https:\/\/international.global.uconn.edu\/search\/{search_term_string}\/","query-input":"required name=search_term_string"}},{"@type":"Person","@id":"https:\/\/international.global.uconn.edu\/author\/ajg96002\/#schema-author","name":"Arthur Galinat","url":"https:\/\/international.global.uconn.edu\/author\/ajg96002\/","description":"Arthur joined International Student &amp; Scholar Services (ISSS) in 2008 and is currently serving as Associate Director. Arthur is a UConn alumnus (class of \u201900 and \u201802) holding a B.A. and M.A. in Spanish. Arthur is an active member in NAFSA: Association of International Educators and he has presented on various topics at recent NAFSA regional conferences and workshops.  From 2010-2013 Arthur served as the Connecticut State Representative  and from 2014-2016 served as the Chair for NAFSA Region XI. He has traveled in Europe and Asia and has lived in Spain, Portugal and South Korea and speaks Spanish and Portuguese.  Arthur loves movies and food from all over the world.  His favorite part of working at ISSS is welcoming new students and scholars to campus and he looks forward to seeing all of you at ISSS!"}]}</script>
