	<ul class="dropdown-menu">
		<li id="menu-item-13952" class="menu-item menu-item-type-post_type menu-item-object-page nav-item"><a href="https://experiential.global.uconn.edu/registration/" class="dropdown-item">Course Registration</a></li>		<li id="menu-item-13816" class="menu-item menu-item-type-post_type menu-item-object-page nav-item"><a href="https://experiential.global.uconn.edu/housing/" class="dropdown-item">UConn Housing</a></li>		<li id="menu-item-13819" class="menu-item menu-item-type-post_type menu-item-object-page nav-item"><a href="https://experiential.global.uconn.edu/pre-departure/" class="dropdown-item">Pre-Departure Orientation</a></li>		<li id="menu-item-13792" class="menu-item menu-item-type-post_type menu-item-object-page nav-item"><a href="https://experiential.global.uconn.edu/health-safety/" class="dropdown-item">Health &amp; Safety</a></li>		<li id="menu-item-13824" class="menu-item menu-item-type-post_type menu-item-object-page nav-item"><a href="https://experiential.global.uconn.edu/travel-tips/" class="dropdown-item">Travel Tips</a></li>
	</ul>
