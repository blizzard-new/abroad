<body class="wp-singular page-template-default page page-id-12256 page-child parent-pageid-7160 wp-theme-cornerstone wp-child-theme-beecher-stowe siteorigin-panels siteorigin-panels-before-js metaslider-plugin group-blog">
<!--[if lt IE 7]>      <div class="ie lte9 lte8 lte7 lte6"> <![endif]-->
<!--[if IE 7]>         <div class="ie ie7 lte9 lte8 lte7"> <![endif]-->
<!--[if IE 8]>         <div class="ie ie8 lte9 lte8"> <![endif]-->
