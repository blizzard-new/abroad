</tr>
<tr class="odd"><td class="column0"><strong>Holiday (Memorial Day). No classes</strong></td>
<td class="column1">Monday, May 31</td>
</tr>
<tr class="even"><td class="column0"><strong>MM classes end/exams</strong></td>
<td class="column1">Thursday, May 27<br/>Friday, May 28<br/></td>
</tr>
<tr class="odd"><td class="column0"><strong>SSI classes end</strong></td>
<td class="column1">Tuesday, June 15</td>
</tr>
<tr class="even"><td class="column0"><strong>SSI reading day</strong></td>
<td class="column1">Wednesday, June 16</td>
</tr>
<tr class="odd"><td class="column0"><strong>SSI exam days</strong></td>
<td class="column1">Thursday, June 17<br/>Friday, June 18</td>
</tr>
<tr class="even last lastrow"><td class="column0"><strong>Holiday (Juneteenth). No classes</strong></td>
<td class="column1">Monday, June 21</td>
