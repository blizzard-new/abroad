<body class="wp-singular page-template-default page page-id-8163 wp-theme-cornerstone wp-child-theme-beecher-stowe siteorigin-panels siteorigin-panels-before-js metaslider-plugin group-blog">
<!--[if lt IE 7]>      <div class="ie lte9 lte8 lte7 lte6"> <![endif]-->
