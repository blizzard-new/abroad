              <source srcset="/sites/default/files/styles/utexas_image_style_800w_500h/public/hero-photos/Apt.%202.jpg?itok=3iYM7oL0 1x, /sites/default/files/styles/utexas_image_style_1600w_x_1000h/public/hero-photos/Apt.%202.jpg?itok=74qh4-7I 2x" media="all and (min-width: 600px) and (max-width: 899px)" type="image/jpeg" width="800" height="500"/>
