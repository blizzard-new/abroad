            <div class="data-wrapper">
                  <h3 class="ut-headline"><a href="https://www.hatctx.com/" class="ut-link--darker">Housing Authority of Travis County</a></h3>
                          <p>The Housing Authority of Travis County provides information on the Affordable Housing Program for eligible Austinites.</p>
                          <a href="https://www.hatctx.com/" tabindex="-1" aria-hidden="true" class="ut-link--darker">Get more information</a>
              </div>
    </div>
      <div class="utexas-promo-unit">
              <div class="image-wrapper landscape-image">
              <picture>
                  <source srcset="/sites/default/files/styles/utexas_image_style_800w_500h/public/promo-images/Apt3.JPG?itok=SWVoRV6C 1x, /sites/default/files/styles/utexas_image_style_1600w_x_1000h/public/promo-images/Apt3.JPG?itok=K8iJfTTU 2x" media="all and (min-width: 900px)" type="image/jpeg" width="800" height="500"/>
