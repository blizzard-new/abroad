<script>function seeContenta13(contentid,size,displayid){	document.getElementById(contentid).innerHTML = '[';	for(var i=0;i<=size;i++){		var allcontentid = contentid+(i+1);		if(allcontentid==displayid){			document.getElementById(contentid).innerHTML += " <span id='"+allcontentid+"' name='"+allcontentid+"'  >"+(i+1)+"</span> ";			document.getElementById(displayid).style.display = 'block';		}else{			document.getElementById(contentid).innerHTML += " <span style='cursor:pointer' id='"+allcontentid+"' name='"+allcontentid+"' onclick=seeContenta13('"+contentid+"','"+size+"','"+allcontentid+"')  >"+(i+1)+"</span> ";			document.getElementById(allcontentid).style.display = 'none';		}	}	document.getElementById(contentid).innerHTML += ']';}</script>
<script language="javascript" src="/system/resource/js/news/mp4video.js"></script>
<script>_addDynClicks('wbnews',1792192720,1283)</script>
<div><div id="vsb_content_1283_u131"><div id="vsb_content"><div class="blog-content" style="margin:0px;padding:0px 0px 14px;border:0px;font-variant-numeric:inherit;font-variant-east-asian:inherit;font-stretch:inherit;line-height:inherit;font-family:helvetica neue, helvetica, pingfang sc, hiragino sans gb, microsoft yahei, 微软雅黑, arial, sans-serif;vertical-align:baseline;color:#5a636b;background-color:#ffffff;">
 <h1 label="标题居左" style="margin:0px 0px 10px;padding:0px 4px 0px 0px;border-width:0px 0px 2px;border-bottom-style:solid;border-bottom-color:#cccccc;font-style:inherit;font-variant:inherit;font-stretch:inherit;font-size:32px;line-height:1.5em;vertical-align:baseline;color:#830f5b;max-width:100%;"><span style="margin:0px;padding:0px;border:0px;font-style:inherit;font-variant:inherit;font-weight:inherit;font-stretch:inherit;font-size:20px;line-height:inherit;vertical-align:baseline;text-indent:2em;max-width:100%;">校内住宿</span></h1>
 <p style="padding:0px;border:0px;font-style:inherit;font-variant:inherit;font-weight:inherit;font-stretch:inherit;font-size:inherit;line-height:1.8em;font-family:helvetica neue, helvetica, pingfang sc, hiragino sans gb, microsoft yahei, 微软雅黑, arial, sans-serif;vertical-align:baseline;color:#555555;text-align:justify;text-indent:2em;margin-top:8px;margin-bottom:2px;"><span style="margin:0px;padding:0px;border:0px;font-style:inherit;font-variant:inherit;font-weight:inherit;font-stretch:inherit;font-size:inherit;line-height:inherit;vertical-align:baseline;text-indent:2em;max-width:100%;"></span></p>
 <p style="margin-top: 7px;margin-bottom: 7px;line-height: 17px"><span style="font-family: 宋体, SimSun; font-size: 16px;">南开大学国际教育学院共有留学生公寓楼6座，分别是：</span></p>
 <p style="margin-top: 7px;margin-bottom: 7px;line-height: 17px"><strong><span style="font-family: 宋体, SimSun; font-size: 16px;">八里台校区：谊园2号楼、谊园3号楼、谊园4号楼</span></strong></p>
 <p><strong><span style="font-family: 宋体, SimSun; font-size: 16px;">津南校区：留学生公寓B座、留学生公寓C座、留学生公寓D座</span></strong></p>
 <p><br></p>
 <p style="margin-top: 7px;margin-bottom: 7px;line-height: 17px"><strong><span style="font-family: 宋体, SimSun; font-size: 16px;">一、八里台校区谊园2号楼共有6层，全部为双人间</span></strong></p>
 <p style="margin-top: 7px;margin-bottom: 7px;line-height: 17px"><span style="font-family: 宋体, SimSun; font-size: 16px;">（1）大厅设有总服务台</span></p>
 <p style="margin-top: 7px;margin-bottom: 7px;line-height: 17px"><span style="font-family: 宋体, SimSun; font-size: 16px;">（2）1-6层设有自助收费洗衣房</span></p>
 <p style="margin-top: 7px;margin-bottom: 7px;line-height: 17px"><span style="font-family: 宋体, SimSun; font-size: 16px;">（3）1-6层设有公共厨房</span></p>
 <p style="margin-top: 7px;margin-bottom: 7px;line-height: 17px"><br></p>
 <p style="margin-top: 7px;margin-bottom: 7px;line-height: 17px"><strong><span style="font-family: 宋体, SimSun; font-size: 16px;">二、八里台校区谊园3号楼宿舍区为3、4、5层，主要为双人间，另有少量单人间、3人间</span></strong></p>
 <p style="margin-top: 7px;margin-bottom: 7px;line-height: 17px"><span style="font-family: 宋体, SimSun; font-size: 16px;">（1）大厅设有总服务台</span></p>
 <p style="margin-top: 7px;margin-bottom: 7px;line-height: 17px"><span style="font-family: 宋体, SimSun; font-size: 16px;">（2）3层为男生专用；4、5层为女生专用（设置门禁）</span></p>
 <p style="margin-top: 7px;margin-bottom: 7px;line-height: 17px"><span style="font-family: 宋体, SimSun; font-size: 16px;">（3）3-5层设有自助收费洗衣房</span></p>
 <p style="margin-top: 7px;margin-bottom: 7px;line-height: 17px"><span style="font-family: 宋体, SimSun; font-size: 16px;">（4）3-5层设有公共厨房</span></p>
 <p style="margin-top: 7px;margin-bottom: 7px;line-height: 17px"><br></p>
 <p><strong><span style="font-family: 宋体, SimSun; font-size: 16px;">三、八里台校区谊园4号楼共有6层，主要为双人间。</span></strong></p>
 <p><span style="font-family: 宋体, SimSun; font-size: 16px;">（1）大厅设有总服务台</span></p>
 <p><span style="font-family: 宋体, SimSun; font-size: 16px;">（2）1层设有自助收费洗衣房</span></p>
 <p><span style="font-family: 宋体, SimSun; font-size: 16px;">（3）1层设有公共厨房</span></p>
 <p><br></p>
 <p><strong><span style="font-family: 宋体, SimSun; font-size: 16px;">四、津南校区留学生公寓B座共六层，全部为单人间</span></strong></p>
 <p><span style="font-family: 宋体, SimSun; font-size: 16px;">（1）大厅设有总服务台</span></p>
 <p><span style="font-family: 宋体, SimSun; font-size: 16px;">（2）2-6层设有自助收费洗衣房</span></p>
 <p><span style="font-family: 宋体, SimSun; font-size: 16px;">（3）1-6层设有公共厨房</span></p>
 <p><br></p>
 <p><strong><span style="font-family: 宋体, SimSun; font-size: 16px;">五、津南校区留学生公寓C座共5层，全部为双人间</span></strong></p>
 <p><span style="font-family: 宋体, SimSun; font-size: 16px;">（1）大厅设有总服务台</span></p>
 <p><span style="font-family: 宋体, SimSun; font-size: 16px;">（2）1层设有自助收费洗衣房</span></p>
 <p><span style="font-family: 宋体, SimSun; font-size: 16px;">（3）1-5层设有公共厨房</span></p>
 <p><br></p>
 <p><strong><span style="font-family: 宋体, SimSun; font-size: 16px;">六、津南校区留学生公寓D座共4层，全部为双人间</span></strong></p>
 <p><span style="font-family: 宋体, SimSun; font-size: 16px;">（1）大厅设有总服务台</span></p>
 <p><span style="font-family: 宋体, SimSun; font-size: 16px;">（2）1层有自助收费洗衣房</span></p>
 <p><span style="font-family: 宋体, SimSun; font-size: 16px;">（3）1-4层设有公共厨房</span></p>
 <h1 label="标题居左" style="margin:0px 0px 10px;padding:0px 4px 0px 0px;border-width:0px 0px 2px;border-bottom-style:solid;border-bottom-color:#cccccc;font-style:inherit;font-variant:inherit;font-stretch:inherit;font-size:32px;line-height:1.5em;vertical-align:baseline;color:#830f5b;max-width:100%;"><span style="margin:0px;padding:0px;border:0px;font-style:inherit;font-variant:inherit;font-weight:inherit;font-stretch:inherit;font-size:20px;line-height:inherit;vertical-align:baseline;max-width:100%;">校内公寓床位费用</span></h1>
 <p style="text-indent: 2em; text-align: justify;"><span style="font-family: 宋体, SimSun; font-size: 16px;">南开大学八里台校区和津南校区均设有外国留学生宿舍。外国留学生的校区分配由学校根据当年政策及留学生专业所在校区统一安排。外国留学生需进行线上预订。如未能成功预订校内住宿，学校将提供校外住宿信息供学生选择。详情请关注南开大学外国留学生服务系统内部通知。</span></p>
 <p style="text-indent: 2em; text-align: justify;"><span style="font-family: 宋体, SimSun; font-size: 16px;">外国留学生住宿费用如下：</span></p>
 <p style="text-align: center"><img src="/__local/E/60/96/26546618605102446D316CE9F01_FEB079B5_25EA9.png" width="500" vsbhref="vurl" vurl="/_vsl/E609626546618605102446D316CE9F01/FEB079B5/25EA9" vheight="" vwidth="500" orisrc="/__local/E/60/96/26546618605102446D316CE9F01_FEB079B5_25EA9.png" class="img_vsb_content"></p>
 <p style="text-align: center"><img src="/__local/E/94/B9/63911AB2646F87C2682CEB94B54_8EC45988_213BB.png" width="500" vsbhref="vurl" vurl="/_vsl/E94B963911AB2646F87C2682CEB94B54/8EC45988/213BB" vheight="" vwidth="500" orisrc="/__local/E/94/B9/63911AB2646F87C2682CEB94B54_8EC45988_213BB.png" class="img_vsb_content"></p>
 <p><br></p>
 <p style="padding:0px;border:0px;font-style:inherit;font-variant:inherit;font-weight:inherit;font-stretch:inherit;font-size:inherit;line-height:1.8em;font-family:helvetica neue, helvetica, pingfang sc, hiragino sans gb, microsoft yahei, 微软雅黑, arial, sans-serif;vertical-align:baseline;color:#555555;text-align:justify;text-indent:2em;margin-top:8px;margin-bottom:2px;"><br></p>
</div></div></div></div>
