<script>
$(".agreetext").click(function () {
    $('.overshow').toggleClass('active');
})
function goTop() {
    $("html,body").animate({
        scrollTop: 0
    }, 500);
}
$(".nav-item").hover(function (){
    $(this).find('.sdropdown-menu').css('height','auto')
    $(this).find('.sdropdown-menu').stop(true).slideDown('fast');
},function (){
    $(this).find('.sdropdown-menu').css('height','auto')
    $(this).find('.sdropdown-menu').stop(true).slideUp('fast');
})

$(".smbar").click(function (){
    $('.abs-main').toggleClass('hidden-menu');
    $('.abs-main .smain-l .smenu-block').toggle(500);
})
$(".Footer--toggle").click(function(){
    let ob = $(this).attr('aria-controls');
    $(this).attr('aria-expanded') == 'true' ?$(this).attr('aria-expanded', 'false'):$(this).attr('aria-expanded', 'true');
    $("#"+ob).toggle('300','swing');
})
$(window).scroll(function(event){
    let offsetTop = 200;
    let e = $(document).scrollTop();
    e > offsetTop ? $('.ScrollToTop').addClass("is-notTop").removeClass("is-top") : $('.ScrollToTop').addClass("is-top").removeClass("is-notTop");
});
</script>
<script>
var shareSwiper = new Swiper('.share-sliderbox .swiper', {
    autoplay: true,//可选选项，自动滑动
    navigation: {
        nextEl: '.swiper-button-next',
        prevEl: '.swiper-button-prev',
    },
})
var shareINSwiper = new Swiper('.sharein-l .swiper', {
    autoplay: true,//可选选项，自动滑动
    pagination: {
        el: '.swiper-pagination',
    },
})
</script>

