        <li class="m-content__item m-content__item--sub">
            
        <a href="#facilities" class="m-content__link">
            <span class="icon-svg icon-svg--angle-r m-content__icon">
                <svg class="icon-svg__svg" xmlns:xlink="http://www.w3.org/1999/xlink">
                    <use xlink:href="/img/bg/icons-svg.svg#icon-angle-r" x="0" y="0" width="100%" height="100%"></use>
                </svg>
            </span>
            Facilities 
    	</a>
        
        </li>
        </ol>
        </li>
        <li class="m-content__item">
            
        <a href="#private-accommodation" class="m-content__link">
            <span class="icon-svg icon-svg--angle-r m-content__icon">
                <svg class="icon-svg__svg" xmlns:xlink="http://www.w3.org/1999/xlink">
                    <use xlink:href="/img/bg/icons-svg.svg#icon-angle-r" x="0" y="0" width="100%" height="100%"></use>
                </svg>
            </span>
            Private Accommodation 
    	</a>
        
        <ol class="m-content__list m-content__list--sub">
        <li class="m-content__item m-content__item--sub">
            
        <a href="#waste-collection-fee" class="m-content__link">
            <span class="icon-svg icon-svg--angle-r m-content__icon">
                <svg class="icon-svg__svg" xmlns:xlink="http://www.w3.org/1999/xlink">
                    <use xlink:href="/img/bg/icons-svg.svg#icon-angle-r" x="0" y="0" width="100%" height="100%"></use>
                </svg>
            </span>
            Waste Collection Fee 
    	</a>
        
        </li>
        <li class="m-content__item m-content__item--sub">
            
        <a href="#accommodation-scholarship" class="m-content__link">
            <span class="icon-svg icon-svg--angle-r m-content__icon">
                <svg class="icon-svg__svg" xmlns:xlink="http://www.w3.org/1999/xlink">
                    <use xlink:href="/img/bg/icons-svg.svg#icon-angle-r" x="0" y="0" width="100%" height="100%"></use>
