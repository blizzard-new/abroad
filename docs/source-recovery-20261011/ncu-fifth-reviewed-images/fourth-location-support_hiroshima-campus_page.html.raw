<div class="block block-hu-layout-parts block-hu-main-content-block">
  
    
      <div id="node-33081" class="clearfix huUserContents">
                            <a href="https://www.hiroshima-u.ac.jp/en/news/49496" class="linkPanel">
      
      <div>
        <span class="title">Towards smoke-free campus</span>
                          <span class="text"><p>Total ban of smoking from 1st January 2020.<br>Click here for details.</p>
</span>
        
