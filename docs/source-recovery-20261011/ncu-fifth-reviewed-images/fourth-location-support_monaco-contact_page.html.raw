<h3 class="wp-block-heading has-text-align-left">Bachelor Program</h3>



<div class="wp-block-columns is-layout-flex wp-container-core-columns-is-layout-9d6595d7 wp-block-columns-is-layout-flex">
<div class="wp-block-column is-layout-flow wp-block-column-is-layout-flow">
<figure class="wp-block-image size-full"><a href="mailto:ebiamonti@ium.monaco.edu" target="_blank" rel=" noreferrer noopener"><img decoding="async" width="600" height="300" src="https://www.monaco.edu/wp-content/uploads/sites/4/2025/11/Admission_IUM.jpg" alt="Admission_IUM" class="wp-image-44293" srcset="https://www.monaco.edu/wp-content/uploads/sites/4/2025/11/Admission_IUM.jpg 600w, https://www.monaco.edu/wp-content/uploads/sites/4/2025/11/Admission_IUM.jpg?resize=300,150 300w, https://www.monaco.edu/wp-content/uploads/sites/4/2025/11/Admission_IUM.jpg?resize=462,231 462w, https://www.monaco.edu/wp-content/uploads/sites/4/2025/11/Admission_IUM.jpg?resize=346,173 346w, https://www.monaco.edu/wp-content/uploads/sites/4/2025/11/Admission_IUM.jpg?resize=340,170 340w" sizes="(max-width: 600px) 100vw, 600px" /></a><figcaption class="wp-element-caption">Admission_IUM</figcaption></figure>
