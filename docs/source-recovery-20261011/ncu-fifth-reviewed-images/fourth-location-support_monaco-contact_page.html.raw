			<script>
		document.addEventListener('DOMContentLoaded', function () {
			// Ensure Gravity Forms scripts are loaded
			if (typeof gform !== 'undefined' && gform.utils && gform.utils.addFilter) {
			gform.instances = gform.instances || {};
			if (!gform.instances.filters) {
				gform.instances.filters = {};
			}
			gform.utils.addFilter('gform/ajax/post_ajax_submission', function(data) {
				// Check if this is a confirmation (final submission) or just a page navigation
				const isConfirmation = data.submissionResult && 
					data.submissionResult.data && 
					(data.submissionResult.data.is_confirmation || 
					 data.submissionResult.data.confirmation_message);
				
				// Check if datalayer_data exists
				if (data.submissionResult && data.submissionResult.data.datalayerData) {
				window.dataLayer = window.dataLayer || [];
				window.dataLayer.push(data.submissionResult.data.datalayerData);

				console.log('datalayerData GTM push');
				} else if (isConfirmation) {
				// Only warn if this is a final submission where we expected datalayerData
				console.warn('GTM: datalayerData not found in final submission result.');
				}
				// No warning for intermediate step navigation
				return data;
			});
			} else {
			console.warn('Gravity Forms utils not loaded.');
			}
		});
		</script>
