background-image: url(https://studyabroad.unc.edu/wp-content/uploads/sites/1338/2023/01/StudyAbroad_pattern1_transparent50.png);
background-size: cover;
background-repeat: no-repeat;
background-position: center;
width: 100%;
}
.abovefold a{color:#ffffff;}
