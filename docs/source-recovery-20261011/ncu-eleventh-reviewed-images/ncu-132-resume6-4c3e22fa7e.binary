-e49e6508><!----><button class="VPSwitch VPSwitchAppearance" type="button" role="switch" title aria-label="ダークモード" aria-checked="false" data-v-e49e6508 data-v-ef4c9fdf data-v-b1596d9c><span class="check" data-v-b1596d9c><span class="icon" data-v-b1596d9c><!--[--><span class="vpi-sun sun" aria-hidden="true" data-v-ef4c9fdf></span><span class="vpi-moon moon" aria-hidden="true" data-v-ef4c9fdf></span><!--]--></span></span></button></div><ul class="VPSocialLinks VPNavSocialLinks VPNavBarSocialLinks social-links" data-v-ca9936a2 data-v-3ee45dc8 data-v-dfc047d8><!--[--><li data-v-dfc047d8><a class="VPSocialLink no-icon" href="https://x.com/osakametuniv" aria-label="x" target="_blank" rel="me noopener" data-v-dfc047d8 data-v-34632f72><span class="vpi-simple-icons-x" data-v-34632f72 data-v-607278ad></span></a></li><li data-v-dfc047d8><a class="VPSocialLink no-icon" href="https://www.omu.moe/feed.xml" aria-label="RSS" target="_blank" rel="me noopener" data-v-dfc047d8 data-v-34632f72><span class="vpi-simple-icons-rss" data-v-34632f72 data-v-607278ad></span></a></li><!--]--></ul><!----><!--[--><!--[--><!--[--><!----><!--]--><!--]--><!--]--><button type="button" class="VPNavBarHamburger hamburger" aria-label="Menu" aria-expanded="false" data-v-ca9936a2 data-v-d428a1c7><span class="container" aria-hidden="true" data-v-d428a1c7><span class="top" data-v-d428a1c7></span><span class="middle" data-v-d428a1c7></span><span class="bottom" data-v-d428a1c7></span></span></button></div></div></div></div><div class="divider" data-v-ca9936a2><div class="divider-line" data-v-ca9936a2></div></div></div><!----></header><div class="VPLocalNav empty fixed" data-v-345181bb data-v-89a1ca2b><div class="container" data-v-89a1ca2b><!----><div class="VPLocalNavOutlineDropdown" style="--vp-vh:0px;" data-allow-mismatch="style" data-v-89a1ca2b data-v-5c7af8bd><button type="button" data-v-5c7af8bd>ページの先頭に戻る</button><!----></div></div></div><!----><div class="VPContent" id="VPContent" data-v-345181bb data-v-fa19f06a><div class="VPPage" data-v-fa19f06a><!--[--><!--]--><div style="position:relative;"><div><div class="_wrapper_1wi5l_2"><div class="_container_1wi5l_12"><!--[--><div class="leading-relaxed"><div class="mb-10"><div class="mb-2"><a class="text-sm _link" href="/">← Back to the top page</a></div><h1 class="flex items-center gap-2.5 text-2xl md:text-3xl font-medium leading-snug mb-4"><!---->International Affairs</h1><!----></div><!--[--><!----><!--[--><section class="mb-10"><h2 class="mb-4 text-xl lg:text-2xl font-medium">For International Students, Faculty Members, and Staff of OMU</h2><p class="mb-3">Please refer to the following pages for the latest announcements, contact information, and other important updates:</p><ul class="pl-6 list-disc"><li>For students: <a class="_link" href="/for/student/">https://www.omu.moe/for/student/</a></li><li>For faculty and staff: <a class="_link" href="/for/staff/">https://www.omu.moe/for/staff/</a></li></ul></section><section class="mb-10"><h2 class="mb-4 text-xl lg:text-2xl font-medium">English Inquiries</h2><div class="_box_q28pd_6 p-4"><p class="mb-3">If you have any inquiries in English, please contact us by email at:<br>✉ <b>omu.ipro2026[a]gmail.com</b> (Please change [a] into @)</p><p class="text-sm text-text-2">Due to current circumstances, we sincerely apologize that responses may take some time. Priority will be given to urgent matters, and therefore replies to non-urgent inquiries may be delayed. We greatly appreciate your understanding.</p></div></section><!--]--><!----><section class="mb-10"><h2 class="mb-1 text-xl lg:text-2xl font-medium">Announcements</h2><p class="mb-4">Announcements in English for international students, faculty members, and staff.</p><div class="_rows_q28pd_20"><div class="_empty_q28pd_24">There are no announcements at the moment.</div><!--[--><!--]--></div></section><!----><!--]--></div><!--]--></div></div></div></div><!--[--><!--]--></div></div><footer class="VPFooter" data-v-345181bb data-v-db2d4290><div class="container" data-v-db2d4290><!----><p class="copyright" data-v-db2d4290>Copyright © 2026 Osaka Metropolitan University.</p></div></footer><!--[--><!--]--></div></div>
    
    
