,["Department of Materials Science \u0026 Engineering",null,null,null,0],["Department of Food Science and Biotechnology",null,null,null,0],["Department of Biotechnology",null,null,null,0],["Biopharmaceutical Science",null,null,null,0],["Global Medical Science",null,null,null,0],["Artificial Intelligence",null,null,null,0],["Intelligent IoT",null,null,null,0],["Department of Fashion Industry",null,null,null,0],["Department of Consumer Science",null,null,null,0],["Department of Beauty Industry",null,null,null,0],["Sports and Leisure",null,null,null,0],["Exercise Rehabilitation",null,null,null,0],["Department of Oriental Painting",null,null,null,0],["Department of Western Painting",null,null,null,0],["Department of Sculpture",null,null,null,0],["Department of Crafts",null,null,null,0],["Department of Design",null,null,null,0],["Department of Vocal Music",null,null,null,0],["Department of Instrumental Music",null,null,null,0],["Department of Composition",null,null,null,0]],1,null,null,null,null,null,0]],null,null,null,null,null,null,[null,"Preferred Major at Sungshin"],[null,"\u003cp\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003eStudents will be registered in the \u003cu\u003e\u003cspan style\u003d\"font-weight:bold\"\u003esame or a related major as their home university.\u003c/span\u003e\u003c/u\u003e\u003c/li\u003e\u003cli\u003e\u003cspan\u003eIf it does not align with student's field of study, \u003c/span\u003e\u003cu\u003e\u003cspan style\u003d\"font-weight:bold\"\u003ethe university will change it to a more appropriate department during the administrative process.\u003c/span\u003e\u003c/u\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003c/p\u003e\u003cdiv\u003e\u003c/div\u003e"]],[245186317,"Period of Exchange",null,2,[[1129674068,[["1 semester",null,null,null,0],["1 academic year (2 semesters)",null,null,null,0]],1,null,null,null,null,null,0]],null,null,null,null,null,null,[null,"\u003cspan\u003ePeriod of Exchange\u003c/span\u003e"]],[1892616567,"Current Grade (School year)",null,2,[[68481764,[["1st Year",null,null,null,0],["2ndYear",null,null,null,0],["3rd Year",null,null,null,0],["4th Year",null,null,null,0],["",null,null,null,1]],1,null,null,null,null,null,0]],null,null,null,null,null,null,[null,"\u003cb\u003eCurrent Grade\u003c/b\u003e (School year)\u003cbr\u003e"]],[1257721756,"Sungshin Intake Semester (School Year-Semester) ","* Student's Year-Semester in Spring 2026\n (e.g. Student A: 2nd Year - 1st Semester at home university, 2nd Year 2nd Semester at Sungshin)\n* Please count the number of semesters enrolled at home university and then add 1 semester",3,[[1096205258,[["1st Year - 1st Semester",null,null,null,0],["1st Year - 2nd Semester",null,null,null,0],["2nd Year - 1st Semester",null,null,null,0],["2nd Year - 2nd Semester",null,null,null,0],["3rd Year - 1st Semester",null,null,null,0],["3rd Year - 2nd Semester",null,null,null,0],["4th Year - 1st Semester",null,null,null,0],["4th Year - 2nd Semester",null,null,null,0]],1,null,null,null,null,null,0]],null,null,null,null,null,null,[null,"\u003cb\u003eSungshin Intake Semester (School Year-Semester) \u003c/b\u003e\u003cbr\u003e"],[null,"* Student's Year-Semester in Spring 2026\u003cbr\u003e (e.g. Student A: 2nd Year - 1st Semester at home university, 2nd Year 2nd Semester at Sungshin)\u003cbr\u003e* Please count the number of semesters enrolled at home university and then add 1 semester"]],[1658656077,"Is the Student applying for Sungshin Dormitory?",null,2,[[208706864,[["Yes",null,null,null,0],["No",null,null,null,0]],1,null,null,null,null,null,0]],null,null,null,null,null,null,[null,"Is the Student applying for Sungshin Dormitory?\u003cbr\u003e"]],[1201567616,"TOPIK or English Level, if available (Not required)",null,0,[[349710596,null,0]],null,null,null,null,null,null,[null,"TOPIK or English Level, if available (Not required)\u003cbr\u003e"]],[1998677373,"Additional Information",null,1,[[418099818,null,0]],null,null,null,null,null,null,[null,"Additional Information"]],[828183662,"I hereby agree and acknowledge that the nominees' original documents must arrive at Sungshin Women's University by Nov 23 2026.\n(By selecting 'No', the nominee might not be accepted and/or the nominee's Certificate of Admission issuance will not be guaranteed.)",null,4,[[2027020515,[["Yes",null,null,null,0],["No",null,null,null,0]],1,null,null,null,null,null,0]],null,null,null,null,null,null,[null,"I hereby agree and acknowledge that the nominees' \u003cb\u003e\u003cu\u003eoriginal documents\u003c/u\u003e \u003c/b\u003emust arrive at Sungshin Women's University \u003cb\u003e\u003cu\u003eby Nov 23\u003c/u\u003e\u003c/b\u003e\u003cspan\u003e\u003cb\u003e\u003cu\u003e 2026\u003c/u\u003e\u003c/b\u003e.\u003c/span\u003e\u003cdiv\u003e\u003c/div\u003e\u003cdiv\u003e\u003cdiv\u003e(By selecting 'No', the nominee might not be accepted and/or the nominee's Certificate of Admission issuance will not be guaranteed.)\u003cbr\u003e\u003c/div\u003e\u003c/div\u003e"]]],["응답이 기록되었습니다.",1,0,0,0],null,[null,null,null,null,null,[null,[["s-blob-v1-IMAGE-Ungp2FUCcJc",0,[3939,986,0]],[[98,188,234,null,1],[62,116,151,null,2],[168,178,215,null,1],[106,111,179,null,1],[128,128,255,null,1]]],null,[207,184,255,null,1],[245,241,255,null,1],0,[["Noto Sans KR",24,400,2],["Noto Sans KR",12,400,2],["Noto Sans KR",11,400,2]]]],null,null,[null,"If you wish to reach us regarding your nominations for the 2024 Fall Semester, email us at int-stud@sungshin.ac.kr"],"Spring 2027 Exchange Student Nomination Form",76,[1,0,null,2,null,null,1],null,null,null,null,[2],[[1,1,1,1,1],1],null,null,null,null,null,null,null,[null,"\u003cdiv\u003e\u003cb\u003eSungshin Women's University\u003c/b\u003e\u003c/div\u003e\u003cdiv\u003e\u003cb\u003eExchange Student Program Nomination Form\u003c/b\u003e\u003c/div\u003e\u003cdiv\u003e\u003cp\u003e\u003cstrong\u003eInstructions:\u003c/strong\u003e\u003c/p\u003e\u003col\u003e\u003cli\u003eThis form must be completed by the Partner University’s Outbound Program Coordinator and submitted in English.\u003c/li\u003e\u003cli\u003e\u003cspan\u003eThe form will remain open until Oct 23, 2026, and nominations will be considered only for Spring 2027.\u003c/span\u003e\u003c/li\u003e\u003cli\u003e\u003cspan\u003eNo replies will be provided once the form is submitted.\u003c/span\u003e\u003c/li\u003e\u003cli\u003e\u003cspan\u003eFor multiple nominations, please complete a separate form for each student.\u003c/span\u003e\u003c/li\u003e\u003cli\u003e\u003cspan\u003eIf a nominee withdraws from the exchange program, please inform us immediately.\u003c/span\u003e\u003c/li\u003e\u003c/ol\u003e\u003cp\u003e\u003cstrong\u003eKey Dates:\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cspan\u003e\u003cb\u003eNomination Period: Sep 14 – Oct 23, 2026 \u003c/b\u003e\u003c/span\u003e2026\u003cspan\u003e년 \u003c/span\u003e\u003cspan\u003e9\u003c/span\u003e\u003cspan\u003e월 \u003c/span\u003e\u003cspan\u003e14\u003c/span\u003e\u003cspan\u003e일 \u003c/span\u003e\u003cspan\u003e~ 10\u003c/span\u003e\u003cspan\u003e월 \u003c/span\u003e\u003cspan\u003e23\u003c/span\u003e\u003cspan\u003e일\u003c/span\u003e\u003cdiv\u003e\u003c/div\u003e\u003c/li\u003e\u003cli\u003e\u003cb\u003eOnline Application: Oct 26 – Nov 23, 2026\u003c/b\u003e  (Link: \u003ca href\u003d\"https://tis.sungshin.ac.kr/comm/nxui/member/join.do?join\u003d9\"\u003etis.sungshin.ac.kr/comm/nxui/member/join.do?join\u003d9\u003c/a\u003e)\u003c/li\u003e\u003cli\u003e\u003cb\u003eOriginal Document Submission\u003c/b\u003e \u003cb\u003e(by postal mail): Nov 23, 2026\u003c/b\u003e\u003c/li\u003e\u003cli\u003eCoA Issuance Period: End of Dec 2026 (for Spring 2027)\u003cbr\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eContact:\u003c/strong\u003e \u003ca\u003eintl-stud@sunghsin.ac.kr\u003c/a\u003e\u003cbr\u003e\u003cstrong\u003eFact Sheet:\u003c/strong\u003e \u003ca href\u003d\"https://www.sungshin.ac.kr/int/13456/subview.do?enc\u003dZm5jdDF8QEB8JTJGYmJzJTJGaW50JTJGMzgyOCUyRjE1MjY1OSUyRmFydGNsVmlldy5kbyUzRg%3D%3D\"\u003eExchange Students - Fall 2026 - Call for Exchange Student Nomination\u003cbr\u003e\u003c/a\u003e\u003c/p\u003e\u003c/div\u003e"],[null,"Spring 2027 Exchange Student Nomination Form\u003cspan\u003e\u003c/span\u003e\u003cspan\u003e\u003c/span\u003e"]],"/forms","Spring 2027 Exchange Student Nomination Form",null,null,null,"",null,0,0,null,"성신여자대학교",1,"e/1FAIpQLScj33BhDg2c7F9OBcHTeUPsHA2-91jXNKivaJ6zDqIEzEmu2g",0,"[]",0,0,1];</script><script id="base-js" src="https://www.gstatic.com/_/freebird/_/js/k=freebird.v.en.XsVm3qEBAFI.O/am=AAQAGA/d=1/rs=AMjVe6gF9aiAz4ZpwifnnKQYeedgGYk3UQ/m=viewer_base" nonce="bFrcbEMfjdWodj6ZJHy6WQ"></script></body></html>