id="dashboard-view">\n          <section id="guide" class="page-section study-guide" data-university-page="guide" aria-labelledby="guide-title" hidden>\n            <header class="guide-intro">\n              <div><span class="section-kicker">\u7533\u8acb\u6307\u5357</span><h1 id="guide-title">\u4f60\u7684\u4ea4\u63db\u65c5\u7a0b\uff0c<br>\u4e00\u6b65\u4e00\u6b65\u4f86\u3002</h1><p>\u5f9e\u9078\u6821\u5230\u51fa\u767c\uff0c\u627e\u5230\u4f60\u73fe\u5728\u9700\u8981\u7684\u4e0b\u4e00\u6b65\u3002</p></div>\n              <span class="uw-mascot guide-mascot" data-play data-tilt aria-hidden="true">\n                <span class="uw-mascot-shadow"></span>\n                <span class="uw-mascot-body">\n                  <span class="uw-mascot-tilt">\n                    <span class="uw-mascot-slab"></span>\n                    <img class="uw-mascot-picture" src="/static/assets/mascot/suitcase.webp?v=20261007-solid-1" alt="" width="384" height="460" decoding="async" draggable="false" />\n                    <span class="uw-mascot-sheen"></span>\n                    <span class="uw-mascot-eyes"><span class="uw-mascot-eye"></span><span class="uw-mascot-eye"></span></span>\n                  </span>\n                </span>\n              </span>\n            </header>\n            <ol class="guide-stages">\n              <li class="guide-stage guide-stage-explore"><span class="guide-stage-number">01</span><span class="guide-stage-icon"><i data-lucide="compass" aria-hidden="true"></i></span><h2>\u627e\u5230\u60f3\u53bb\u7684\u5b78\u6821</h2><p>\u6bd4\u8f03\u8ab2\u7a0b\u3001\u8a9e\u8a00\u9580\u6abb\u8207\u751f\u6d3b\u8cbb\u3002</p><a class="guide-action" href="#partners">\u63a2\u7d22\u5b78\u6821<i data-lucide="arrow-up-right" aria-hidden="true"></i></a></li>\n              <li class="guide-stage guide-stage-prepare"><span class="guide-stage-number">02</span><span class="guide-stage-icon"><i data-lucide="notebook-pen" aria-hidden="true"></i></span><h2>\u6e96\u5099\u6821\u5167\u7504\u9078</h2><p>\u78ba\u8a8d\u8cc7\u683c\u3001\u6392\u5fd7\u9858\uff0c\u518d\u6e96\u5099\u6587\u4ef6\u3002</p><a class="guide-action" href="#eligibility" data-requires-home-school>\u67e5\u770b\u8cc7\u683c\u8207\u5fd7\u9858<i data-lucide="arrow-up-right" aria-hidden="true"></i></a></li>\n              <li class="guide-stage guide-stage-apply"><span class="guide-stage-number">03</span><span class="guide-stage-icon"><i data-lucide="send" aria-hidden="true"></i></span><h2>\u5b8c\u6210\u5408\u4f5c\u6821\u7533\u8acb</h2><p>\u901a\u904e\u6821\u5167\u63d0\u540d\u5f8c\uff0c\u4f9d\u5408\u4f5c\u6821\u901a\u77e5\u9001\u4ef6\u3002</p><a class="guide-action" href="#application-center" data-requires-home-school>\u6e96\u5099\u7533\u8acb\u6587\u4ef6<i data-lucide="arrow-up-right" aria-hidden="true"></i></a></li>\n              <li class="guide-stage guide-stage-depart"><span class="guide-stage-number">04</span><span class="guide-stage-icon"><i data-lucide="luggage" aria-hidden="true"></i></span><h2>\u5b89\u6392\u51fa\u767c\u8207\u751f\u6d3b</h2><p>\u9304\u53d6\u5f8c\u78ba\u8a8d\u7c3d\u8b49\u3001\u4f4f\u5bbf\u8207\u4fdd\u96aa\u3002</p><a class="guide-action" href="#budget" data-requires-home-school>\u4f30\u7b97\u751f\u6d3b\u9810\u7b97<i data-lucide="arrow-up-right" aria-hidden="true"></i></a></li>\n            </ol>\n            <div class="guide-bottom-row">\n              <a class="guide-plan-link" href="#overview" data-requires-home-school><span class="guide-plan-icon"><i data-lucide="route" aria-hidden="true"></i></span><span><strong>\u5df2\u7d93\u958b\u59cb\u6e96\u5099\u4e86\uff1f</strong><small>\u56de\u5230\u6211\u7684\u4ea4\u63db\u8a08\u756b</small></span><i data-lucide="arrow-right" aria-hidden="true"></i></a>\n              <details class="guide-faq"><summary>\u6821\u5167\u7504\u9078\u548c\u5408\u4f5c\u6821\u7533\u8acb\u6709\u4ec0\u9ebc\u4e0d\u540c\uff1f<i data-lucide="plus" aria-hidden="true"></i></summary><p>\u4e00\u822c\u5148\u7531\u5c31\u8b80\u5b78\u6821\u7504\u9078\u8207\u63d0\u540d\uff0c\u518d\u5411\u5408\u4f5c\u6821\u7533\u8acb\u3002\u5169\u908a\u7684\u6587\u4ef6\u8207\u671f\u9650\u53ef\u80fd\u4e0d\u540c\uff0c\u8acb\u5206\u5225\u78ba\u8a8d\u7576\u671f\u516c\u544a\u3002</p><a href="#deadlines" data-requires-home-school>\u67e5\u770b\u5b98\u65b9\u622a\u6b62\u65e5<i data-lucide="arrow-right" aria-hidden="true"></i></a></details>\n            </div>\n          </section>\n          <section id="feedback" class="page-section feedback-page" data-university-page="feedback" aria-labelledby="feedback-title" hidden>\n            <header class="feedback-intro">\n              <div>\n                <span class="section-kicker">\u7528\u6236\u8a55\u50f9</span>\n                <h1 id="feedback-title">\u8aaa\u8aaa\u4f60\u7684\u60f3\u6cd5</h1>\n                <p>UniWay \u9084\u5728\u9577\u5927\u3002\u54ea\u88e1\u597d\u7528\u3001\u54ea\u88e1\u5361\u4f4f\u3001\u60f3\u8981\u4ec0\u9ebc\u65b0\u529f\u80fd\uff0c\u90fd\u53ef\u4ee5\u5beb\u5728\u9019\u88e1\uff0c\u6211\u5011\u6703\u4e00\u5247\u4e00\u5247\u770b\u3002</p>\n                <p class="feedback-invite" id="feedback-invite"><strong>\u6210\u529f\u7533\u8acb\u904e\u4ea4\u63db\u55ce\uff1f</strong>\u5c24\u5176\u662f\u9032\u4fee\u90e8\u3001\u78a9\u58eb\u5728\u8077\u5c08\u73ed\uff0c\u6216\u6771\u6b50\u9019\u985e\u6bd4\u8f03\u5c11\u4eba\u5206\u4eab\u7684\u5730\u5340\uff0c\u6b61\u8fce\u5beb\u4e0b\u54ea\u4e00\u5e74\u3001\u54ea\u6240\u5b78\u6821\u3001\u600e\u9ebc\u7533\u8acb\u3002\u82e5\u4f60\u7559\u4e0b\u806f\u7d61\u65b9\u5f0f\uff0c\u6211\u5011\u6703\u5148\u554f\u904e\u4f60\u540c\u610f\uff0c\u624d\u6703\u6574\u7406\u6210\u4e0d\u5177\u540d\u7684\u7d93\u9a57\u653e\u9032\u7db2\u7ad9\u3002</p>\n              </div>\n              <span class="uw-mascot feedback-mascot" data-play data-tilt aria-hidden="true">\n                <span class="uw-mascot-shadow"></span>\n                <span class="uw-mascot-body">\n                  <span class="uw-mascot-tilt">\n                    <span class="uw-mascot-slab"></span>\n                    <img class="uw-mascot-picture" src="/static/assets/mascot/suitcase.webp?v=20261007-solid-1" alt="" width="384" height="460" loading="lazy" decoding="async" draggable="false" />\n                    <span class="uw-mascot-sheen"></span>\n                    <span class="uw-mascot-eyes"><span class="uw-mascot-eye"></span><span class="uw-mascot-eye"></span></span>\n                  </span>\n                </span>\n              </span>\n            </header>\n            <form id="feedback-form" class="feedback-form glass-panel" novalidate>\n              <fieldset class="feedback-kinds">\n                <legend>\u4f60\u60f3\u8aaa\u7684\u662f</legend>\n                <label><input type="radio" name="kind" value="suggestion" checked /><span>\u5efa\u8b70</span></label>\n                <label><input type="radio" name="kind" value="bug" /><span>\u554f\u984c\u56de\u5831</span></label>\n                <label><input type="radio" name="kind" value="praise" /><span>\u7a31\u8b9a</span></label>\n                <label><input type="radio" name="kind" value="other" /><span>\u5176\u4ed6</span></label>\n              </fieldset>\n              <fieldset class="feedback-rating">\n                <legend>\u6574\u9ad4\u611f\u89ba\uff08\u9078\u586b\uff09</legend>\n                <div class="feedback-stars" role="radiogroup" aria-label="\u6574\u9ad4\u8a55\u5206">\n                  <input id="feedback-star-5" type="radio" name="rating" value="5" /><label for="feedback-star-5" aria-label="5 \u9846\u661f">\u2605</label>\n                  <input id="feedback-star-4" type="radio" name="rating" value="4" /><label for="feedback-star-4" aria-label="4 \u9846\u661f">\u2605</label>\n                  <input id="feedback-star-3" type="radio" name="rating" value="3" /><label for="feedback-star-3" aria-label="3 \u9846\u661f">\u2605</label>\n                  <input id="feedback-star-2" type="radio" name="rating" value="2" /><label for="feedback-star-2" aria-label="2 \u9846\u661f">\u2605</label>\n                  <input id="feedback-star-1" type="radio" name="rating" value="1" /><label for="feedback-star-1" aria-label="1 \u9846\u661f">\u2605</label>\n                </div>\n                <button id="feedback-clear-rating" type="button" class="text-action" hidden>\u6e05\u9664\u8a55\u5206</button>\n              </fieldset>\n              <label class="feedback-field">\n                <span>\u5167\u5bb9</span>\n                <textarea id="feedback-message" name="message" rows="6" minlength="5" maxlength="2000" required placeholder="\u4f8b\u5982\uff1a\u5e0c\u671b\u5b78\u6821\u641c\u5c0b\u53ef\u4ee5\u76f4\u63a5\u6bd4\u8f03\u5b78\u8cbb\uff1b\u6216\u662f\u67d0\u500b\u9801\u9762\u5728\u624b\u6a5f\u4e0a\u770b\u4e0d\u6e05\u695a\u3002"></textarea>\n                <small id="feedback-count" aria-live="off">0 / 2000</small>\n              </label>\n              <label class="feedback-field">\n                <span>\u806f\u7d61\u65b9\u5f0f\uff08\u9078\u586b\uff09</span>\n                <input name="contact" type="text" maxlength="120" autocomplete="off" placeholder="\u96fb\u5b50\u90f5\u4ef6\u6216 LINE ID" />\n                <small class="feedback-hint">\u53ea\u6709\u9700\u8981\u56de\u8986\u4f60\u7684\u6642\u5019\u624d\u6703\u7528\u5230\uff1b\u4e0d\u60f3\u88ab\u806f\u7d61\u5c31\u7559\u7a7a\u3002</small>\n              </label>\n              <div class="feedback-trap" aria-hidden="true"><label>\u7db2\u7ad9<input name="website" type="text" tabindex="-1" autocomplete="off" /></label></div>\n              <p class="feedback-note"><i data-lucide="shield-check" aria-hidden="true"></i><span>\u8acb\u4e0d\u8981\u586b\u5beb\u5bc6\u78bc\u3001\u8eab\u5206\u8b49\u5b57\u865f\u3001\u5b78\u865f\u7b49\u500b\u4eba\u8cc7\u6599\u3002\u4f60\u7684\u7559\u8a00\u53ea\u6709\u7db2\u7ad9\u7ba1\u7406\u54e1\u770b\u5f97\u5230\u3002\u8a73\u898b<a href="/privacy">\u96b1\u79c1\u6b0a\u653f\u7b56</a>\u3002</span></p>\n              <div id="feedback-status" class="form-status feedback-status" role="status" aria-live="polite"></div>\n              <button id="feedback-submit" type="submit" class="primary-button"><i data-lucide="send" aria-hidden="true"></i><span>\u9001\u51fa</span></button>\n            </form>\n            <section id="feedback-thanks" class="feedback-thanks glass-panel" aria-live="polite" hidden>\n              <h2>\u8b1d\u8b1d\u4f60\uff01\u6211\u5011\u6536\u5230\u4e86</h2>\n              <p>\u4f60\u7684\u60f3\u6cd5\u6703\u5e6b\u52a9 UniWay \u8b8a\u5f97\u66f4\u597d\u3002</p>\n              <button id="feedback-again" type="button" class="secondary-button">\u518d\u5beb\u4e00\u5247</button>\n            </section>\n          </section>\n          <section id="overview" class="overview-section visual-overview" data-university-page="overview" aria-labelledby="personal-plan-title">\n            <section class="personal-plan-board glass-panel" aria-labelledby="personal-plan-title">\n              <div class="concise-heading">\n                <div><h2 id="personal-plan-title">\u6211\u7684\u4ea4\u63db\u8a08\u756b</h2></div>\n                <a href="#advisor"><span>\u8abf\u6574\u6211\u7684\u689d\u4ef6</span><i data-lucide="sliders-horizontal" aria-hidden="true"></i></a>\n              </div>\n              <div id="planning-next-action" class="planning-next-action" aria-live="polite"></div>\n              <div id="personal-plan-snapshot" class="personal-plan-snapshot"><div class="skeleton skeleton-card"></div></div>\n            </section>\n\n            <section class="recommended-match-section" aria-labelledby="recommended-match-title">\n              <div class="concise-heading"><div><span class="section-kicker">\u689d\u4ef6\u914d\u5c0d</span><h2 id="recommended-match-title">\u9078\u51fa\u4f60\u7684\u4e0b\u4e00\u7ad9</h2></div><a href="#advisor">\u67e5\u770b\u63a8\u85a6\u8207\u8abf\u6574\u689d\u4ef6</a></div>\n              <div id="recommended-match-list" class="recommended-match-list"><div class="skeleton skeleton-card"></div></div>\n            </section>\n\n            <section id="multi-plan-workspace" class="journey-workspace glass-panel" aria-labelledby="multi-plan-title" hidden>\n              <header class="concise-heading"><div><span class="section-kicker">\u4e00\u4efd\u6e05\u55ae\uff0c\u7167\u9867\u6240\u6709\u5fd7\u9858</span><h2 id="multi-plan-title">\u6211\u7684\u5fd7\u9858\u8207\u5171\u7528\u6e96\u5099</h2></div><a href="#favorites">\u9078\u6821\u6bd4\u8f03</a></header>\n              <details id="multi-plan-settings"><summary>\u8a2d\u5b9a\u8207\u8abf\u6574\u5fd7\u9858\u9806\u5e8f</summary>\n                <form id="multi-plan-preferences" class="multi-plan-preferences">\n                  <label>\u7b2c\u4e00\u5fd7\u9858<select name="preference_1"></select></label>\n                  <label>\u7b2c\u4e8c\u5fd7\u9858<select name="preference_2"></select></label>\n                  <label>\u7b2c\u4e09\u5fd7\u9858<select name="preference_3"></select></label>\n                  <label>\u7b2c\u56db\u5fd7\u9858<select name="preference_4"></select></label>\n                  <label>\u7b2c\u4e94\u5fd7\u9858<select name="preference_5"></select></label>\n                  <button type="submit" class="secondary-button">\u4fdd\u5b58\u5fd7\u9858\u9806\u5e8f</button>\n                </form>\n                <p>\u9019\u662f\u500b\u4eba\u6e96\u5099\u9806\u5e8f\uff1b\u6b63\u5f0f\u5fd7\u9858\u6578\u3001\u8a9e\u7d44\u8207\u5206\u767c\u898f\u5b9a\u4ecd\u4ee5\u672c\u6821\u7576\u671f\u516c\u544a\u70ba\u6e96\u3002\u8abf\u6574\u9806\u5e8f\u6703\u4fdd\u7559\u65e2\u6709\u9032\u5ea6\uff1b\u6587\u4ef6\u8207\u6642\u7a0b\u76ee\u6a19\u53ef\u5728\u5404\u6821\u6e05\u55ae\u4e2d\u9078\u64c7\u3002</p>\n              </details>\n              <p id="multi-plan-status" role="status" aria-live="polite"></p>\n              <div id="multi-plan-tasks"></div>\n            </section>\n            <section id="planning-workspace" class="planning-workspace glass-panel" aria-labelledby="planning-title">\n              <div class="concise-heading"><div><span class="section-kicker">\u9078\u6821\u4e4b\u5f8c\uff0c\u63a5\u8457\u6e96\u5099</span><h2 id="planning-title">\u5b89\u6392\u6211\u7684\u6e96\u5099\u6642\u7a0b</h2></div><a href="#calendar">\u67e5\u770b\u5b8c\u6574\u65e5\u66c6</a></div>\n              <div id="planning-target-summary" class="planning-target-summary"></div>\n              <form id="planning-schedule-form" class="planning-schedule-form">\n                <label for="planning-academic-year"><span>\u7533\u8acb\u5b78\u5e74\u5ea6</span><input id="planning-academic-year" name="academic_year" maxlength="10" placeholder="\u4f8b\u5982\uff1a116" list="planning-year-options" aria-describedby="planning-period-hint" required /><datalist id="planning-year-options"></datalist></label>\n                <label for="planning-application-round"><span>\u7533\u8acb\u68af\u6b21\uff08\u9078\u586b\uff09</span><input id="planning-application-round" name="application_round" maxlength="80" placeholder="\u4f9d\u5b98\u65b9\u516c\u544a\u586b\u5beb" list="planning-round-options" aria-describedby="planning-period-hint" /><datalist id="planning-round-options"></datalist></label>\n                <label for="planning-preparation-days"><span>\u6bcf\u9805\u4efb\u52d9\u9810\u7559\u5e7e\u5929\uff1f</span><span class="planning-days-control"><input id="planning-preparation-days" name="preparation_days" type="number" min="1" max="90" value="14" required /><span>\u5929</span></span></label>\n                <div><p>\u9019\u662f\u4f60\u53ef\u8abf\u6574\u7684\u6e96\u5099\u5929\u6578\uff1b\u7cfb\u7d71\u4f9d\u5df2\u78ba\u8a8d\u7684\u5b98\u65b9\u622a\u6b62\u65e5\u5f80\u524d\u5b89\u6392\uff0c\u4f7f\u7528\u65e5\u66c6\u5929\u8a08\u7b97\u3002</p><button id="planning-preview-button" type="submit" class="secondary-button"><i data-lucide="calendar-range" aria-hidden="true"></i><span>\u9810\u89bd\u6e96\u5099\u6642\u7a0b</span></button></div>\n              </form>\n              <p id="planning-period-hint" class="application-period-hint"></p>\n              <div id="planning-schedule-status" class="planning-schedule-status" role="status" aria-live="polite"></div>\n              <div id="planning-schedule-recovery" class="planning-recovery" hidden></div>\n              <div id="planning-schedule-preview" class="planning-schedule-preview"></div>\n              <button id="planning-update-durations" type="button" class="secondary-button" hidden>\u66f4\u65b0\u5404\u9805\u6e96\u5099\u5929\u6578\u4e26\u91cd\u65b0\u9810\u89bd</button>\n              <button id="planning-confirm" type="button" class="primary-button" hidden><i data-lucide="calendar-plus" aria-hidden="true"></i><span>\u78ba\u8a8d\u52a0\u5165\u6211\u7684\u6642\u7a0b</span></button>\n            </section>\n            <section id="journey-workspace" class="journey-workspace glass-panel" aria-labelledby="journey-workspace-title" hidden>\n              <header class="concise-heading"><div><span class="section-kicker">\u8b93\u6e96\u5099\u7b26\u5408\u4f60\u7684\u751f\u6d3b</span><h2 id="journey-workspace-title">\u6211\u7684\u6e96\u5099\u5de5\u4f5c\u53f0</h2></div><a href="#calendar">\u5b8c\u6574\u65e5\u66c6<i data-lucide="arrow-right" aria-hidden="true"></i></a></header>\n              <div id="journey-today" class="journey-today" aria-live="polite"></div>\n              <details id="journey-capacity-settings" class="journey-settings">\n                <summary>\u8a2d\u5b9a\u53ef\u6295\u5165\u6642\u9593\u8207\u91cd\u65b0\u5b89\u6392<i data-lucide="sliders-horizontal" aria-hidden="true"></i></summary>\n                <form id="journey-availability-form">\n                  <label><span>\u6bcf\u9031\u80fd\u6295\u5165\u5e7e\u5c0f\u6642\uff1f</span><input name="weekly_hours" type="number" min="0.5" max="60" step="0.5" value="6" required /></label>\n                  <fieldset><legend>\u53ef\u4ee5\u6e96\u5099\u7684\u661f\u671f</legend><div class="journey-weekdays">\n                    <label><input type="checkbox" name="weekdays" value="1" checked />\u4e00</label><label><input type="checkbox" name="weekdays" value="2" />\u4e8c</label><label><input type="checkbox" name="weekdays" value="3" checked />\u4e09</label><label><input type="checkbox" name="weekdays" value="4" />\u56db</label><label><input type="checkbox" name="weekdays" value="5" />\u4e94</label><label><input type="checkbox" name="weekdays" value="6" checked />\u516d</label><label><input type="checkbox" name="weekdays" value="7" />\u65e5</label>\n                  </div></fieldset>\n                  <label><span>\u9810\u89bd\u672a\u4f86\u5e7e\u5929\uff1f</span><input name="horizon_days" type="number" min="1" max="365" value="180" required /></label>\n                  <button class="primary-button" type="submit"><i data-lucide="calendar-cog" aria-hidden="true"></i><span>\u4f9d\u5269\u9918\u5de5\u4f5c\u91cd\u65b0\u5b89\u6392</span></button>\n                  <p>\u6642\u6578\u5e73\u5747\u5206\u914d\u5230\u4f60\u52fe\u9078\u7684\u661f\u671f\u3002\u4e0b\u9762\u6bcf\u9805\u4efb\u52d9\u53ef\u586b\u5de5\u6642\u3001\u524d\u7f6e\u4efb\u52d9\u8207\u7b49\u5f85\u539f\u56e0\uff1b\u6e96\u5099\u5929\u6578\u4e0d\u6703\u88ab\u7576\u4f5c\u5de5\u4f5c\u6642\u6578\u3002</p>\n                  <div id="journey-settings-status" role="status"></div>\n                </form>\n              </details>\n              <details id="journey-task-settings" class="journey-settings"><summary>\u4efb\u52d9\u5de5\u6642\u3001\u524d\u7f6e\u95dc\u4fc2\u8207\u6587\u4ef6<i data-lucide="list-checks" aria-hidden="true"></i></summary><div id="journey-task-editors" class="journey-task-editors"></div></details>\n              <div id="journey-schedule-result" class="journey-schedule-result" aria-live="polite"></div>\n            </section>\n            <section class="planning-documents glass-panel"><span class="planning-documents-icon"><i data-lucide="folder-check" aria-hidden="true"></i></span><div><h2>\u63a5\u8457\uff0c\u6e96\u5099\u7533\u8acb\u6587\u4ef6</h2><p id="planning-document-status" aria-live="polite">\u76ee\u6a19\u5b78\u6821\u6703\u5e36\u5165\u6587\u4ef6\u5de5\u4f5c\u5340\uff0c\u4f9d\u7576\u671f\u898f\u5b9a\u78ba\u8a8d\u8868\u683c\u3001\u7c3d\u7ae0\u8207\u4efd\u6578\u3002</p></div><a href="#application-center" class="secondary-button">\u958b\u555f\u7533\u8acb\u6587\u4ef6<i data-lucide="arrow-right" aria-hidden="true"></i></a></section>\n          </section>\n\n          <section id="community-hub" class="page-section global-community-section" aria-labelledby="community-hub-title">\n            <div class="community-feed-header">\n              <header class="community-home-heading">\n                <div><span id="community-home-kicker" class="section-kicker" hidden>\u5168\u53f0\u5b78\u751f\u5171\u540c\u4ea4\u6d41</span><h1 id="community-hub-title">\u6700\u65b0\u7559\u5b78\u8a0e\u8ad6</h1><p id="community-home-description" hidden>\u67e5\u770b\u8de8\u6821\u7533\u8acb\u7d93\u9a57\u3001\u4f4f\u5bbf\u3001\u734e\u5b78\u91d1\u8207\u6d77\u5916\u751f\u6d3b\u8a0e\u8ad6\u3002</p></div>\n                <button id="global-community-compose" type="button" class="primary-button" aria-label="\u767c\u4e00\u7bc7\u6587\u7ae0"><i data-lucide="square-pen" aria-hidden="true"></i><span>\u767c\u4e00\u7bc7\u6587\u7ae0</span></button>\n              </header>\n              <nav id="community-feed-tabs" class="community-feed-tabs" aria-label="\u8cbc\u6587\u52d5\u614b\u7be9\u9078">\n                <a href="#forum" data-community-route="all" aria-current="page"><i data-lucide="sparkles" aria-hidden="true"></i><span>\u5168\u90e8</span></a>\n                <a href="#following" data-community-route="following"><i data-lucide="rss" aria-hidden="true"></i><span>\u8ffd\u8e64</span></a>\n                <a href="#public-board" data-community-route="public"><i data-lucide="globe-2" aria-hidden="true"></i><span>\u516c\u5171\u677f</span></a>\n                <a href="#language-school-board" data-community-route="language"><i data-lucide="languages" aria-hidden="true"></i><span>\u8a9e\u8a00\u5b78\u6821</span></a>\n                <a href="#university-feed" data-community-route="university"><i data-lucide="graduation-cap" aria-hidden="true"></i><span><b data-home-school-short>\u9577\u5e9a</b>\u677f</span></a>\n              </nav>\n            </div>\n            <section class="featured-board-grid" aria-label="\u7559\u5b78\u770b\u677f">\n              <article class="featured-board-card public-board-card">\n                <span class="board-avatar board-avatar-public" aria-hidden="true"><i data-lucide="messages-square"></i></span>\n                <div><span class="board-label">\u516c\u5171\u770b\u677f</span><h2>\u516c\u5171\u7559\u5b78\u677f</h2><p>\u8de8\u6821\u7533\u8acb\u3001\u7c3d\u8b49\u3001\u4f4f\u5bbf\u8207\u6d77\u5916\u751f\u6d3b\u3002</p><a href="#public-board" class="text-action">\u67e5\u770b\u8cbc\u6587<i data-lucide="arrow-right" aria-hidden="true"></i></a></div>\n              </article>\n              <article class="featured-board-card cgu-board-card">\n                <span class="board-avatar board-avatar-school" aria-hidden="true"><i data-lucide="graduation-cap"></i></span>\n                <div><span class="board-label">\u6821\u7d1a\u770b\u677f</span><h2 data-home-school-board>\u9577\u5e9a\u5927\u5b78\u677f</h2><p id="featured-home-school-description">\u9577\u5e9a\u5b78\u751f\u7684\u4ea4\u63db\u7533\u8acb\u8cc7\u8a0a\u8207\u8a0e\u8ad6\u3002</p><div class="board-card-actions"><button type="button" class="secondary-button board-follow-button" data-follow-board="\u9577\u5e9a\u5927\u5b78" data-home-school-follow><i data-lucide="plus" aria-hidden="true"></i><span>\u8ffd\u8e64</span></button><a href="#board=\u9577\u5e9a\u5927\u5b78" class="primary-button" data-home-school-link><span>\u9032\u5165\u770b\u677f</span><i data-lucide="arrow-right" aria-hidden="true"></i></a></div></div>\n              </article>\n              <article class="featured-board-card language-board-card">\n                <span class="board-avatar board-avatar-language" aria-hidden="true"><i data-lucide="languages"></i></span>\n                <div><span class="board-label">\u516c\u5171\u4e3b\u984c\u677f</span><h2>\u8a9e\u8a00\u5b78\u6821\u677f</h2><p>\u8ab2\u7a0b\u8207\u6d77\u5916\u751f\u6d3b\u4ea4\u6d41\uff1b\u4e0d\u63d0\u4f9b\u7533\u8acb\u4ee3\u8fa6\u3002</p><a href="#language-school-board" class="text-action">\u67e5\u770b\u8a0e\u8ad6<i data-lucide="arrow-right" aria-hidden="true"></i></a></div>\n              </article>\n            </section>\n            <div class="discussion-workspace">\n            <div class="global-community-toolbar">\n              <div class="discussion-discovery-heading"><span>\u6bcf\u4e00\u6bb5\u65c5\u7a0b\uff0c\u90fd\u6709\u4eba\u540c\u884c</span><h2>\u804a\u804a\u7559\u5b78\u5927\u5c0f\u4e8b</h2></div>\n              <label class="community-search"><i data-lucide="search" aria-hidden="true"></i><input id="global-community-search" maxlength="80" aria-label="\u641c\u5c0b\u5b78\u6821\u3001\u570b\u5bb6\u6216\u554f\u984c" placeholder="\u641c\u5c0b\u5b78\u6821\u3001\u570b\u5bb6\u6216\u554f\u984c" /></label>\n              <div id="global-community-topics" class="community-topic-chips" role="group" aria-label="\u6587\u7ae0\u5206\u985e"></div>\n            </div>\n            <div class="discussion-feed-controls"><label>\u6587\u7ae0\u6392\u5e8f<select id="discussion-sort"><option value="latest">\u6700\u65b0\u6587\u7ae0</option><option value="oldest">\u8f03\u65e9\u6587\u7ae0</option><option value="unanswered">\u5f85\u56de\u8986</option></select></label><button id="discussion-saved-filter" type="button" class="text-action" aria-pressed="false"><i data-lucide="bookmark" aria-hidden="true"></i><span>\u6211\u7684\u6587\u7ae0\u6536\u85cf</span></button><small id="discussion-bookmark-status" role="status">\u6536\u85cf\u4fdd\u5b58\u5728\u6b64\u700f\u89bd\u5668</small><button id="discussion-import-saved" type="button" class="text-action" hidden>\u540c\u6b65\u6b64\u700f\u89bd\u5668\u820a\u6536\u85cf</button><button id="discussion-moderation-open" type="button" class="secondary-button" hidden>\u8a0e\u8ad6\u7ba1\u7406</button></div>\n            <div class="community-layout">\n              <div class="community-main">\n                <form id="global-community-form" class="global-community-form" hidden>\n                  <div class="community-form-grid"><label><span>\u767c\u5e03\u770b\u677f</span><select id="global-community-school" name="board_id" required><option value="public-study-abroad">\u516c\u5171\u7559\u5b78\u677f</option><option value="language-school">\u8a9e\u8a00\u5b78\u6821\u677f</option></select></label><label><span>\u6587\u7ae0\u985e\u578b</span><select name="post_type"><option value="question">\u8acb\u76ca</option><option value="experience">\u7d93\u9a57\u5206\u4eab</option><option value="discussion">\u8a0e\u8ad6</option></select></label><label><span>\u4e3b\u984c</span><select name="topic"><option value="application">\u7533\u8acb</option><option value="scholarship">\u734e\u5b78\u91d1</option><option value="housing">\u4f4f\u5bbf</option><option value="cost">\u751f\u6d3b\u8cbb</option><option value="visa">\u7c3d\u8b49</option><option value="academics">\u8ab2\u7a0b</option><option value="life">\u751f\u6d3b</option><option value="career">\u5c31\u696d</option><option value="warning">\u907f\u96f7\u63d0\u9192</option></select></label><label><span>\u570b\u5bb6</span><input name="country" maxlength="80" placeholder="\u4f8b\u5982\uff1a\u65e5\u672c" /></label><label><span>\u7533\u8acb\u5e74\u5ea6</span><input name="academic_year" maxlength="20" placeholder="\u4f8b\u5982\uff1a2027 \u79cb\u5b63" /></label><label><span>\u76ee\u524d\u968e\u6bb5</span><select name="application_stage"><option value="exploring">\u63a2\u7d22\u4e2d</option><option value="preparing">\u6e96\u5099\u7533\u8acb</option><option value="submitted">\u5df2\u9001\u4ef6</option><option value="accepted">\u5df2\u9304\u53d6</option><option value="abroad">\u6b63\u5728\u6d77\u5916</option><option value="returned">\u5df2\u8fd4\u53f0</option></select></label></div>\n                  <label><span>\u6a19\u984c</span><input name="title" minlength="4" maxlength="120" required placeholder="\u4e00\u53e5\u8a71\u8aaa\u6e05\u695a\u60f3\u554f\u6216\u60f3\u5206\u4eab\u7684\u4e8b\u60c5" /></label>\n                  <label><span>\u5167\u5bb9</span><textarea name="body" minlength="10" maxlength="1600" required placeholder="\u52a0\u5165\u5e74\u4efd\u3001\u5b78\u6821\u8207\u5177\u9ad4\u60c5\u6cc1\uff0c\u6703\u66f4\u5bb9\u6613\u5f97\u5230\u6709\u7528\u56de\u8986\u3002"></textarea></label>\n                  <div id="global-community-identity"></div>\n                  <small data-discussion-draft-status role="status">\u8349\u7a3f\u6703\u4fdd\u5b58\u5728\u6b64\u5206\u9801</small>\n                  <div class="community-form-footer"><div class="form-status" role="status"></div><button type="button" class="secondary-button" data-cancel-global-post>\u53d6\u6d88</button><button type="submit" class="primary-button"><i data-lucide="send" aria-hidden="true"></i><span>\u767c\u5e03\u6587\u7ae0</span></button></div>\n                </form>\n                <div id="global-community-feed" class="global-community-feed" aria-live="polite"><div class="skeleton skeleton-card"></div><div class="skeleton skeleton-card"></div></div>\n                <div class="discussion-pagination"><span id="discussion-feed-status" role="status"></span><button id="discussion-feed-more" type="button" class="secondary-button" hidden>\u8f09\u5165\u66f4\u591a\u6587\u7ae0</button></div>\n              </div>\n              <aside class="community-guidelines">\n                <section class="discussion-writing-guide" aria-labelledby="discussion-writing-title">\n                  <span class="discussion-aside-icon"><i data-lucide="notebook-pen" aria-hidden="true"></i></span>\n                  <h3 id="discussion-writing-title">\u4f60\u7684\u7d93\u9a57\uff0c\u6703\u662f\u8ab0\u7684\u8d77\u9ede</h3>\n                  <p>\u4e00\u500b\u63d0\u9192\uff0c\u5c31\u80fd\u8b93\u540c\u5b78\u5c11\u8d70\u5f4e\u8def\u3002</p>\n                  <ol><li><span>01</span>\u8aaa\u8aaa\u4f60\u53bb\u4e86\u54ea\u88e1</li><li><span>02</span>\u5e36\u4e0a\u5e74\u4efd\u8207\u7533\u8acb\u968e\u6bb5</li><li><span>03</span>\u5206\u4eab\u9047\u5230\u7684\u554f\u984c\u6216\u5fc3\u5f97</li></ol>\n                  <button type="button" class="text-action" data-open-global-community-composer>\u5beb\u4e0b\u6211\u7684\u7d93\u9a57<i data-lucide="arrow-up-right" aria-hidden="true"></i></button>\n                </section>\n                <section class="discussion-safety-guide" aria-labelledby="discussion-safety-title"><h3 id="discussion-safety-title"><i data-lucide="shield-check" aria-hidden="true"></i>\u5b89\u5fc3\u4ea4\u6d41\uff0c\u4e00\u8d77\u5b88\u8b77</h3><p>\u66b1\u7a31\u767c\u6587\uff0c\u4fdd\u8b77\u5f7c\u6b64\u7684\u96b1\u79c1\u3002</p><ul><li>\u4e0d\u516c\u958b\u96fb\u8a71\u3001\u4fe1\u7bb1\u6216\u793e\u7fa4\u5e33\u865f</li><li>\u79c1\u8a0a\u9700\u5c0d\u65b9\u63a5\u53d7\uff0c\u53ef\u6aa2\u8209\u8207\u5c01\u9396</li><li>\u7533\u8acb\u8cc7\u8a0a\u8acb\u518d\u6838\u5c0d\u5b98\u65b9\u516c\u544a</li></ul></section>\n              </aside>\n            </div>\n            </div>\n          </section>\n\n          <section id="advisor" class="page-section advisor-section" data-university-page="advisor" aria-labelledby="advisor-title" hidden>\n            <header class="advisor-hero">\n              <div><h2 id="advisor-title">\u9078\u6821\u898f\u5283</h2><p>\u586b\u4e00\u6b21\u689d\u4ef6\uff0c\u67e5\u770b\u63a8\u85a6\u8207\u7f3a\u53e3\uff0c\u518d\u9078\u64c7\u76ee\u6a19\u5b78\u6821\u5b89\u6392\u6642\u7a0b\u3002</p></div>\n              <span class="advisor-hero-icon" aria-hidden="true"><i data-lucide="sparkles"></i></span>\n            </header>\n            <div class="advisor-layout">\n              <form id="advisor-form" class="advisor-form glass-panel">\n                <div class="workspace-heading"><span><i data-lucide="sliders-horizontal" aria-hidden="true"></i><strong>\u6211\u7684\u689d\u4ef6</strong></span><small id="advisor-profile-status">\u672a\u767b\u5165\uff0c\u4e0d\u6703\u4fdd\u5b58\u689d\u4ef6</small></div>\n                <div class="advisor-fields">\n                  <label><span>\u5b78\u9662</span><select id="advisor-college" name="college"></select></label>\n                  <label><span>\u6240\u5c6c\u7cfb\u6240</span><select id="advisor-department" name="department" aria-describedby="advisor-department-note" disabled><option value="">\u8acb\u5148\u9078\u64c7\u5b78\u9662</option></select><input id="advisor-department-text" name="department" type="text" maxlength="120" placeholder="\u8acb\u586b\u5b78\u7c4d\u4e0a\u7684\u7cfb\u6240\u6216\u5b78\u4f4d\u5b78\u7a0b" aria-describedby="advisor-department-note" hidden disabled /></label>\n                  <label><span>\u5b78\u5236</span><select id="advisor-degree" name="degree_level"><option value="">\u5c1a\u672a\u8a2d\u5b9a</option><option value="\u5927\u5b78\u90e8">\u5927\u5b78\u90e8</option><option value="\u7814\u7a76\u6240">\u7814\u7a76\u6240</option></select></label>\n                  <label id="advisor-percent-field"><span>\u5b78\u696d\u5e73\u5747</span><input id="advisor-academic-score" name="academic_score" type="number" min="0" max="100" step="0.1" inputmode="decimal" placeholder="\u4f8b\u5982 82" /></label>\n                  <label data-ntu-academic-field hidden><span>\u9069\u7528\u5b78\u5e74GPA\uff084.3\u5236\uff09</span><input id="advisor-academic-gpa" name="academic_gpa" type="number" min="0" max="4.3" step="0.01" inputmode="decimal" placeholder="\u4f8b\u5982 2.44\uff1b\u8207\u6392\u540d\u64c7\u4e00" disabled /></label>\n                  <label data-ntu-academic-field hidden><span>\u9069\u7528\u5b78\u5e74\u73ed\u6392\u540d\uff08\u524d\u5e7e%\uff09</span><input id="advisor-class-rank" name="class_rank_percent" type="number" min="0.01" max="100" step="0.01" inputmode="decimal" placeholder="\u4f8b\u5982\u524d30%\u586b30" disabled /></label>\n                  <label><span>\u8a9e\u8a00\u6e2c\u9a57</span><select id="advisor-language-test" name="language_test"><option value="">\u5c1a\u672a\u8003\uff0f\u5c1a\u672a\u6c7a\u5b9a</option><option value="toeic">TOEIC</option><option value="ielts">IELTS Academic</option><option value="toefl">TOEFL iBT\uff08\u820a\u5236120\u5206\uff09</option><option value="toefl_new">TOEFL iBT\uff08\u65b0\u52366\u5206\uff09</option><option value="duolingo">Duolingo</option><option value="other">\u5176\u4ed6</option></select></label>\n                  <label><span>\u8a9e\u8a00\u5206\u6578</span><input placeholder="\u5c1a\u672a\u8003\u53ef\u7559\u7a7a" id="advisor-language-score" name="language_score" type="number" min="0" step="0.5" inputmode="decimal" /></label>\n                  <label><span>\u60f3\u53bb\u7684\u570b\u5bb6\uff0f\u5730\u5340</span><select id="advisor-country" name="preferred_country"></select></label>\n                  <label><span>\u9810\u8a08\u51fa\u570b\u5b78\u671f</span><select id="advisor-target-term" name="target_term"><option value="">\u5c1a\u672a\u6c7a\u5b9a</option><option value="2027-spring">2027 \u6625\u5b63</option><option value="2027-fall">2027 \u79cb\u5b63</option><option value="2028-spring">2028 \u6625\u5b63</option><option value="2028-fall">2028 \u79cb\u5b63</option></select></label>\n                </div>\n                <p id="advisor-academic-rule" class="academic-directory-note" hidden>\u4f9d\u672c\u6821\u7576\u671f\u7c21\u7ae0\u78ba\u8a8d\u6210\u7e3e\u9580\u6abb\u3002</p>\n                <p class="academic-directory-note"><span id="advisor-department-note">\u9078\u64c7\u5b78\u9662\u5f8c\u986f\u793a\u6240\u5c6c\u7cfb\u6240\u3002</span><a id="advisor-department-source" target="_blank" rel="noopener noreferrer" hidden>\u5b98\u65b9\u540d\u55ae</a></p>\n                <details class="advisor-more-fields">\n                  <summary><span><i data-lucide="sliders-horizontal" aria-hidden="true"></i><strong>\u66f4\u591a\u689d\u4ef6</strong></span><i data-lucide="chevron-down" aria-hidden="true"></i></summary>\n                  <div class="advisor-fields">\n                    <label><span>\u5e74\u7d1a</span><select id="advisor-current-year" name="current_year"><option value="">\u5c1a\u672a\u8a2d\u5b9a</option><option value="\u5927\u4e00">\u5927\u4e00</option><option value="\u5927\u4e8c">\u5927\u4e8c</option><option value="\u5927\u4e09">\u5927\u4e09</option><option value="\u5927\u56db">\u5927\u56db</option><option value="\u78a9\u58eb\u73ed">\u78a9\u58eb\u73ed</option><option value="\u535a\u58eb\u73ed">\u535a\u58eb\u73ed</option></select></label>\n\n                    <label><span>\u6bcf\u6708\u9810\u7b97</span><input id="advisor-monthly-budget" name="monthly_budget" type="number" min="0" step="1000" inputmode="decimal" placeholder="\u65b0\u53f0\u5e63" /></label>\n                    <label><span>\u504f\u597d\u6388\u8ab2\u8a9e\u8a00</span><select id="advisor-teaching-language" name="preferred_teaching_language"><option value="">\u4e0d\u9650</option><option value="english">\u82f1\u8a9e</option><option value="japanese">\u65e5\u8a9e</option><option value="chinese">\u4e2d\u6587</option><option value="other">\u5176\u4ed6\u8a9e\u8a00</option></select></label>\n                    <label><span>\u60f3\u4fee\u7684\u9818\u57df\u6216\u8ab2\u7a0b</span><input id="advisor-course-interests" name="course_interests" type="text" maxlength="120" placeholder="\u4f8b\u5982\uff1a\u8cc7\u6599\u79d1\u5b78\u3001\u570b\u969b\u6cd5\uff08\u9078\u586b\uff09" /></label>\n                    <label class="advisor-toggle"><input id="advisor-scholarship" name="needs_scholarship" type="checkbox" /><span><strong>\u9700\u8981\u88dc\u52a9</strong><small>\u4e00\u4f75\u6574\u7406\u88dc\u52a9\u9650\u5236</small></span></label>\n                  </div>\n                </details>\n                <fieldset id="application-period-fields" class="application-period-fields" disabled hidden>\n                  <legend>\u672c\u6b21\u7533\u8acb\u8207\u5fd7\u9858</legend>\n                <label for="eligibility-academic-year"><span>\u7533\u8acb\u5b78\u5e74\u5ea6</span><select id="eligibility-academic-year" aria-describedby="application-period-hint" required><option value="">\u8acb\u9078\u64c7</option><option value="115">115 \u5b78\u5e74\u5ea6\uff08\u6d41\u7a0b\u8cc7\u6599\u5f85\u78ba\u8a8d\uff09</option><option value="116">116 \u5b78\u5e74\u5ea6\uff08\u6d41\u7a0b\u8cc7\u6599\u5f85\u78ba\u8a8d\uff09</option><option value="117">117 \u5b78\u5e74\u5ea6\uff08\u6d41\u7a0b\u8cc7\u6599\u5f85\u78ba\u8a8d\uff09</option></select></label>\n                <label for="eligibility-application-round"><span>\u7533\u8acb\u68af\u6b21</span><select id="eligibility-application-round" aria-describedby="application-period-hint" required><option value="">\u8acb\u9078\u64c7</option><option value="\u7b2c\u4e00\u68af\u6b21">\u7b2c\u4e00\u68af\u6b21\uff08\u6b64\u5e74\u5ea6\u6d41\u7a0b\u5f85\u78ba\u8a8d\uff09</option><option value="\u7b2c\u4e8c\u68af\u6b21">\u7b2c\u4e8c\u68af\u6b21\uff08\u6b64\u5e74\u5ea6\u6d41\u7a0b\u5f85\u78ba\u8a8d\uff09</option><option value="\u5176\u4ed6\uff0f\u5c1a\u672a\u516c\u544a">\u5176\u4ed6\uff0f\u5c1a\u672a\u516c\u544a</option></select></label>\n                <div class="application-period-help"><p id="application-period-hint" class="application-period-hint" aria-live="polite">\u5e74\u5ea6\u8207\u68af\u6b21\u9808\u8207\u6bcd\u6821\u516c\u544a\u4e00\u81f4\u3002</p><a id="application-period-source" target="_blank" rel="noopener noreferrer" hidden>\u6838\u5c0d\u6d41\u7a0b\u4f86\u6e90</a><button id="application-period-retry" type="button" class="text-action" hidden>\u91cd\u65b0\u8b80\u53d6\u5e74\u5ea6\u8207\u68af\u6b21</button></div>\n                <fieldset class="application-preference-fields"><legend>\u6e96\u5099\u5fd7\u9858\u5e8f\uff08\u6700\u591a\u4e94\u6240\uff1b\u6b63\u5f0f\u898f\u5b9a\u4f9d\u672c\u6821\u516c\u544a\uff09</legend><label for="eligibility-preference-1"><span>\u7b2c\u4e00\u5fd7\u9858</span><select id="eligibility-preference-1" required></select></label><label for="eligibility-preference-2"><span>\u7b2c\u4e8c\u5fd7\u9858</span><select id="eligibility-preference-2"></select></label><label for="eligibility-preference-3"><span>\u7b2c\u4e09\u5fd7\u9858</span><select id="eligibility-preference-3"></select></label><label for="eligibility-preference-4"><span>\u7b2c\u56db\u5fd7\u9858</span><select id="eligibility-preference-4"></select></label><label for="eligibility-preference-5"><span>\u7b2c\u4e94\u5fd7\u9858</span><select id="eligibility-preference-5"></select></label></fieldset>\n                <p class="application-plan-login-note"><i data-lucide="cloud" aria-hidden="true"></i><span>\u5efa\u7acb\u500b\u4eba\u6e05\u55ae\u6642\u624d\u9700\u8981\u767b\u5165\uff0c\u4e4b\u5f8c\u53ef\u5728\u4e0d\u540c\u88dd\u7f6e\u540c\u6b65\u5fd7\u9858\u8207\u5b8c\u6210\u72c0\u614b\u3002</span></p>\n                <button id="clear-saved-eligibility" type="button" class="secondary-button eligibility-clear" hidden><i data-lucide="rotate-ccw" aria-hidden="true"></i><span>\u6e05\u9664\u5e33\u865f\u7684\u9078\u6821\u8207\u8cc7\u683c\u689d\u4ef6</span></button>\n                </fieldset>\n                <label class="advisor-question-field"><span>\u60f3\u554f\u4ec0\u9ebc\uff1f</span><textarea id="advisor-question" name="question" maxlength="500" rows="3" placeholder="\u4f8b\u5982\uff1a\u7533\u8acb\u65e5\u672c\u4ea4\u63db\u9700\u8981\u54ea\u4e9b\u6587\u4ef6\uff1f"></textarea></label>\n                <div class="advisor-question-chips" aria-label="\u5e38\u898b\u554f\u984c">\n                  <button type="button" data-advisor-question="\u4ea4\u63db\u7533\u8acb\u9700\u8981\u6e96\u5099\u54ea\u4e9b\u6587\u4ef6\uff1f">\u5fc5\u8981\u6587\u4ef6</button>\n                  <button type="button" data-home-school-advisor-question data-advisor-question="\u9577\u5e9a\u5927\u5b78\u4ea4\u63db\u7533\u8acb\u7684\u8a9e\u8a00\u9580\u6abb\u662f\u4ec0\u9ebc\uff1f">\u8a9e\u8a00\u9580\u6abb</button>\n                  <button type="button" data-advisor-question="\u6709\u54ea\u4e9b\u51fa\u570b\u88dc\u52a9\u53ef\u4ee5\u7533\u8acb\uff1f">\u88dc\u52a9</button>\n                </div>\n                <button id="advisor-submit" type="submit" class="primary-button full-width"><i data-lucide="wand-sparkles" aria-hidden="true"></i><span>\u767b\u5165\u5f8c\u7522\u751f\u65b9\u6848</span></button>\n                <small class="advisor-source-note"><i data-lucide="shield-check" aria-hidden="true"></i>\u50c5\u4f9d\u5df2\u67e5\u6838\u4f86\u6e90\u4f5c\u7b54\uff1b\u7b26\u5408\u5ea6\u4e0d\u662f\u9304\u53d6\u6a5f\u7387\u3002\u672a\u767b\u5165\u53ef\u5148\u586b\u5beb\uff0c\u767b\u5165\u5f8c\u624d\u6703\u9001\u51fa\u4e26\u4fdd\u5b58\u500b\u4eba\u65b9\u6848\u3002</small>\n                <small id="advisor-index-status" class="advisor-source-note advisor-index-status" hidden></small>\n                <div id="ai-status-chip" class="ai-status-chip" hidden data-state="paused" role="status"></div>\n                <div id="ai-fallback-banner" class="ai-fallback-banner" hidden>\n                  <i data-lucide="info" aria-hidden="true"></i>\n                  <span>\u672c\u6a5f AI \u670d\u52d9\u96e2\u7dda\uff0c\u5df2\u5207\u63db\u81f3\u898f\u5247\u5f0f\u7d50\u679c\u3002\u641c\u5c0b\u3001\u6bd4\u8f03\u3001\u8cc7\u683c\u78ba\u8a8d\u7b49\u529f\u80fd\u4e0d\u53d7\u5f71\u97ff\u3002</span>\n                </div>\n                <span id="ai-status-live" class="sr-only" aria-live="polite" aria-atomic="true"></span>\n              </form>\n              <div id="advisor-result" class="advisor-result">\n                <section id="advisor-assistant" class="advisor-assistant" data-state="idle" aria-busy="false" aria-labelledby="advisor-assistant-title">\n                  <div class="advisor-mascot-stage" aria-hidden="true">\n                    <div class="advisor-mascot-frame">\n           