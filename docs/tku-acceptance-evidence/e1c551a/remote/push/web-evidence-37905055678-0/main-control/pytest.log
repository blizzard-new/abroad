      <span class="uw-mascot" data-play data-tilt>\n                        <span class="uw-mascot-shadow"></span>\n                        <span class="uw-mascot-body">\n                          <span class="uw-mascot-tilt">\n                            <span class="uw-mascot-slab"></span>\n                            <img class="uw-mascot-picture" src="/static/assets/mascot/suitcase.webp?v=20261007-solid-1" alt="" width="384" height="460" loading="lazy" decoding="async" draggable="false" />\n                            <span class="uw-mascot-sheen"></span>\n                            <span class="uw-mascot-eyes"><span class="uw-mascot-eye"></span><span class="uw-mascot-eye"></span></span>\n                          </span>\n                        </span>\n                      </span>\n                      <span class="advisor-mascot-scan"></span>\n                      <span class="advisor-mascot-paper one"></span>\n                      <span class="advisor-mascot-paper two"></span>\n                      <span class="advisor-mascot-confetti"></span>\n                      <span class="advisor-mascot-alert"></span>\n                    </div>\n                  </div>\n                  <div class="advisor-assistant-copy" role="status" aria-live="polite" aria-atomic="true">\n                    <span class="advisor-assistant-eyebrow">\u7559\u5b78\u5c0f\u52a9\u624b</span>\n                    <h3 id="advisor-assistant-title">\u5efa\u7acb\u7b2c\u4e00\u4efd\u7533\u8acb\u65b9\u6848</h3>\n                    <p id="advisor-assistant-detail">\u586b\u5beb\u689d\u4ef6\u5f8c\uff0c\u6211\u6703\u6574\u7406\u5019\u9078\u5b78\u6821\u3001\u689d\u4ef6\u7f3a\u53e3\u8207\u4e0b\u4e00\u6b65\u3002</p>\n                  </div>\n                </section>\n                <div id="advisor-result-content"></div>\n              </div>\n            </div>\n          </section>\n\n          <section id="partners" class="page-section" data-university-page="partners" aria-labelledby="partners-title" hidden>\n            <h2 id="partners-title" class="visually-hidden">\u5b78\u6821\u641c\u5c0b</h2>\n            <div class="partner-view-toolbar">\n              <label class="search-field" for="partner-search"><span>\u641c\u5c0b\u5b78\u6821</span><span class="control-with-icon"><i data-lucide="search" aria-hidden="true"></i><input id="partner-search" placeholder="\u5b78\u6821\u3001\u570b\u5bb6\u6216\u7533\u8acb\u689d\u4ef6" /></span></label>\n\n              <div class="partner-view-switch" role="group" aria-label="\u5408\u4f5c\u5b78\u6821\u6aa2\u8996\u65b9\u5f0f">\n                <button type="button" data-partner-view="list" aria-pressed="true" aria-controls="partner-table"><i data-lucide="list" aria-hidden="true"></i>\u5217\u8868</button>\n                <button type="button" data-partner-view="map" aria-pressed="false" aria-controls="partner-map-panel"><i data-lucide="globe-2" aria-hidden="true"></i>3D \u5730\u5716</button>\n              </div>\n            </div>\n            <div class="journey-search-layout">\n            <div class="journey-search-results">\n            <div class="discovery-search-tools">\n              <details id="discovery-criteria" class="discovery-criteria"><summary><i data-lucide="sliders-horizontal" aria-hidden="true"></i>\u6211\u7684\u689d\u4ef6 <span id="discovery-criteria-count"></span></summary>\n                <form id="discovery-criteria-form">\n                  <label>\u8a9e\u8a00\u6aa2\u5b9a<select id="discovery-test" name="test"><option value="">\u66ab\u4e0d\u7be9\u9078</option><option value="ielts">IELTS</option><option value="toefl">TOEFL iBT</option><option value="toeic">TOEIC</option><option value="jlpt">\u65e5\u6aa2 JLPT</option><option value="topik">\u97d3\u6aa2 TOPIK</option><option value="duolingo">Duolingo</option></select></label>\n                  <label>\u6aa2\u5b9a\u6210\u7e3e<input id="discovery-score" name="score" type="number" min="0" max="990" step="0.5" placeholder="\u6210\u7e3e"></la