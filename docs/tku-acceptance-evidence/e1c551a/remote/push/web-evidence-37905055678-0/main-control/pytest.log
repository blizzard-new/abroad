pe="button" class="secondary-button">\u5148\u770b\u770b\u5168\u90e8\u4ea4\u63db\u5b78\u6821</button>\n          <button id="confirm-school" type="button" class="primary-button">\n            <span>\u9078\u64c7\u6211\u7684\u5b78\u6821</span><i data-lucide="arrow-right" aria-hidden="true"></i>\n          </button>\n        </div>\n        <small class="privacy-note"><i data-lucide="shield-check" aria-hidden="true"></i>\u700f\u89bd\u516c\u958b\u8cc7\u6599\u4e0d\u9700\u8981\u767b\u5165\uff1b\u6536\u85cf\u3001\u9032\u5ea6\u8207\u793e\u7fa4\u529f\u80fd\u624d\u9700\u8981\u5e33\u865f\u3002</small>\n      </div>\n    </section>\n\n    <section id="auth-dialog" class="account-dialog" role="dialog" aria-modal="true" aria-labelledby="auth-title" hidden>\n      <button type="button" class="dialog-backdrop" data-close-auth aria-label="\u95dc\u9589\u767b\u5165\u8996\u7a97"></button>\n      <div class="account-dialog-shell">\n        <button type="button" class="icon-button dialog-close" data-close-auth aria-label="\u95dc\u9589"><i data-lucide="x" aria-hidden="true"></i></button>\n        <div class="account-dialog-intro">\n          <span class="platform-mark" aria-hidden="true"><img src="/static/assets/brand/uniway-mark.webp?v=20261004-logo-2" alt="" width="48" height="48" decoding="async" /></span>\n          <div><span class="eyebrow">UniWay \u5e33\u865f</span><h1 id="auth-title">\u628a\u7533\u8acb\u9032\u5ea6\u5e36\u8457\u8d70</h1><p>\u767b\u5165\u4ee5\u4fdd\u5b58\u6536\u85cf\u8207\u7533\u8acb\u9032\u5ea6\u3002</p></div>\n        </div>\n        <details class="discovery-recents" data-discovery-recents hidden></details>\n        <div class="auth-mode-switch" role="tablist" aria-label="\u767b\u5165\u6216\u5efa\u7acb\u5e33\u865f">\n          <button type="button" role="tab" aria-selected="true" data-auth-mode="login">\u767b\u5165</button>\n          <button type="button" role="tab" aria-selected="false" data-auth-mode="register">\u5efa\u7acb\u5e33\u865f</button>\n        </div>\