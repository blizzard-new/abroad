   <label class="private-vault-consent"><input name="consent" type="checkbox" required /><span><strong>\u6211\u540c\u610f\u53ea\u70ba\u672c\u6b21\u9078\u64c7\u7684\u76ee\u7684\u52a0\u5bc6\u4fdd\u5b58\u9019\u500b\u6a94\u6848</strong><small>\u767b\u5165\u4e0d\u4ee3\u8868\u540c\u610f\u4e0a\u50b3\uff1b\u672c\u540c\u610f\u4e0d\u5305\u542b\u516c\u958b\u5206\u4eab\u3001\u793e\u7fa4\u9023\u7d50\u6216 AI \u8a13\u7df4\u3002\u5230\u671f\u6216\u624b\u52d5\u522a\u9664\u5f8c\u6703\u6c38\u4e45\u79fb\u9664\u3002</small></span></label>\n                  <div class="private-vault-form-actions"><span id="private-vault-form-status" class="form-status" role="status" aria-live="polite"></span><button type="submit" class="primary-button"><i data-lucide="lock-keyhole" aria-hidden="true"></i><span>\u540c\u610f\u4e26\u52a0\u5bc6\u4fdd\u5b58</span></button></div>\n                </form>\n                <div id="private-vault-list" class="private-vault-list" aria-live="polite"></div>\n              </div>\n              <footer class="private-vault-privacy"><i data-lucide="info" aria-hidden="true"></i><span>\u6a94\u540d\u3001\u6587\u4ef6\u540d\u7a31\u8207\u5167\u5bb9\u90fd\u6703\u52a0\u5bc6\uff1b\u4e0b\u8f09\u4f7f\u7528\u77ed\u6548\u6388\u6b0a\uff0c\u6388\u6b0a\u4e0d\u6703\u653e\u5728\u7db2\u5740\u4e2d\u3002\u6b64\u5340\u5167\u5bb9\u4e0d\u80fd\u88ab\u516c\u958b\u8a0e\u8ad6\u677f\u5f15\u7528\u3002</span></footer>\n            </section>\n            <section class="document-workspace" aria-labelledby="document-workspace-title"><div class="workspace-heading"><span><i data-lucide="folder-check" aria-hidden="true"></i><strong id="document-workspace-title">\u6211\u7684\u9001\u4ef6\u8cc7\u6599</strong></span><small id="document-workspace-progress"></small></div><div id="document-workspace-list"></div></section>\n            <div id="document-filters" class="chip-group" aria-label="\u6587\u4ef6\u5206\u985e\u7be9\u9078"></div>\n            <div id="documents-list" class="document-grid" aria-busy="t