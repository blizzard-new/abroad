-button-label">\u767b\u5165</span></button>\n          </div>\n    </aside>\n    <button id="glass-menu-backdrop" class="glass-menu-backdrop" type="button" aria-label="\u95dc\u9589\u529f\u80fd\u9078\u55ae" hidden></button>\n\n    <section id="school-onboarding" class="school-onboarding" role="dialog" aria-modal="true" aria-labelledby="onboarding-title" hidden>\n      <div class="onboarding-backdrop"></div>\n      <div class="onboarding-shell">\n        <div class="onboarding-heading">\n          <span class="platform-mark" aria-hidden="true"><img src="/static/assets/brand/uniway-mark.webp?v=20261004-logo-2" alt="" width="48" height="48" decoding="async" /></span>\n          <div>\n            <span class="eyebrow">UniWay</span>\n            <h1 id="onboarding-title">\u4f60\u76ee\u524d\u5c31\u8b80\u54ea\u4e00\u6240\u53f0\u7063\u5927\u5b78\uff1f</h1>\n            <p>\u9078\u64c7\u5f8c\uff0c\u6211\u5011\u6703\u986f\u793a\u4f60\u771f\u6b63\u80fd\u7533\u8acb\u7684\u5b78\u6821\u3001\u8cc7\u683c\u8207\u7533\u8acb\u6642\u7a0b\uff1b\u4e5f\u53ef\u4ee5\u5148\u7565\u904e\u76f4\u63a5\u700f\u89bd\u3002</p>\n            <p id="onboarding-lock-note" hidden><strong>\u8acb\u9078\u4f60\u5be6\u969b\u5c31\u8b80\u7684\u5b78\u6821\uff1a</strong>\u5b78\u6821\u6703\u986f\u793a\u5728\u4f60\u7684\u5e33\u865f\u8207\u8cbc\u6587\u4e0a\uff0c\u9078\u5b9a\u5f8c 3 \u5929\u5167\u4e0d\u80fd\u66f4\u63db\u3002</p>\n          </div>\n        </div>\n\n        <label class="school-search-field" for="school-search">\n          <span>\u641c\u5c0b\u53f0\u7063\u7684\u5927\u5b78</span>\n          <span class="control-with-icon">\n            <i data-lucide="search" aria-hidden="true"></i>\n            <input id="school-search" autocomplete="off" placeholder="\u8f38\u5165\u5b78\u6821\u540d\u7a31\uff0c\u4f8b\u5982\uff1a\u9577\u5e9a\u3001\u81fa\u5317\u5927\u5b78\u3001\u81fa\u5927" />\n          </span>\n        </label>\n\n        <div id="school-options" class="school-options" role="listbox" aria-label="\u53ef\u