n\n        <div id="school-options" class="school-options" role="listbox" aria-label="\u53ef\u9078\u64c7\u7684\u5927\u5b78">\n          <button type="button" class="school-option selected" data-home-school="\u9577\u5e9a\u5927\u5b78" role="option" aria-selected="true">\n            <img src="/static/assets/cgu-campus.jpg" alt="\u9577\u5e9a\u5927\u5b78\u6821\u5712" />\n            <span><strong>\u9577\u5e9a\u5927\u5b78</strong><small>\u5b8c\u6574\u652f\u63f4\u8a66\u9ede \xb7 75 \u6240\u5408\u4f5c\u6821</small></span>\n            <i data-lucide="circle-check" aria-hidden="true"></i>\n          </button>\n          <button type="button" class="school-option" data-home-school="\u570b\u7acb\u81fa\u5317\u5927\u5b78" role="option" aria-selected="false">\n            <img src="/static/assets/ntpu-campus.jpg" alt="\u570b\u7acb\u81fa\u5317\u5927\u5b78\u6821\u5712" />\n            <span><strong>\u570b\u7acb\u81fa\u5317\u5927\u5b78</strong><small>169 \u6240\u672c\u671f\u958b\u653e \xb7 37 \u6240\u4ea4\u63db\u5408\u4f5c\u6821\u5099\u67e5</small></span>\n            <i data-lucide="circle" aria-hidden="true"></i>\n          </button>\n          <button type="button" class="school-option" data-home-school="\u570b\u7acb\u81fa\u7063\u5927\u5b78" role="option" aria-selected="false">\n            <img src="/static/assets/ntu-campus.svg" alt="\u570b\u7acb\u81fa\u7063\u5927\u5b78\u8b58\u5225\u5716" />\n            <span><strong>\u570b\u7acb\u81fa\u7063\u5927\u5b78</strong><small>288\u9805\u5408\u4f5c\u8cc7\u6599 \xb7 282\u9805\u540d\u984d\u5f85\u516c\u5e03 \xb7 6\u9805\u96f6\u540d\u984d</small></span>\n            <i data-lucide="circle" aria-hidden="true"></i>\n          </button>\n        </div>\n        <p id="school-search-empty" class="school-search-empty" hidden>\u672a\u627e\u5230\u9019\u6240\u5b78\u6821\uff1b\u76ee\u524d\u652f\u63f4\u7684\u5b78\u6821\u8acb\u67e5\u770b\u9078\u55ae\uff0c\u5176\u4ed6\u53f0\u7063\u5927\u5b78\u6703\u4f9d\u8cc7\u6599\u67e5\u6838\u9032\u5ea6\u52a0\u5165