iv>\n            <button id="theme-toggle" type="button" class="icon-button" aria-label="\u5207\u63db\u70ba\u6dfa\u8272\u6a21\u5f0f" data-tooltip="\u6dfa\u8272\u6a21\u5f0f"><i data-lucide="sun" aria-hidden="true"></i></button>\n            <button id="refresh-button" type="button" class="icon-button" aria-label="\u91cd\u65b0\u6574\u7406\u6700\u65b0\u8cc7\u6599" data-tooltip="\u91cd\u65b0\u6574\u7406"><i data-lucide="refresh-cw" aria-hidden="true"></i></button>\n            <button id="notification-button" type="button" class="icon-button notification-button" aria-label="\u958b\u555f\u901a\u77e5\u4e2d\u5fc3" aria-haspopup="dialog" data-tooltip="\u901a\u77e5" hidden><i data-lucide="bell" aria-hidden="true"></i><span id="notification-badge" class="notification-badge" hidden>0</span></button>\n            <div id="account-workspace-sync-control" class="workspace-sync-control" hidden>\n              <div id="account-workspace-sync-status" class="workspace-sync-status" data-sync-state="syncing" role="status" aria-live="polite" aria-atomic="true" aria-busy="true">\n                <span class="workspace-sync-status-icon" aria-hidden="true"><i data-lucide="loader-circle"></i></span>\n                <span id="account-workspace-sync-label" class="workspace-sync-status-label">\u6b63\u5728\u540c\u6b65</span>\n                <span id="account-workspace-sync-message" class="visually-hidden">\u6b63\u5728\u540c\u6b65\u6536\u85cf\u8207\u7533\u8acb\u9032\u5ea6\u3002</span>\n              </div>\n              <button id="account-workspace-sync-retry" type="button" class="secondary-button workspace-sync-retry" aria-describedby="account-workspace-sync-message" hidden><i data-lucide="refresh-cw" aria-hidden="true"></i><span>\u91cd\u8a66</span></button>\n            </div>\n            <button id="account-button" type="button" class="account-button" aria-label="\u767b\u5165\u6216\u5efa\u7acb\u5e33\u865f"><span class="account-button-avatar"><i data-lucide="user-round" aria-hidden="true"