ive="polite"></div>\n\n        <div id="dashboard-view">\n          <section id="guide" class="page-section study-guide" data-university-page="guide" aria-labelledby="guide-title" hidden>\n            <header class="guide-intro">\n              <div><span class="section-kicker">\u7533\u8acb\u6307\u5357</span><h1 id="guide-title">\u4f60\u7684\u4ea4\u63db\u65c5\u7a0b\uff0c<br>\u4e00\u6b65\u4e00\u6b65\u4f86\u3002</h1><p>\u5f9e\u9078\u6821\u5230\u51fa\u767c\uff0c\u627e\u5230\u4f60\u73fe\u5728\u9700\u8981\u7684\u4e0b\u4e00\u6b65\u3002</p></div>\n              <span class="uw-mascot guide-mascot" data-play data-tilt aria-hidden="true">\n                <span class="uw-mascot-shadow"></span>\n                <span class="uw-mascot-body">\n                  <span class="uw-mascot-tilt">\n                    <span class="uw-mascot-slab"></span>\n                    <img class="uw-mascot-picture" src="/static/assets/mascot/suitcase.webp?v=20261007-solid-1" alt="" width="384" height="460" decoding="async" draggable="false" />\n                    <span class="uw-mascot-sheen"></span>\n                    <span class="uw-mascot-eyes"><span class="uw-mascot-eye"></span><span class="uw-mascot-eye"></span></span>\n                  </span>\n                </span>\n              </span>\n            </header>\n            <ol class="guide-stages">\n              <li class="guide-stage guide-stage-explore"><span class="guide-stage-number">01</span><span class="guide-stage-icon"><i data-lucide="compass" aria-hidden="true"></i></span><h2>\u627e\u5230\u60f3\u53bb\u7684\u5b78\u6821</h2><p>\u6bd4\u8f03\u8ab2\u7a0b\u3001\u8a9e\u8a00\u9580\u6abb\u8207\u751f\u6d3b\u8cbb\u3002</p><a class="guide-action" href="#partners">\u63a2\u7d22\u5b78\u6821<i data-lucide="arrow-up-right" aria-hidden="true"></i></a></li>\n              <li class="guide-stage guide-stage-prepare"><span class="guide-stage-number">02</span><span class="guide-stage-icon"><i data-lucide="notebook-pen" aria-hidden="true"></i></span><h2>\u6e96\u5099\u6821\u5167\u7504\u9078</h2><p>\u78ba\u8a8d\u8cc7\u683c\u3001\u6392\u5fd7\u9858\uff0c\u518d\u6e96\u5099\u6587\u4ef6\u3002</p><a class="guide-action" href="#eligibility" data-requires-home-school>\u67e5\u770b\u8cc7\u683c\u8207\u5fd7\u9858<i data-lucide="arrow-up-right" aria-hidden="true"></i></a></li>\n              <li class="guide-stage guide-stage-apply"><span class="guide-stage-number">03</span><span class="guide-stage-icon"><i data-lucide="send" aria-hidden="true"></i></span><h2>\u5b8c\u6210\u5408\u4f5c\u6821\u7533\u8acb</h2><p>\u901a\u904e\u6821\u5167\u63d0\u540d\u5f8c\uff0c\u4f9d\u5408\u4f5c\u6821\u901a\u77e5\u9001\u4ef6\u3002</p><a class="guide-action" href="#application-center" data-requires-home-school>\u6e96\u5099\u7533\u8acb\u6587\u4ef6<i data-lucide="arrow-up-right" aria-hidden="true"></i></a></li>\n              <li class="guide-stage guide-stage-depart"><span class="guide-stage-number">04</span><span class="guide-stage-icon"><i data-lucide="luggage" aria-hidden="true"></i></span><h2>\u5b89\u6392\u51fa\u767c\u8207\u751f\u6d3b</h2><p>\u9304\u53d6\u5f8c\u78ba\u8a8d\u7c3d\u8b49\u3001\u4f4f\u5bbf\u8207\u4fdd\u96aa\u3002</p><a class="guide-action" href="#budget" data-requires-home-school>\u4f30\u7b97\u751f\u6d3b\u9810\u7b97<i data-lucide="arrow-up-right" aria-hidden="true"></i></a></li>\n            </ol>\n            <div class="guide-bottom-row">\n              <a class="guide-plan-link" href="#overview" data-requires-home-school><span class="guide-plan-icon"><i data-lucide="route" aria-hidden="true"></i></span><span><strong>\u5df2\u7d93\u958b\u59cb\u6e96\u5099\u4e86\uff1f</strong><small>\u56de\u5230\u6211\u7684\u4ea4\u63db\u8a08\u756b</small></span><i data-lucide="arrow-right" aria-hidden="true"></i></a>\n              <details class="guide-faq"><summary>\u6821\u5167\u7504\u9078\u548c\u5408\u4f5c\u6821\u7533\u8acb\u6709\u4ec0\u9ebc\u4e0d\u540c\uff1f<i data-lucide="plus" aria-hidden="true"></i></summary><p>\u4e00\u822c\u5148\u7531\u5c31\u8b80\u5b78\u6821\u7504\u9078\u8207\u63d0\u540d\uff0c\u518d\u5411\u5408\u4f5c\u6821\u7533\u8acb\u3002\u5169\u908a\u7684\u6587\u4ef6\u8207\u671f\u9650\u53ef\u80fd\u4e0d\u540c\uff0c\u8acb\u5206\u5225\u78ba\u8a8d\u7576\u671f\u516c\u544a\u3002</p><a href="#deadlines" data-requires-home-school>\u67e5\u770b\u5b98\u65b9\u622a\u6b62\u65e5<i data-lucide="arrow-right" aria-hidden="true"></i></a></details>\n            </div>\n          </section>\n          <section id="feedback" class="page-section feedback-page" data-university-page="feedback" aria-labelledby="feedback-title" hidden>\n            <header class="feedback-intro">\n              <div>\n                <span class="section-kicker">\u7528\u6236\u8a55\u50f9</span>\n                <h1 id="feedback-title">\u8aaa\u8aaa\u4f60\u7684\u60f3\u6cd5</h1>\n                <p>UniWay \u9084\u5728\u9577\u5927\u3002\u54ea\u88e1\u597d\u7528\u3001\u54ea\u88e1\u5361\u4f4f\u3001\u60f3\u8981\u4ec0\u9ebc\u65b0\u529f\u80fd\uff0c\u90fd\u53ef\u4ee5\u5beb\u5728\u9019\u88e1\uff0c\u6211\u5011\u6703\u4e00\u5247\u4e00\u5247\u770b\u3002</p>\n                <p class="feedback-invite" id="feedback-invite"><strong>\u6210\u529f\u7533\u8acb\u904e\u4ea4\u63db\u55ce\uff1f</strong>\u5c24\u5176\u662f\u9032\u4fee\u90e8\u3001\u78a9\u58eb\u5728\u8077\u5c08\u73ed\uff0c\u6216\u6771\u6b50\u9019\u985e\u6bd4\u8f03\u5c11\u4eba\u5206\u4eab\u7684\u5730\u5340\uff0c\u6b61\u8fce\u5beb\u4e0b\u54ea\u4e00\u5e74\u3001\u54ea\u6240\u5b78\u6821\u3001\u600e\u9ebc\u7533\u8acb\u3002\u82e5\u4f60\u7559\u4e0b\u806f\u7d61\u65b9\u5f0f\uff0c\u6211\u5011\u6703\u5148\u554f\u904e\u4f60\u540c\u610f\uff0c\u624d\u6703\u6574\u7406\u6210\u4e0d\u5177\u540d\u7684\u7d93\u9a57\u653e\u9032\u7db2\u7ad9\u3002</p>\n              </div>\n              <span class="uw-mascot feedback-mascot" data-play data-tilt aria-hidden="true">\n                <span class="uw-mascot-shadow"></span>\n                <span class="uw-mascot-body">\n                  <span class="uw-mascot-tilt">\n                    <span class="uw-mascot-slab"></span>\n                    <img class="uw-mascot-picture" src="/static/assets/mascot/suitcase.webp?v=20261007-solid-1" alt="" width="384" height="460" loading="lazy" decoding="async" draggable="false" />\n                    <span class="uw-mascot-sheen"></span>\n                    <span class="uw-mascot-eyes"><span class="uw-mascot-eye"></span><span class="uw-mascot-eye"></span></span>\n                  </span>\n                </span>\n              </span>\n            </header>\n            <form id="feedback-form" class="feedback-form glass-panel" novalidate>\n              <fieldset class="feedback-kinds">\n                <legend>\u4f60\u60f3\u8aaa\u7684\u662f</legend>\n                <label><input type="radio" name="kind" value="suggestion" checked /><span>\u5efa\u8b70</span></label>\n                <label><input type="radio" name="kind" value="bug" /><span>\u554f\u984c\u56de\u5831</span></label>\n                <label><input type="radio" name="kind" value="praise" /><span>\u7a31\u8b9a</span></label>\n                <label><input type="radio" name="kind" value="other" /><span>\u5176\u4ed6</span></label>\n              </fieldset>\n              <fieldset class="feedback-rating">\n                <legend>\u6574\u9ad4\u611f\u89ba\uff08\u9078\u586b\uff09</legend>\n                <div class="feedback-stars" role="radiogroup" aria-label="\u6574\u9ad4\u8a55\u5206">\n                  <input id="feedback-star-5" type="radio" name="rating" value="5" /><label for="feedback-star-5" aria-label="5 \u9846\u661f">\u2605</label>\n                  <input id="feedback-star-4" type="radio" name="rating" value="4" /><label for="feedback-star-4" aria-label="4 \u9846\u661f">\u2605</label>\n                  <input id="feedback-star-3" type="radio" name="rating" value="3" /><label for="feedback-star-3" aria-label="3 \u9846\u661f">\u2605</label>\n                  <input id="feedback-star-2" type="radio" name="rating" value="2" /><label for="feedback-star-2" aria-label="2 \u9846\u661f">\u2605</label>\n                  <input id="feedback-star-1" type="radio" name="rating" value="1" /><label for="feedback-star-1" aria-label="1 \u9846\u661f">\u2605</label>\n                </div>\n                <button id="feedback-clear-rating" type="button" class="text-action" hidden>\u6e05\u9664\u8a55\u5206</button>\n              </fieldset>\n              <label class="feedback-field">\n                <span>\u5167\u5bb9</span>\n                <textarea id="feedback-message" name="message" rows="6" minlength="5" maxlength="2000" required placeholder="\u4f8b\u5982\uff1a\u5e0c\u671b\u5b78\u6821\u641c\u5c0b\u53ef\u4ee5\u76f4\u63a5\u6bd4\u8f03\u5b78\u8cbb\uff1b\u6216\u662f\u67d0\u500b\u9801\u9762\u5728\u624b\u6a5f\u4e0a\u770b\u4e0d\u6e05\u695a\u3002"></textarea>\n                <small id="feedback-count" aria-live="off">0 / 2000</small>\n              </label>\n              <label class="feedback-field">\n                <span>\u806f\u7d61\u65b9\u5f0f\uff08\u9078\u586b\uff09</span>\n                <input name="contact" type="text" maxlength="120" autocomplete="off" placeholder="\u96fb\u5b50\u90f5\u4ef6\u6216 LINE ID" />\n                <small class="feedback-hint">\u53ea\u6709\u9700\u8981\u56de\u8986\u4f60\u7684\u6642\u5019\u624d\u6703\u7528\u5230\uff1b\u4e0d\u60f3\u88ab\u806f\u7d61\u5c31\u7559\u7a7a\u3002</small>\n              </label>\n              <div class="feedback-trap" aria-hidden="true"><label>\u7db2\u7ad9<input name="website" type="text" tabindex="-1" autocomplete="off" /></label></div>\n              <p class="feedback-note"><i data-lucide="shield-check" aria-hidden="true"></i><span>\u8acb\u4e0d\u8981\u586b\u5beb\u5bc6\u78bc\u3001\u8eab\u5206\u8b49\u5b57\u865f\u3001\u5b78\u865f\u7b49\u500b\u4eba\u8cc7\u6599\u3002\u4f60\u7684\u7559\u8a00\u53ea\u6709\u7db2\u7ad9\u7ba1\u7406\u54e1\u770b\u5f97\u5230\u3002\u8a73\u898b<a href="/privacy">\u96b1\u79c1\u6b0a\u653f\u7b56</a>\u3002</span></p>\n              <div id="feedback-status" class="form-status feedback-status" role="status" aria-live="polite"></div>\n              <button id="feedback-submit" type="submit" class="primary-button"><i data-lucide="send" aria-hidden="true"></i><span>\u9001\u51fa</span></button>\n            </form>\n            <section id="feedback-thanks" class="feedback-thanks glass-panel" aria-live="polite" hidden>\n              <h2>\u8b1d\u8b1d\u4f60\uff01\u6211\u5011\u6536\u5230\u4e86</h2>\n              <p>\u4f60\u7684\u60f3\u6cd5\u6703\u5e6b\u52a9 UniWay \u8b8a\u5f97\u66f4\u597d\u3002</p>\n              <button id="feedback-again" type="button" class="secondary-button">\u518d\u5beb\u4e00\u5247</button>\n            </section>\n          </section>\n          <section id="overview" class="overview-section visual-overview" data-university-page="overview" aria-labelledby="personal-plan-title">\n            <section class="personal-plan-board glass-panel" aria-labelledby="personal-plan-title">\n              <div class="concise-heading">\n                <div><h2 id="personal-plan-title">\u6211\u7684\u4ea4\u63db\u8a08\u756b</h2></div>\n                <a href="#advisor"><span>\u8abf\u6574\u6211\u7684\u689d\u4ef6</span><i data-lucide="sliders-horizontal" aria-hidden="true"></i></a>\n              </div>\n              <div id="planning-next-action" class="planning-next-action" aria-live="polite"></div>\n              <div id="personal-plan-snapshot" class="personal-plan-snapshot"><div class="skeleton skeleton-card"></div></div>\n            </section>\n\n            <section class="recommended-match-section" aria-labelledby="recommended-match-title">\n              <div class="concise-heading"><div><span class="section-kicker">\u689d\u4ef6\u914d\u5c0d</span><h2 id="recommended-match-title">\u9078\u51fa\u4f60\u7684\u4e0b\u4e00\u7ad9</h2></div><a href="#advisor">\u67e5\u770b\u63a8\u85a6\u8207\u8abf\u6574\u689d\u4ef6</a></div>\n              <div id="recommended-match-list" class="recommended-match-list"><div class="skeleton skeleton-card"></div></div>\n            </section>\n\n            <section id="multi-plan-workspace" class="journey-workspace glass-panel" aria-labelledby="multi-plan-title" hidden>\n              <header class="concise-heading"><div><span class="section-kicker">\u4e00\u4efd\u6e05\u55ae\uff0c\u7167\u9867\u6240\u6709\u5fd7\u9858</span><h2 id="multi-plan-title">\u6211\u7684\u5fd7\u9858\u8207\u5171\u7528\u6e96\u5099</h2></div><a href="#favorites">\u9078\u6821\u6bd4\u8f03</a></header>\n              <details id="multi-plan-settings"><summary>\u8a2d\u5b9a\u8207\u8abf\u6574\u5fd7\u9858\u9806\u5e8f</summary>\n                <form id="multi-plan-preferences" class="multi-plan-preferences">\n                  <label>\u7b2c\u4e00\u5fd7\u9858<select name="preference_1"></select></label>\n                  <label>\u7b2c\u4e8c\u5fd7\u9858<select name="preference_2"></select></label>\n                  <label>\u7b2c\u4e09\u5fd7\u9858<select name="preference_3"></select></label>\n                  <label>\u7b2c\u56db\u5fd7\u9858<select name="preference_4"></select></label>\n                  <label>\u7b2c\u4e94\u5fd7\u9858<select name="preference_5"></select></label>\n                  <button type="submit" class="secondary-button">\u4fdd\u5b58\u5fd7\u9858\u9806\u5e8f</button>\n                </form>\n                <p>\u9019\u662f\u500b\u4eba\u6e96\u5099\u9806\u5e8f\uff1b\u6b63\u5f0f\u5fd7\u9858\u6578\u3001\u8a9e\u7d44\u8207\u5206\u767c\u898f\u5b9a\u4ecd\u4ee5\u672c\u6821\u7576\u671f\u516c\u544a\u70ba\u6e96\u3002\u8abf\u6574\u9806\u5e8f\u6703\u4fdd\u7559\u65e2\u6709\u9032\u5ea6\uff1b\u6587\u4ef6\u8207\u6642\u7a0b\u76ee\u6a19\u53ef\u5728\u5404\u6821\u6e05\u55ae\u4e2d\u9078\u64c7\u3002</p>\n              </details>\n              <p id="multi-plan-status" role="status" aria-live="polite"></p>\n              <div id="multi-plan-tasks"></div>\n            </section>\n            <section id="planning-workspace" class="planning-workspace glass-panel" aria-labelledby="planning-title">\n              <div class="concise-heading"><div><span class="section-kicker">\u9078\u6821\u4e4b\u5f8c\uff0c\u63a5\u8457\u6e96\u5099</span><h2 id="planning-title">\u5b89\u6392\u6211\u7684\u6e96\u5099\u6642\u7a0b</h2></div><a href="#calendar">\u67e5\u770b\u5b8c\u6574\u65e5\u66c6</a></div>\n              <div id="planning-target-summary" class="planning-target-summary"></div>\n              <form id="planning-schedule-form" class="planning-schedule-form">\n                <label for="planning-academic-year"><span>\u7533\u8acb\u5b78\u5e74\u5ea6</span><input id="planning-academic-year" name="academic_year" maxlength="10" placeholder="\u4f8b\u5982\uff1a116" list="planning-year-options" aria-describedby="planning-period-hint" required /><datalist id="planning-year-options"></datalist></label>\n                <label for="planning-application-round"><span>\u7533\u8acb\u68af\u6b21\uff08\u9078\u586b\uff09</span><input id="planning-application-round" name="application_round" maxlength="80" placeholder="\u4f9d\u5b98\u65b9\u516c\u544a\u586b\u5beb" list="planning-round-options" aria-describedby="planning-period-hint" /><datalist id="planning-round-options"></datalist></label>\n                <label for="planning-preparation-days"><span>\u6bcf\u9805\u4efb\u52d9\u9810\u7559\u5e7e\u5929\uff1f</span><span class="planning-days-control"><input id="planning-preparation-days" name="preparation_days" type="number" min="1" max="90" value="14" required /><span>\u5929</span></span></label>\n                <div><p>\u9019\u662f\u4f60\u53ef\u8abf\u6574\u7684\u6e96\u5099\u5929\u6578\uff1b\u7cfb\u7d71\u4f9d\u5df2\u78ba\u8a8d\u7684\u5b98\u65b9\u622a\u6b62\u65e5\u5f80\u524d\u5b89\u6392\uff0c\u4f7f\u7528\u65e5\u66c6\u5929\u8a08\u7b97\u3002</p><button id="planning-preview-button" type="submit" class="secondary-button"><i data-lucide="calendar-range" aria-hidden="true"></i><span>\u9810\u89bd\u6e96\u5099\u6642\u7a0b</span></button></div>\n              </form>\n              <p id="planning-period-hint" class="application-period-hint"></p>\n              <div id="planning-schedule-status" class="planning-schedule-status" role="status" aria-live="polite"></div>\n              <div id="planning-schedule-recovery" class="planning-recovery" hidden></div>\n              <div id="planning-schedule-preview" class="planning-schedule-preview"></div>\n              <button id="planning-update-durations" type="button" class="secondary-button" hidden>\u66f4\u65b0\u5404\u9805\u6e96\u5099\u5929\u6578\u4e26\u91cd\u65b0\u9810\u89bd</button>\n              <button id="planning-confirm" type="button" class="primary-button" hidden><i data-lucide="calendar-plus" aria-hidden="true"></i><span>\u78ba\u8a8d\u52a0\u5165\u6211\u7684\u6642\u7a0b</span></button>\n            </section>\n            <section id="journey-workspace" class="journey-workspace glass-panel" aria-labelledby="journey-workspace-title" hidden>\n              <header class="concise-heading"><div><span class="section-kicker">\u8b93\u6e96\u5099\u7b26\u5408\u4f60\u7684\u751f\u6d3b</span><h2 id="journey-workspace-title">\u6211\u7684\u6e96\u5099\u5de5\u4f5c\u53f0</h2></div><a href="#calendar">\u5b8c\u6574\u65e5\u66c6<i data-lucide="arrow-right" aria-hidden="true"></i></a></header>\n              <div id="journey-today" class="journey-today" aria-live="polite"></div>\n              <details id="journey-capacity-settings" class="journey-settings">\n                <summary>\u8a2d\u5b9a\u53ef\u6295\u5165\u6642\u9593\u8207\u91cd\u65b0\u5b89\u6392<i data-lucide="sliders-horizontal" aria-hidden="true"></i></summary>\n                <form id="journey-availability-form">\n                  <label><span>\u6bcf\u9031\u80fd\u6295\u5165\u5e7e\u5c0f\u6642\uff1f</span><input name="weekly_hours" type="number" min="0.5" max="60" step="0.5" value="6" required /></label>\n                  <fieldset><legend>\u53ef\u4ee5\u6e96\u5099\u7684\u661f\u671f</legend><div class="journey-weekdays">\n                    <label><input type="checkbox" name="weekdays" value="1" checked />\u4e00</label><label><input type="checkbox" name="weekdays" value="2" />\u4e8c</label><label><input type="checkbox" name="weekdays" value="3" checked />\u4e09</label><label><input type="checkbox" name="weekdays" value="4" />\u56db</label><label><input type="checkbox" name="weekdays" value="5" />\u4e94</label><label><input type="checkbox" name="weekdays" value="6" checked />\u516d</label><label><input type="checkbox" name="weekdays" value="7" />\u65e5</label>\n                  </div></fieldset>\n                  <label><span>\u9810\u89bd\u672a\u4f86\u5e7e\u5929\uff1f</span><input name="horizon_days" type="number" min="1" max="365" value="180" required /></label>\n                  <button class="primary-button" type="submit"><i data-lucide="calendar-cog" aria-hidden="true"></i><span>\u4f9d\u5269\u9918\u5de5\u4f5c\u91cd\u65b0\u5b89\u6392</span></button>\n                  <p>\u6642\u6578\u5e73\u5747\u5206\u914d\u5230\u4f60\u52fe\u9078\u7684\u661f\u671f\u3002\u4e0b\u9762\u6bcf\u9805\u4efb\u52d9\u53ef\u586b\u5de5\u6642\u3001\u524d\u7f6e\u4efb\u52d9\u8207\u7b49\u5f85\u539f\u56e0\uff1b\u6e96\u5099\u5929\u6578\u4e0d\u6703\u88ab\u7576\u4f5c\u5de5\u4f5c\u6642\u6578\u3002</p>\n                  <div id="journey-settings-status" role="status"></div>\n                </form>\n              </details>\n              <details id="journey-task-settings" class="journey-settings"><summary>\u4efb\u52d9\u5de5\u6642\u3001\u524d\u7f6e\u95dc\u4fc2\u8207\u6587\u4ef6<i data-lucide="list-checks" aria-hidden="true"></i></summary><div id="journey-task-editors" class="journey-task-editors"></div></details>\n              <div id="journey-schedule-result" class="journey-schedule-result" aria-live="polite"></div>\n            </section>\n            <section class="planning-documents glass-panel"><span class="planning-documents-icon"><i data-lucide="folder-check" aria-hidden="true"></i></span><div><h2>\u63a5\u8457\uff0c\u6e96\u5099\u7533\u8acb\u6587\u4ef6</h2><p id="planning-document-status" aria-live="polite">\u76ee\u6a19\u5b78\u6821\u6703\u5e36\u5165\u6587\u4ef6\u5de5\u4f5c\u5340\uff0c\u4f9d\u7576\u671f\u898f\u5b9a\u78ba\u8a8d\u8868\u683c\u3001\u7c3d\u7ae0\u8207\u4efd\u6578\u3002</p></div><a href="#application-center" class="secondary-button">\u958b\u555f\u7533\u8acb\u6587\u4ef6<i data-lucide="arrow-right" aria-hidden="true"></i></a></section>\n          </section>\n\n          <section id="community-hub" class="page-section global-community-section" aria-labelledby="community-hub-title">\n            <div class="community-feed-header">\n              <header class="community-home-heading">\n                <div><span id="community-home-kicker" class="section-kicker" hidden>\u5168\u53f0\u5b78\u751f\u5171\u540c\u4ea4\u6d41</span><h1 id="community-hub-title">\u6700\u65b0\u7559\u5b78\u8a0e\u8ad6</h1><p id="community-home-description" hidden>\u67e5\u770b\u8de8\u6821\u7533\u8acb\u7d93\u9a57\u3001\u4f4f\u5bbf\u3001\u734e\u5b78\u91d1\u8207\u6d77\u5916\u751f\u6d3b\u8a0e\u8ad6\u3002</p></div>\n                <button id="global-community-compose" type="button" class="primary-button" aria-label="\u767c\u4e00\u7bc7\u6587\u7ae0"><i data-lucide="square-pen" aria-hidden="true"></i><span>\u767c\u4e00\u7bc7\u6587\u7ae0</span></button>\n              </header>\n              <nav id="community-feed-tabs" class="community-feed-tabs" aria-label="\u8cbc\u6587\u52d5\u614b\u7be9\u9078">\n                <a href="#forum" data-community-route="all" aria-current="page"><i data-lucide="sparkles" aria-hidden="true"></i><span>\u5168\u90e8</span></a>\n                <a href="#following" data-community-route="following"><i data-lucide="rss" aria-hidden="true"></i><span>\u8ffd\u8e64</span></a>\n                <a href="#public-board" data-community-route="public"><i data-lucide="globe-2" aria-hidden="true"></i><span>\u516c\u5171\u677f</span></a>\n                <a href="#language-school-board" data-community-route="language"><i data-lucide="languages" aria-hidden="true"></i><span>\u8a9e\u8a00\u5b78\u6821</span></a>\n                <a href="#university-feed" data-community-route="university"><i data-lucide="graduation-cap" aria-hidden="true"></i><span><b data-home-school-short>\u9577\u5e9a</b>\u677f</span></a>\n              </nav>\n            </div>\n            <section class="featured-board-grid" aria-label="\u7559\u5b78\u770b\u677f">\n              <article class="featured-board-card public-board-card">\n                <span class="board-avatar board-avatar-public" aria-hidden="true"><i data-lucide="messages-square"></i></span>\n                <div><span class="board-label">\u516c\u5171\u770b\u677f</span><h2>\u516c\u5171\u7559\u5b78\u677f</h2><p>\u8de8\u6821\u7533\u8acb\u3001\u7c3d\u8b49\u3001\u4f4f\u5bbf\u8207\u6d77\u5916\u751f\u6d3b\u3002</p><a href="#public-board" class="text-action">\u67e5\u770b\u8cbc\u6587<i data-lucide="arrow-right" aria-hidden="true"></i></a></div>\n              </article>\n              <article class="featured-board-card cgu-board-card">\n                <span class="board-avatar board-avatar-school" aria-hidden="true"><i data-lucide="graduation-cap"></i></span>\n                <div><span class="board-label">\u6821\u7d1a\u770b\u677f</span><h2 data-home-school-board>\u9577\u5e9a\u5927\u5b78\u677f</h2><p id="featured-home-school-description">\u9577\u5e9a\u5b78\u751f\u7684\u4ea4\u63db\u7533\u8acb\u8cc7\u8a0a\u8207\u8a0e\u8ad6\u3002</p><div class="board-card-actions"><button type="button" class="secondary-button board-follow-button" data-follow-board="\u9577\u5e9a\u5927\u5b78" data-home-school-follow><i data-lucide="plus" aria-hidden="true"></i><span>\u8ffd\u8e64</span></button><a href="#board=\u9577\u5e9a\u5927\u5b78" class="primary-button" data-home-school-link><span>\u9032\u5165\u770b\u677f</span><i data-lucide="arrow-right" aria-hidden="true"></i></a></div></div>\n              </article>\n              <article class="featured-board-card language-board-card">\n                <span class="board-avatar board-avatar-language" aria-hidden="true"><i data-lucide="languages"></i></span>\n                <div><span class="board-label">\u516c\u5171\u4e3b\u984c\u677f</span><h2>\u8a9e\u8a00\u5b78\u6821\u677f</h2><p>\u8ab2\u7a0b\u8207\u6d77\u5916\u751f\u6d3b\u4ea4\u6d41\uff1b\u4e0d\u63d0\u4f9b\u7533\u8acb\u4ee3\u8fa6\u3002</p><a href="#language-school-board" class="text-action">\u67e5\u770b\u8a0e\u8ad6<i data-lucide="arrow-right" aria-hidden="true"></i></a></div>\n              </article>\n            </section>\n            <div class="discussion-workspace">\n            <div class="global-community-toolbar">\n              <div class="discussion-discovery-heading"><span>\u6bcf\u4e00\u6bb5\u65c5\u7a0b\uff0c\u90fd\u6709\u4eba\u540c\u884c</span><h2>\u804a\u804a\u7559\u5b78\u5927\u5c0f\u4e8b</h2></div>\n              <label class="community-search"><i data-lucide="search" aria-hidden="true"></i><input id="global-community-search" maxlength="80" aria-label="\u641c\u5c0b\u5b78\u6821\u3001\u570b\u5bb6\u6216\u554f\u984c" placeholder="\u641c\u5c0b\u5b78\u6821\u3001\u570b\u5bb6\u6216\u554f\u984c" /></label>\n              <div id="global-community-topics" class="community-topic-chips" role="group" aria-label="\u6587\u7ae0\u5206\u985e"></div>\n            </div>\n            <div class="discussion-feed-controls"><label>\u6587\u7ae0\u6392\u5e8f<select id="discussion-sort"><option value="latest">\u6700\u65b0\u6587\u7ae0</option><option value="oldest">\u8f03\u65e9\u6587\u7ae0</option><option value="unanswered">\u5f85\u56de\u8986</option></select></label><button id="discussion-saved-filter" type="button" class="text-action" aria-pressed="false"><i data-lucide="bookmark" aria-hidden="true"></i><span>\u6211\u7684\u6587\u7ae0\u6536\u85cf</span></button><small id="discussion-bookmark-status" role="status">\u6536\u85cf\u4fdd\u5b58\u5728\u6b64\u700f\u89bd\u5668</small><button id="discussion-import-saved" type="button" class="text-action" hidden>\u540c\u6b65\u6b64\u700f\u89bd\u5668\u820a\u6536\u85cf</button><button id="discussion-moderation-open" type="button" class="secondary-button" hidden>\u8a0e\u8ad6\u7ba1\u7406</button></div>\n            <div class="community-layout">\n              <div class="community-main">\n                <form id="global-community-form" class="global-community-form" hidden>\n                  <div class="community-form-grid"><label><span>\u767c\u5e03\u770b\u677f</span><select id="global-community-school" name="board_id" required><option value="public-study-abroad">\u516c\u5171\u7559\u5b78\u677f</option><option value="language-school">\u8a9e\u8a00\u5b78\u6821\u677f</option></select></label><label><span>\u6587\u7ae0\u985e\u578b</span><select name="post_type"><option value="question">\u8acb\u76ca</option><option value="experience">\u7d93\u9a57\u5206\u4eab</option><option value="discussion">\u8a0e\u8ad6</option></select></label><label><span>\u4e3b\u984c</span><select name="topic"><option value="application">\u7533\u8acb</option><option value="scholarship">\u734e\u5b78\u91d1</option><option value="housing">\u4f4f\u5bbf</option><option value="cost">\u751f\u6d3b\u8cbb</option><option value="visa">\u7c3d\u8b49</option><option value="academics">\u8ab2\u7a0b</option><option value="life">\u751f\u6d3b</option><option value="career">\u5c31\u696d</option><option value="warning">\u907f\u96f7\u63d0\u9192</option></select></label><label><span>\u570b\u5bb6</span><input name="country" maxlength="80" placeholder="\u4f8b\u5982\uff1a\u65e5\u672c" /></label><label><span>\u7533\u8acb\u5e74\u5ea6</span><input name="academic_year" maxlength="20" placeholder="\u4f8b\u5982\uff1a2027 \u79cb\u5b63" /></label><label><span>\u76ee\u524d\u968e\u6bb5</span><select name="application_stage"><option value="exploring">\u63a2\u7d22\u4e2d</option><option value="preparing">\u6e96\u5099\u7533\u8acb</option><option value="submitted">\u5df2\u9001\u4ef6</option><option value="accepted">\u5df2\u9304\u53d6</option><option value="abroad">\u6b63\u5728\u6d77\u5916</option><option value="returned">\u5df2\u8fd4\u53f0</option></select></label></div>\n                  <label><span>\u6a19\u984c</span><input name="title" minlength="4" maxlength="120" required placeholder="\u4e00\u53e5\u8a71\u8aaa\u6e05\u695a\u60f3\u554f\u6216\u60f3\u5206\u4eab\u7684\u4e8b\u60c5" /></label>\n                  <label><span>\u5167\u5bb9</span><textarea name="body" minlength="10" maxlength="1600" required placeholder="\u52a0\u5165\u5e74\u4efd\u3001\u5b78\u6821\u8207\u5177\u9ad4\u60c5\u6cc1\uff0c\u6703\u66f4\u5bb9\u6613\u5f97\u5230\u6709\u7528\u56de\u8986\u3002"></textarea></label>\n                  <div id="global-community-identity"></div>\n                  <small data-discussion-draft-status role="status">\u8349\u7a3f\u6703\u4fdd\u5b58\u5728\u6b64\u5206\u9801</small>\n                  <div class="community-form-footer"><div class="form-status" role="status"></div><button type="button" class="secondary-button" data-cancel-global-post>\u53d6\u6d88</button><button type="submit" class="primary-button"><i data-lucide="send" aria-hidden="true"></i><span>\u767c\u5e03\u6587\u7ae0</span></button></div>\n                </form>\n                <div id="global-community-feed" class="global-community-feed" aria-live="polite"><div class="skeleton skeleton-card"></div><div class="skeleton skeleton-card"></div></div>\n                <div class="discussion-pagination"><span id="discussion-feed-status" role="status"></span><button id="discussion-feed-more" type="button" class="secondary-button" hidden>\u8f09\u5165\u66f4\u591a\u6587\u7ae0</button></div>\n              </div>\n              <aside class="community-guidelines">\n                <section class="discussion-writing-guide" aria-labelledby="discussion-writing-title">\n                  <span class="discussion-aside-icon"><i data-lucide="notebook-pen" aria-hidden="true"></i></span>\n                  <h3 id="discussion-writing-title">\u4f60\u7684\u7d93\u9a57\uff0c\u6703\u662f\u8ab0\u7684\u8d77\u9ede</h3>\n                  <p>\u4e00\u500b\u63d0\u9192\uff0c\u5c31\u80fd\u8b93\u540c\u5b78\u5c11\u8d70\u5f4e\u8def\u3002</p>\n                  <ol><li><span>01</span>\u8aaa\u8aaa\u4f60\u53bb\u4e86\u54ea\u88e1</li><li><span>02</span>\u5e36\u4e0a\u5e74\u4efd\u8207\u7533\u8acb\u968e\u6bb5</li><li><span>03</span>\u5206\u4eab\u9047\u5230\u7684\u554f\u984c\u6216\u5fc3\u5f97</li></ol>\n                  <button type="button" class="text-action" data-open-global-community-composer>\u5beb\u4e0b\u6211\u7684\u7d93\u9a57<i data-lucide="arrow-up-right" aria-hidden="true"></i></button>\n                </section>\n                <section class="discussion-safety-guide" aria-labelledby="discussion-safety-title"><h3 id="discussion-safety-title"><i data-lucide="shield-check" aria-hidden="true"></i>\u5b89\u5fc3\u4ea4\u6d41\uff0c\u4e00\u8d77\u5b88\u8b77</h3><p>\u66b1\u7a31\u767c\u6587\uff0c\u4fdd\u8b77\u5f7c\u6b64\u7684\u96b1\u79c1\u3002</p><ul><li>\u4e0d\u516c\u958b\u96fb\u8a71\u3001\u4fe1\u7bb1\u6216\u793e\u7fa4\u5e33\u865f</li><li>\u79c1\u8a0a\u9700\u5c0d\u65b9\u63a5\u53d7\uff0c\u53ef\u6aa2\u8209\u8207\u5c01\u9396</li><li>\u7533\u8acb\u8cc7\u8a0a\u8acb\u518d\u6838\u5c0d\u5b98\u65b9\u516c\u544a</li></ul></section>\n              </aside>\n            </div>\n            </div>\n          </section>\n\n          <section id="advisor" class="page-section advisor-section" data-university-page="advisor" aria-labelledby="advisor-title" hidden>\n            <header class="advisor-hero">\n              <div><h2 id="advisor-title">\u9078\u6821\u898f\u5283</h2><p>\u586b\u4e00\u6b21\u689d\u4ef6\uff0c\u67e5\u770b\u63a8\u85a6\u8207\u7f3a\u53e3\uff0c\u518d\u9078\u64c7\u76ee\u6a19\u5b78\u6821\u5b89\u6392\u6642\u7a0b\u3002</p></div>\n              <span class="advisor-hero-icon" aria-hidden="true"><i data-lucide="sparkles"></i></span>\n            </header>\n            <div class="advisor-layout">\n              <form id="advisor-form" class="advisor-form glass-panel">\n                <div class="workspace-heading"><span><i data-lucide="sliders-horizontal" aria-hidden="true"></i><strong>\u6211\u7684\u689d\u4ef6</strong></span><small id="advisor-profile-status">\u672a\u767b\u5165\uff0c\u4e0d\u6703\u4fdd\u5b58\u689d\u4ef6</small></div>\n                <div class="advisor-fields">\n                  <label><span>\u5b78\u9662</span><select id="advisor-college" name="college"></select></label>\n                  <label><span>\u6240\u5c6c\u7cfb\u6240</span><select id="advisor-department" name="department" aria-describedby="advisor-department-note" disabled><option value="">\u8acb\u5148\u9078\u64c7\u5b78\u9662</option></select><input id="advisor-department-text" name="department" type="text" maxlength="120" placeholder="\u8acb\u586b\u5b78\u7c4d\u4e0a\u7684\u7cfb\u6240\u6216\u5b78\u4f4d\u5b78\u7a0b" aria-describedby="advisor-department-note" hidden disabled /></label>\n                  <label><span>\u5b78\u5236</span><select id="advisor-degree" name="degree_level"><option value="">\u5c1a\u672a\u8a2d\u5b9a</option><option value="\u5927\u5b78\u90e8">\u5927\u5b78\u90e8</option><option value="\u7814\u7a76\u6240">\u7814\u7a76\u6240</option></select></label>\n                  <label id="advisor-percent-field"><span>\u5b78\u696d\u5e73\u5747</span><input id="advisor-academic-score" name="academic_score" type="number" min="0" max="100" step="0.1" inputmode="decimal" placeholder="\u4f8b\u5982 82" /></label>\n                  <label data-ntu-academic-field hidden><span>\u9069\u7528\u5b78\u5e74GPA\uff084.3\u5236\uff09</span><input id="advisor-academic-gpa" name="academic_gpa" type="number" min="0" max="4.3" step="0.01" inputmode="decimal" placeholder="\u4f8b\u5982 2.44\uff1b\u8207\u6392\u540d\u64c7\u4e00" disabled /></label>\n                  <label data-ntu-academic-field hidden><span>\u9069\u7528\u5b78\u5e74\u73ed\u6392\u540d\uff08\u524d\u5e7e%\uff09</span><input id="advisor-class-rank" name="class_rank_percent" type="number" min="0.01" max="100" step="0.01" inputmode="decimal" placeholder="\u4f8b\u5982\u524d30%\u586b30" disabled /></label>\n                  <label><span>\u8a9e\u8a00\u6e2c\u9a57</span><select id="advisor-language-test" name="language_test"><option value="">\u5c1a\u672a\u8003\uff0f\u5c1a\u672a\u6c7a\u5b9a</option><option value="toeic">TOEIC</option><option value="ielts">IELTS Academic</option><option value="toefl">TOEFL iBT\uff08\u820a\u5236120\u5206\uff09</option><option value="toefl_new">TOEFL iBT\uff08\u65b0\u52366\u5206\uff09</option><option value="duolingo">Duolingo</option><option value="other">\u5176\u4ed6</option></select></label>\n                  <label><span>\u8a9e\u8a00\u5206\u6578</span><input placeholder="\u5c1a\u672a\u8003\u53ef\u7559\u7a7a" id="advisor-language-score" name="language_score" type="number" min="0" step="0.5" inputmode="decimal" /></label>\n                  <label data-tku-eligibility hidden><span>JLPT \u7d1a\u5225</span><select id="advisor-jlpt-level" name="jlpt_level" disabled><option value="">\u5c1a\u672a\u8003\uff0f\u5f85\u88dc</option><option value="N1">N1</option><option value="N2">N2</option><option value="N3">N3</option><option value="N4">N4</option><option value="N5">N5</option></select></label>\n                  <label><span>\u60f3\u53bb\u7684\u570b\u5bb6\uff0f\u5730\u5340</span><select id="advisor-country" name="preferred_country"></select></label>\n                  <label><span>\u9810\u8a08\u51fa\u570b\u5b78\u671f</span><select id="advisor-target-term" name="target_term"><option value="">\u5c1a\u672a\u6c7a\u5b9a</option><option value="2027-spring">2027 \u6625\u5b63</option><option value="2027-fall">2027 \u79cb\u5b63</option><option value="2028-spring">2028 \u6625\u5b63</option><option value="2028-fall">2028 \u79cb\u5b63</option></select></label>\n                </div>\n                <p id="advisor-academic-rule" class="academic-directory-note" hidden>\u4f9d\u672c\u6821\u7576\u671f\u7c21\u7ae0\u78ba\u8a8d\u6210\u7e3e\u9580\u6abb\u3002</p>\n                <div id="tku-eligibility-check" data-tku-eligibility hidden>\n                  <p class="academic-directory-note">\u6de1\u6c5f2027\u20132028\u65e5\u8a9e\u4e8c\u7504\u689d\u4ef6\u67e5\u6838\uff08\u6821\u5167\u5df2\u622a\u6b62\uff09\u3002JLPT \u8207\u82f1\u8a9e\u6210\u7e3e\u5206\u958b\u6838\u5c0d\uff1b\u7814\u7a76\u6240\u5e74\u7d1a\u3001\u5916\u6821\u5165\u5b78\u53ca\u63d0\u540d\u4ecd\u9808\u78ba\u8a8d\u3002</p>\n                  <label><span>\u67e5\u6838\u5916\u6821</span><select id="tku-eligibility-partner"><option value="seikei">\u6210\u8e4a\u5927\u5b78</option><option value="ritsumeikan">\u7acb\u547d\u9928\u5927\u5b78</option><option value="nagasaki">\u9577\u5d0e\u5916\u570b\u8a9e\u5927\u5b78\uff08NICS \u5c0d\u61c9\u5f85\u78ba\u8a8d\uff09</option><option value="uec">\u96fb\u6c23\u901a\u4fe1\u5927\u5b78\uff08JUSST\uff09</option></select></label>\n                  <p id="tku-eligibility-result" class="academic-directory-note" aria-live="polite"></p>\n                </div>\n                <p class="academic-directory-note"><span id="advisor-department-note">\u9078\u64c7\u5b78\u9662\u5f8c\u986f\u793a\u6240\u5c6c\u7cfb\u6240\u3002</span><a id="advisor-department-source" target="_blank" rel="noopener noreferrer" hidden>\u5b98\u65b9\u540d\u55ae</a></p>\n                <details class="advisor-more-fields">\n                  <summary><span><i data-lucide="sliders-horizontal" aria-hidden="true"></i><strong>\u66f4\u591a\u689d\u4ef6</strong></span><i data-lucide="chevron-down" aria-hidden="true"></i></summary>\n                  <div class="advisor-fields">\n                    <label><span>\u5e74\u7d1a</span><select id="advisor-current-year" name="current_year"><option value="">\u5c1a\u672a\u8a2d\u5b9a</option><option value="\u5927\u4e00">\u5927\u4e00</option><option value="\u5927\u4e8c">\u5927\u4e8c</option><option value="\u5927\u4e09">\u5927\u4e09</option><option value="\u5927\u56db">\u5927\u56db</option><option value="\u78a9\u58eb\u73ed">\u78a9\u58eb\u73ed</option><option value="\u535a\u58eb\u73ed">\u535a\u58eb\u73ed</option></select></label>\n\n                    <label><span>\u6bcf\u6708\u9810\u7b97</span><input id="advisor-monthly-budget" name="monthly_budget" type="number" min="0" step="1000" inputmode="decimal" placeholder="\u65b0\u53f0\u5e63" /></label>\n                    <label><span>\u504f\u597d\u6388\u8ab2\u8a9e\u8a00</span><select id="advisor-teaching-language" name="preferred_teaching_language"><option value="">\u4e0d\u9650</option><option value="english">\u82f1\u8a9e</option><option value="japanese">\u65e5\u8a9e</option><option value="chinese">\u4e2d\u6587</option><option value="other">\u5176\u4ed6\u8a9e\u8a00</option></select></label>\n                    <label><span>\u60f3\u4fee\u7684\u9818\u57df\u6216\u8ab2\u7a0b</span><input id="advisor-course-interests" name="course_interests" type="text" maxlength="120" placeholder="\u4f8b\u5982\uff1a\u8cc7\u6599\u79d1\u5b78\u3001\u570b\u969b\u6cd5\uff08\u9078\u586b\uff09" /></label>\n                    <label class="advisor-toggle"><input id="advisor-scholarship" name="needs_scholarship" type="checkbox" /><span><strong>\u9700\u8981\u88dc\u52a9</strong><small>\u4e00\u4f75\u6574\u7406\u88dc\u52a9\u9650\u5236</small></span></label>\n                  </div>\n                </details>\n                <fieldset id="application-period-fields" class="application-period-fields" disabled hidden>\n                  <legend>\u672c\u6b21\u7533\u8acb\u8207\u5fd7\u9858</legend>\n                <label for="eligibility-academic-year"><span>\u7533\u8acb\u5b78\u5e74\u5ea6</span><select id="eligibility-academic-year" aria-describedby="application-period-hint" required><option value="">\u8acb\u9078\u64c7</option><option value="115">115 \u5b78\u5e74\u5ea6\uff08\u6d41\u7a0b\u8cc7\u6599\u5f85\u78ba\u8a8d\uff09</option><option value="116">116 \u5b78\u5e74\u5ea6\uff08\u6d41\u7a0b\u8cc7\u6599\u5f85\u78ba\u8a8d\uff09</option><option value="117">117 \u5b78\u5e74\u5ea6\uff08\u6d41\u7a0b\u8cc7\u6599\u5f85\u78ba\u8a8d\uff09</option></select></label>\n                <label for="eligibility-application-round"><span>\u7533\u8acb\u68af\u6b21</span><select id="eligibility-application-round" aria-describedby="application-period-hint" required><option value="">\u8acb\u9078\u64c7</option><option value="\u7b2c\u4e00\u68af\u6b21">\u7b2c\u4e00\u68af\u6b21\uff08\u6b64\u5e74\u5ea6\u6d41\u7a0b\u5f85\u78ba\u8a8d\uff09</option><option value="\u7b2c\u4e8c\u68af\u6b21">\u7b2c\u4e8c\u68af\u6b21\uff08\u6b64\u5e74\u5ea6\u6d41\u7a0b\u5f85\u78ba\u8a8d\uff09</option><option value="\u5176\u4ed6\uff0f\u5c1a\u672a\u516c\u544a">\u5176\u4ed6\uff0f\u5c1a\u672a\u516c\u544a</option></select></label>\n                <div class="application-period-help"><p id="application-period-hint" class="application-period-hint" aria-live="polite">\u5e74\u5ea6\u8207\u68af\u6b21\u9808\u8207\u6bcd\u6821\u516c\u544a\u4e00\u81f4\u3002</p><a id="application-period-source" target="_blank" rel="noopener noreferrer" hidden>\u6838\u5c0d\u6d41\u7a0b\u4f86\u6e90</a><button id="application-period-retry" type="button" class="text-action" hidden>\u91cd\u65b0\u8b80\u53d6\u5e74\u5ea6\u8207\u68af\u6b21</button></div>\n                <fieldset class="application-preference-fields"><legend>\u6e96\u5099\u5fd7\u9858\u5e8f\uff08\u6700\u591a\u4e94\u6240\uff1b\u6b63\u5f0f\u898f\u5b9a\u4f9d\u672c\u6821\u516c\u544a\uff09</legend><label for="eligibility-preference-1"><span>\u7b2c\u4e00\u5fd7\u9858</span><select id="eligibility-preference-1" required></select></label><label for="eligibility-preference-2"><span>\u7b2c\u4e8c\u5fd7\u9858</span><select id="eligibility-preference-2"></select></label><label for="eligibility-preference-3"><span>\u7b2c\u4e09\u5fd7\u9858</span><select id="eligibility-preference-3"></select></label><label for="eligibility-preference-4"><span>\u7b2c\u56db\u5fd7\u9858</span><select id="eligibility-preference-4"></select></label><label for="eligibility-preference-5"><span>\u7b2c\u4e94\u5fd7\u9858</span><select id="eligibility-preference-5"></select></label></fieldset>\n                <p class="application-plan-login-note"><i data-lucide="cloud" aria-hidden="true"></i><span>\u5efa\u7acb\u500b\u4eba\u6e05\u55ae\u6642\u624d\u9700\u8981\u767b\u5165\uff0c\u4e4b\u5f8c\u53ef\u5728\u4e0d\u540c\u88dd\u7f6e\u540c\u6b65\u5fd7\u9858\u8207\u5b8c\u6210\u72c0\u614b\u3002</span></p>\n                <button id="clear-saved-eligibility" type="button" class="secondary-button eligibility-clear" hidden><i data-lucide="rotate-ccw" aria-hidden="true"></i><span>\u6e05\u9664\u5e33\u865f\u7684\u9078\u6821\u8207\u8cc7\u683c\u689d\u4ef6</span></button>\n                </fieldset>\n                <label class="advisor-question-field"><span>\u60f3\u554f\u4ec0\u9ebc\uff1f</span><textarea id="advisor-question" name="question" maxlength="500" rows="3" placeholder="\u4f8b\u5982\uff1a\u7533\u8acb\u65e5\u672c\u4ea4\u63db\u9700\u8981\u54ea\u4e9b\u6587\u4ef6\uff1f"></textarea></label>\n                <div class="advisor-question-chips" aria-label="\u5e38\u898b\u554f\u984c">\n                  <button type="button" data-advisor-question="\u4ea4\u63db\u7533\u8acb\u9700\u8981\u6e96\u5099\u54ea\u4e9b\u6587\u4ef6\uff1f">\u5fc5\u8981\u6587\u4ef6</button>\n                  <button type="button" data-home-school-advisor-question data-advisor-question="\u9577\u5e9a\u5927\u5b78\u4ea4\u63db\u7533\u8acb\u7684\u8a9e\u8a00\u9580\u6abb\u662f\u4ec0\u9ebc\uff1f">\u8a9e\u8a00\u9580\u6abb</button>\n                  <button type="button" data-advisor-question="\u6709\u54ea\u4e9b\u51fa\u570b\u88dc\u52a9\u53ef\u4ee5\u7533\u8acb\uff1f">\u88dc\u52a9</button>\n                </div>\n                <button id="advisor-submit" type="submit" class="primary-button full-width"><i data-lucide="wand-sparkles" aria-hidden="true"></i><span>\u767b\u5165\u5f8c\u7522\u751f\u65b9\u6848</span></button>\n                <small class="advisor-source-note"><i data-lucide="shield-check" aria-hidden="true"></i>\u50c5\u4f9d\u5df2\u67e5\u6838\u4f86\u6e90\u4f5c\u7b54\uff1b\u7b26\u5408\u5ea6\u4e0d\u662f\u9304\u53d6\u6a5f\u7387\u3002\u672a\u767b\u5165\u53ef\u5148\u586b\u5beb\uff0c\u767b\u5165\u5f8c\u624d\u6703\u9001\u51fa\u4e26\u4fdd\u5b58\u500b\u4eba\u65b9\u6848\u3002</small>\n                <small id="advisor-index-status" class="advisor-source-note advisor-index-status" hidden></small>\n                <div id="ai-status-chip" class="ai-status-chip" hidden data-state="paused" role="status"></div>\n                <div id="ai-fallback-banner" class="ai-fallback-banner" hidden>\n                  <i data-lucide="info" aria-hidden="true"></i>\n                  <span>\u672c\u6a5f AI \u670d\u52d9\u96e2\u7dda\uff0c\u5df2\u5207\u63db\u81f3\u898f\u5247\u5f0f\u7d50\u679c\u3002\u641c\u5c0b\u3001\u6bd4\u8f03\u3001\u8cc7\u683c\u78ba\u8a8d\u7b49\u529f\u80fd\u4e0d\u53d7\u5f71\u97ff\u3002</span>\n                </div>\n                <span id="ai-status-live" class="sr-only" aria-live="polite" aria-atomic="true"></span>\n              </form>\n              <div id="advisor-result" class="advisor-result">\n                <section id="advisor-assistant" class="advisor-assistant" data-state="idle" aria-busy="false" aria-labelledby="advisor-assistant-title">\n                  <div class="advisor-mascot-stage" aria-hidden="true">\n                    <div class="advisor-mascot-frame">\n                      <span class="uw-mascot" data-play data-tilt>\n                        <span class="uw-mascot-shadow"></span>\n                        <span class="uw-mascot-body">\n                          <span class="uw-mascot-tilt">\n                            <span class="uw-mascot-slab"></span>\n                            <img class="uw-mascot-picture" src="/static/assets/mascot/suitcase.webp?v=20261007-solid-1" alt="" width="384" height="460" loading="lazy" decoding="async" draggable="false" />\n                            <span class="uw-mascot-sheen"></span>\n                            <span class="uw-mascot-eyes"><span class="uw-mascot-eye"></span><span class="uw-mascot-eye"></span></span>\n                          </span>\n                        </span>\n                      </span>\n                      <span class="advisor-mascot-scan"></span>\n                      <span class="advisor-mascot-paper one"></span>\n                      <span class="advisor-mascot-paper two"></span>\n                      <span class="advisor-mascot-confetti"></span>\n                      <span class="advisor-mascot-alert"></span>\n                    </div>\n                  </div>\n                  <div class="advisor-assistant-copy" role="status" aria-live="polite" aria-atomic="true">\n                    <span class="advisor-assistant-eyebrow">\u7559\u5b78\u5c0f\u52a9\u624b</span>\n                    <h3 id="advisor-assistant-title">\u5efa\u7acb\u7b2c\u4e00\u4efd\u7533\u8acb\u65b9\u6848</h3>\n                    <p id="advisor-assistant-detail">\u586b\u5beb\u689d\u4ef6\u5f8c\uff0c\u6211\u6703\u6574\u7406\u5019\u9078\u5b78\u6821\u3001\u689d\u4ef6\u7f3a\u53e3\u8207\u4e0b\u4e00\u6b65\u3002</p>\n                  </div>\n                </section>\n                <div id="advisor-result-content"></div>\n              </div>\n            </div>\n          </section>\n\n          <section id="partners" class="page-section" data-university-page="partners" aria-labelledby="partners-title" hidden>\n            <h2 id="partners-title" class="visually-hidden">\u5b78\u6821\u641c\u5c0b</h2>\n            <div class="partner-view-toolbar">\n              <label class="search-field" for="partner-search"><span>\u641c\u5c0b\u5b78\u6821</span><span class="control-with-icon"><i data-lucide="search" aria-hidden="true"></i><input id="partner-search" placeholder="\u5b78\u6821\u3001\u570b\u5bb6\u6216\u7533\u8acb\u689d\u4ef6" /></span></label>\n\n              <div class="partner-view-switch" role="group" aria-label="\u5408\u4f5c\u5b78\u6821\u6aa2\u8996\u65b9\u5f0f">\n                <button type="button" data-partner-view="list" aria-pressed="true" aria-controls="partner-table"><i data-lucide="list" aria-hidden="true"></i>\u5217\u8868</button>\n                <button type="button" data-partner-view="map" aria-pressed="false" aria-controls="partner-map-panel"><i data-lucide="globe-2" aria-hidden="true"></i>3D \u5730\u5716</button>\n              </div>\n            </div>\n            <div class="journey-search-layout">\n            <div class="journey-search-results">\n            <div class="discovery-search-tools">\n              <details id="discovery-criteria" class="discovery-criteria"><summary><i data-lucide="sliders-horizontal" aria-hidden="true"></i>\u6211\u7684\u689d\u4ef6 <span id="discovery-criteria-count"></span></summary>\n                <form id="discovery-criteria-form">\n                  <label>\u8a9e\u8a00\u6aa2\u5b9a<select id="discovery-test" name="test"><option value="">\u66ab\u4e0d\u7be9\u9078</option><option value="ielts">IELTS</option><option value="toefl">TOEFL iBT</option><option value="toeic">TOEIC</option><option value="jlpt">\u65e5\u6aa2 JLPT</option><option value="topik">\u97d3\u6aa2 TOPIK</option><option value="duolingo">Duolingo</option></select></label>\n                  <label>\u6aa2\u5b9a\u6210\u7e3e<input id="discovery-score" name="score" type="number" min="0" max="990" step="0.5" placeholder="\u6210\u7e3e"></label>\n                  <label>\u5b78\u696d\u6210\u7e3e<input name="grade" type="number" min="0" max="100" step="0.01" placeholder="\u4f8b\u5982 3.5"></label>\n                  <label>\u8a08\u5206\u5236<select name="scale"><option value="100">\u767e\u5206\u5236</option><option value="4">GPA 4.0</option><option value="4.3">GPA 4.3</option><option value="5">GPA 5.0</option></select></label>\n                  <label>\u5b78\u5236<select name="degree"><option value="">\u4e0d\u9650</option><option value="undergraduate">\u5927\u5b78\u90e8</option><option value="graduate">\u7814\u7a76\u6240</option></select></label>\n                  <label>\u4ea4\u63db\u5b78\u671f<select name="term"><option value="">\u4e0d\u9650</option><option value="fall">\u79cb\u5b63\uff0f\u4e0a\u5b78\u671f</option><option value="spring">\u6625\u5b63\uff0f\u4e0b\u5b78\u671f</option></select></label>\n                  <label class="discovery-criteria-mode">\u986f\u793a\u65b9\u5f0f<select name="mode"><option value="possible">\u53ef\u8003\u616e\uff0c\u542b\u5f85\u78ba\u8a8d</option><option value="confirmed">\u50c5\u5df2\u77e5\u9580\u6abb\u7b26\u5408</option></select></label>\n                  <div class="discovery-form-actions"><button id="discovery-clear-criteria" type="button" class="secondary-button">\u91cd\u8a2d</button><button type="submit" class="primary-button">\u5957\u7528\u689d\u4ef6</button></div>\n                </form>\n              </details>\n              <details class="discovery-recents" data-discovery-recents hidden></details>\n              <a class="discovery-open-workspace" href="#favorites"><i data-lucide="bookmark" aria-hidden="true"></i>\u6211\u7684\u9078\u6821 <span id="discovery-selection-count"></span></a>\n            </div>\n            <p id="discovery-criteria-result" class="discovery-muted" role="status"></p>\n            <p id="partner-result-count" class="partner-result-count"></p>\n            <div id="partner-table" class="partner-results" aria-live="polite" aria-busy="true"><div class="skeleton skeleton-table"></div></div>\n            <button id="show-more-partners" type="button" class="secondary-button centered-button" hidden>\u986f\u793a\u66f4\u591a\u5b78\u6821</button>\n            <section id="partner-map-panel" class="partner-map-panel" aria-label="\u5168\u7403\u4ea4\u63db\u5408\u4f5c\u7db2\u7d61" hidden>\n              <div class="partner-map-heading"><div><h3>\u5168\u7403\u5408\u4f5c\u5b78\u6821</h3><p id="partner-map-context"></p></div></div>\n              <div class="partner-map-actions">\n                <div><button id="map-motion" type="button" class="secondary-button" aria-pressed="true">\u52d5\u614b\u6548\u679c\uff1a\u958b</button><button id="map-home" type="button" class="secondary-button">\u2605 \u6240\u5c6c\u5927\u5b78</button><button id="map-global" type="button" class="secondary-button">\u5168\u7403\u8996\u89d2</button></div>\n              </div>\n              <div class="partner-map-stage">\n                <div id="partner-globe" aria-label="\u4e92\u52d5\u5730\u7403\uff1a\u65b9\u5411\u9375\u5e73\u79fb\uff0c\u52a0\u6e1b\u9375\u7e2e\u653e" aria-describedby="partner-map-help"></div>\n                <div id="partner-map-status" class="partner-map-status" role="status" aria-live="polite"><span class="map-loading-orbit" aria-hidden="true"></span><strong>\u5730\u5716\u8f09\u5165\u4e2d</strong></div>\n                <aside id="partner-map-preview" class="partner-map-preview" aria-label="\u5b78\u6821\u9810\u89bd" hidden></aside>\n                <div class="partner-map-legend" aria-label="\u5730\u5716\u5716\u4f8b"><span><b class="map-legend-dot"></b>\u5408\u4f5c\u5b78\u6821</span><span><b class="map-legend-star">\u2605</b>\u6240\u5c6c\u5927\u5b78</span><span><b class="map-legend-cluster">2+</b>\u9130\u8fd1\u5b78\u6821</span></div>\n              </div>\n              <div class="partner-map-footer"><p id="partner-map-help">\u62d6\u66f3\u63a2\u7d22 \xb7 \u96d9\u6307\u7e2e\u653e \xb7 \u9ede\u9078\u5b78\u6821\u67e5\u770b\u6a5f\u6703</p><span id="partner-map-count" aria-live="polite"></span></div>\n              <div class="partner-map-access"><label for="map-school-select">\u5b9a\u4f4d\u5b78\u6821</label><select id="map-school-select"><option value="">\u9078\u64c7\u5730\u5716\u4e0a\u7684\u5b78\u6821</option></select><p id="partner-map-missing"></p></div>\n            </section>\n            </div>\n            <details class="journey-filter-drawer" open>\n              <summary><i data-lucide="sliders-horizontal" aria-hidden="true"></i>\u7be9\u9078<i data-lucide="chevron-down" aria-hidden="true"></i></summary>\n            <div class="filter-panel" aria-label="\u5408\u4f5c\u5b78\u6821\u7be9\u9078\u689d\u4ef6">\n              <label for="availability-filter"><span>\u540d\u984d\u72c0\u614b</span><select id="availability-filter"><option value="">\u5168\u90e8\u5408\u4f5c\u72c0\u614b</option><option value="open">\u672c\u671f\u958b\u653e</option><option value="closed">\u8868\u5217\u4ea4\u63db\u6821\uff0f\u6821\u5167\u7533\u8acb\u5df2\u622a\u6b62</option><option value="reference_only">\u820a\u671f\u53c3\u8003\uff0f\u4e0d\u80fd\u4f5c\u7576\u671f\u7533\u8acb</option><option value="quota_unconfirmed">\u7576\u671f\u540d\u984d\u6216\u671f\u9593\u5f85\u78ba\u8a8d</option><option value="agreement_only">\u5408\u4f5c\u5099\u67e5\uff0f\u672c\u671f\u672a\u516c\u544a</option><option value="departmental_reference">\u9662\u7d1a\u53c3\u8003\uff0f\u7576\u671f\u9700\u78ba\u8a8d</option></select></label>\n              <label for="region-filter"><span>\u5730\u5340</span><select id="region-filter"></select></label>\n              <label for="country-filter"><span>\u570b\u5bb6</span><select id="country-filter"></select></label>\n              <label for="college-filter"><span>\u5b78\u9662</span><select id="college-filter"></select></label>\n              <label for="degree-filter"><span>\u5b78\u5236</span><select id="degree-filter"></select></label>\n              <button id="clear-partner-filters" type="button" class="secondary-button"><i data-lucide="rotate-ccw" aria-hidden="true"></i><span>\u6e05\u9664</span></button>\n            </div>\n            </details>\n            </div>\n          </section>\n\n          <section id="favorites" class="page-section favorites-section" data-university-page="favorites" aria-labelledby="favorites-title" hidden>\n            <div class="section-heading">\n              <div><h2 id="favorites-title">\u6211\u7684\u9078\u6821</h2><p id="discovery-save-note">\u5132\u5b58\u5728\u6b64\u88dd\u7f6e</p></div>\n              <span class="count-badge" id="favorite-count">0 \u6240</span>\n            </div>\n            <div id="favorite-list" class="favorite-list"></div>\n            <div id="compare-panel" class="compare-panel" hidden></div>\n            <div id="selection-workspace"></div>\n          </section>\n\n          <section id="calendar" class="page-section application-calendar-section" data-university-page="calendar" aria-labelledby="application-calendar-title" hidden>\n            <header class="calendar-header glass-panel">\n              <div><h2 id="application-calendar-title">\u6211\u7684\u7533\u8acb\u65e5\u66c6</h2><p>\u638c\u63e1\u671f\u9650\uff0c\u628a\u6e96\u5099\u4efb\u52d9\u5b89\u6392\u5728\u51fa\u767c\u4e4b\u524d\u3002</p></div>\n              <div id="calendar-next-summary" class="calendar-next-summary"><span class="skeleton skeleton-stat"></span></div>\n            </header>\n            <div class="calendar-action-bar" aria-label="\u65e5\u66c6\u64cd\u4f5c">\n              <div class="calendar-month-controls">\n                <button id="calendar-previous-month" type="button" class="icon-button" aria-label="\u4e0a\u4e00\u500b\u6708"><i data-lucide="chevron-left" aria-hidden="true"></i></button>\n                <button id="calendar-today" type="button" class="secondary-button"><i data-lucide="locate-fixed" aria-hidden="true"></i><span>\u4eca\u5929</span></button>\n                <button id="calendar-next-month" type="button" class="icon-button" aria-label="\u4e0b\u4e00\u500b\u6708"><i data-lucide="chevron-right" aria-hidden="true"></i></button>\n                <strong id="calendar-month-label" aria-live="polite"></strong>\n              </div>\n              <div class="calendar-toolbar-tools">\n                <button type="button" class="secondary-button" data-calendar-panel=".calendar-quick-add" aria-controls="calendar-quick-add"><i data-lucide="plus" aria-hidden="true"></i><span>\u65b0\u589e\u4efb\u52d9</span></button>\n                <button type="button" class="secondary-button" data-calendar-panel="#calendar-insights" aria-controls="calendar-insights"><i data-lucide="sliders-horizontal" aria-hidden="true"></i><span>\u63d0\u9192\u8207\u5206\u6790</span></button>\n                <button id="calendar-sync-button" type="button" class="secondary-button" aria-controls="calendar-sync-panel"><i data-lucide="refresh-cw" aria-hidden="true"></i><span>\u65e5\u66c6\u540c\u6b65</span></button>\n              </div>\n            </div>\n            <div id="calendar-alert-brief" class="calendar-alert-brief" role="status" hidden><i data-lucide="bell-ring" aria-hidden="true"></i><span></span><button type="button" class="text-action" data-calendar-panel="#calendar-insights">\u67e5\u770b\u8a73\u60c5</button></div>\n            <div class="application-calendar-layout">\n              <div class="calendar-month-panel">\n                <div class="calendar-weekdays" aria-hidden="true"><span>\u65e5</span><span>\u4e00</span><span>\u4e8c</span><span>\u4e09</span><span>\u56db</span><span>\u4e94</span><span>\u516d</span></div>\n                <div id="application-calendar-grid" class="application-calendar-grid" role="grid" aria-label="\u7533\u8acb\u6642\u7a0b\u6708\u66c6"></div>\n              </div>\n              <aside class="calendar-agenda-panel" aria-labelledby="calendar-agenda-title">\n                <div class="calendar-agenda-heading"><span><i data-lucide="list-todo" aria-hidden="true"></i><strong id="calendar-agenda-title">\u63a5\u4e0b\u4f86\u8981\u505a</strong></span><small id="calendar-agenda-date"></small></div>\n                <div id="calendar-agenda-list" class="calendar-agenda-list" aria-live="polite"></div>\n              </aside>\n            </div>\n            <div class="calendar-secondary-tools">\n              <details id="calendar-insights" class="calendar-insights">\n                <summary tabindex="0"><span><i data-lucide="bell" aria-hidden="true"></i><strong>\u63d0\u9192\u8207\u6e96\u5099\u5206\u6790</strong><small id="calendar-insights-count">\u67e5\u770b\u63d0\u9192\u8207\u5206\u6790\u7d50\u679c</small></span><i data-lucide="chevron-down" aria-hidden="true"></i></summary>\n                <div class="calendar-insights-content">\n            <div id="deadline-reminder-center" class="deadline-reminder-center" aria-live="polite"></div>\n            <section id="calendar-conflict-center" class="calendar-conflict-center" aria-labelledby="calendar-conflict-title" hidden>\n              <header><span><i data-lucide="calendar-range" aria-hidden="true"></i><strong id="calendar-conflict-title">\u591a\u4efd\u7533\u8acb\u8a08\u756b\u885d\u7a81</strong></span><small>\u9032\u968e\u529f\u80fd</small></header>\n              <p id="calendar-conflict-summary"></p>\n              <div id="calendar-conflict-list" class="calendar-conflict-list" aria-live="polite"></div>\n            </section>\n            <section id="calendar-task-schedule-center" class="calendar-task-schedule-center" aria-labelledby="calendar-task-schedule-title" hidden>\n              <header><span><i data-lucide="list-start" aria-hidden="true"></i><strong id="calendar-task-schedule-title">\u6e96\u5099\u6642\u9593\u5b89\u6392</strong></span><small>\u9032\u968e\u529f\u80fd</small></header>\n              <p id="calendar-task-schedule-summary"></p>\n              <div id="calendar-task-schedule-list" class="calendar-task-schedule-list" aria-live="polite"></div>\n            </section>\n                </div>\n              </details>\n            <details id="calendar-sync-panel" class="calendar-sync-panel">\n              <summary><span><i data-lucide="calendar-sync" aria-hidden="true"></i><strong>\u65e5\u66c6\u540c\u6b65</strong><small id="calendar-sync-summary">\u767b\u5165\u5f8c\u53ef\u8b93\u7b2c\u4e09\u65b9\u65e5\u66c6\u6301\u7e8c\u53d6\u5f97\u66f4\u65b0</small></span><i data-lucide="chevron-down" aria-hidden="true"></i></summary>\n              <div class="calendar-sync-content">\n                <div id="calendar-sync-status" class="calendar-sync-status"></div>\n                <div class="calendar-provider-grid" aria-label="\u652f\u63f4\u7684\u65e5\u66c6\u670d\u52d9">\n                  <article><span class="calendar-provider-icon google">G</span><div><strong>Google \u65e5\u66c6</strong><small>\u4f7f\u7528\u7db2\u5740\u8a02\u95b1\uff0c\u7cfb\u7d71\u66f4\u65b0\u5f8c\u6703\u7531 Google \u5b9a\u671f\u540c\u6b65\u3002</small></div><button type="button" class="secondary-button" data-calendar-provider="google">\u8a2d\u5b9a</button></article>\n                  <article><span class="calendar-provider-icon apple"><i data-lucide="apple" aria-hidden="true"></i></span><div><strong>Apple \u884c\u4e8b\u66c6</strong><small>\u7528\u8a02\u95b1\u9023\u7d50\u52a0\u5165 iPhone\u3001iPad \u6216 Mac\u3002</small></div><button type="button" class="secondary-button" data-calendar-provider="apple">\u8a2d\u5b9a</button></article>\n                  <article><span class="calendar-provider-icon outlook">O</span><div><strong>Outlook</strong><small>\u5f9e\u7db2\u8def\u8a02\u95b1\u540c\u4e00\u4efd\u4ea4\u63db\u7533\u8acb\u6642\u7a0b\u3002</small></div><button type="button" class="secondary-button" data-calendar-provider="outlook">\u8a2d\u5b9a</button></article>\n                </div>\n                <div id="calendar-subscription-actions" class="calendar-subscription-actions"></div>\n                <small class="calendar-privacy-note"><i data-lucide="shield-check" aria-hidden="true"></i>\u8a02\u95b1\u7db2\u5740\u7b49\u540c\u79c1\u4eba\u9470\u5319\uff0c\u8acb\u52ff\u516c\u958b\uff1b\u53ef\u96a8\u6642\u64a4\u92b7\u4e26\u7522\u751f\u65b0\u7db2\u5740\u3002</small>\n              </div>\n            </details>\n            </div>\n            <details id="calendar-quick-add" class="calendar-quick-add">\n              <summary><span><i data-lucide="plus" aria-hidden="true"></i><strong>\u65b0\u589e\u81ea\u5df1\u7684\u7533\u8acb\u4efb\u52d9</strong></span><i data-lucide="chevron-down" aria-hidden="true"></i></summary>\n              <form id="calendar-event-form" class="calendar-event-form">\n                <label><span>\u4efb\u52d9\u540d\u7a31</span><input name="title" maxlength="80" required placeholder="\u4f8b\u5982\uff1a\u5b8c\u6210\u82f1\u6587\u8b80\u66f8\u8a08\u756b" /></label>\n                <label><span>\u65e5\u671f</span><input name="date" type="date" required /></label>\n                <label><span>\u6240\u5c6c\u7533\u8acb\u8a08\u756b</span><select id="calendar-event-school" name="school_name"><option value="">\u4e00\u822c\u4efb\u52d9\uff08\u4e0d\u7d0d\u5165\u591a\u8a08\u756b\u885d\u7a81\uff09</option></select></label>\n                <label><span>\u985e\u578b</span><select name="category"><option value="documents">\u6587\u4ef6\u6e96\u5099</option><option value="home">\u6821\u5167\u7533\u8acb</option><option value="partner">\u5408\u4f5c\u6821\u7533\u8acb</option><option value="language">\u8a9e\u8a00\u8003\u8a66</option><option value="visa">\u7c3d\u8b49</option><option value="housing">\u4f4f\u5bbf</option><option value="other">\u5176\u4ed6</option></select></label>\n                <label><span>\u63d0\u524d\u63d0\u9192</span><select name="reminder_days"><option value="0">\u7576\u5929</option><option value="3">3 \u5929\u524d</option><option value="7" selected>7 \u5929\u524d</option><option value="14">14 \u5929\u524d</option></select></label>\n                <label><span>\u9810\u4f30\u6e96\u5099\u5929\u6578</span><input name="preparation_days" type="number" min="0" max="90" value="7" inputmode="numeric" aria-describedby="calendar-preparation-help" /><small id="calendar-preparation-help">0 \u8868\u793a\u4e0d\u81ea\u52d5\u5b89\u6392\u958b\u59cb\u65e5</small></label>\n                <label><span>\u9810\u4f30\u5de5\u4f5c\u6642\u6578\uff08\u53ef\u7a0d\u5f8c\u8a2d\u5b9a\uff09</span><input name="effort_hours" type="number" min="0.1" max="1000" step="0.1" placeholder="\u4f8b\u5982 3" /><small>\u5de5\u4f5c\u6642\u6578\u642d\u914d\u6bcf\u9031\u53ef\u6295\u5165\u6642\u9593\uff0c\u5b89\u6392\u9010\u65e5\u6e96\u5099\u3002</small></label>\n                <label><span>\u76ee\u524d\u72c0\u614b</span><select name="status"><option value="todo" selected>\u672a\u958b\u59cb</option><option value="preparing">\u6e96\u5099\u4e2d</option><option value="ready">\u5df2\u5b8c\u6210</option></select></label>\n                <label class="calendar-event-note"><span>\u5099\u8a3b</span><input name="note" maxlength="160" placeholder="\u9700\u8981\u6e96\u5099\u7684\u8cc7\u6599\u6216\u4f86\u6e90" /></label>\n                <div class="form-status" role="status"></div>\n                <button type="submit" class="primary-button"><i data-lucide="plus" aria-hidden="true"></i><span>\u52a0\u5165\u65e5\u66c6</span></button>\n              </form>\n            </details>\n            <small class="calendar-source-note"><i data-lucide="shield-check" aria-hidden="true"></i>\u5b98\u65b9\u65e5\u671f\u4ecd\u53ef\u80fd\u8abf\u6574\uff1b\u9001\u4ef6\u524d\u8acb\u518d\u6b21\u6838\u5c0d\u4f86\u6e90\u3002\u7b2c\u4e09\u65b9\u65e5\u66c6\u7684\u66f4\u65b0\u6642\u9593\u7531\u5404\u670d\u52d9\u5546\u6c7a\u5b9a\u3002</small>\n          </section>\n\n          <section id="deadlines" class="page-section standalone-route-page" data-university-page="deadlines" aria-labelledby="deadlines-title" hidden>\n            <div class="section-heading compact-heading"><div><h2 id="deadlines-title">\u6821\u5167\u68af\u6b21\u8207\u7533\u8acb\u6642\u7a0b</h2><p>\u8acb\u7559\u610f\u65e5\u671f\u7684\u9069\u7528\u5e74\u5ea6\u8207\u7533\u8acb\u8eab\u5206\u3002</p></div><i class="heading-icon" data-lucide="calendar-days" aria-hidden="true"></i></div>\n            <div id="period-list" class="deadline-list" aria-busy="true"><div class="skeleton skeleton-card"></div><div class="skeleton skeleton-card"></div></div>\n          </section>\n\n          <section id="scholarships" class="page-section standalone-route-page" data-university-page="scholarships" aria-labelledby="scholarships-title" hidden>\n            <div class="section-heading compact-heading"><div><h2 id="scholarships-title">\u88dc\u52a9\u8cc7\u8a0a</h2></div><i class="heading-icon" data-lucide="badge-dollar-sign" aria-hidden="true"></i></div>\n            <div id="scholarship-match-summary" class="scholarship-match-summary"></div>\n            <div id="scholarship-list" class="scholarship-list" aria-busy="true"><div class="skeleton skeleton-card"></div><div class="skeleton skeleton-card"></div></div>\n          </section>\n\n          <section id="budget" class="page-section budget-section" data-university-page="budget" aria-labelledby="budget-title" hidden>\n            <div class="section-heading"><div><h2 id="budget-title">\u4ea4\u63db\u9810\u7b97</h2><p>\u7528\u540c\u4e00\u5e63\u5225\u4f30\u7b97\u7e3d\u6210\u672c\uff0c\u4e26\u4fdd\u7559\u5b78\u6821\u5b98\u65b9\u751f\u6d3b\u8cbb\u4f86\u6e90\u3002</p></div><i class="heading-icon" data-lucide="calculator" aria-hidden="true"></i></div>\n            <div class="budget-layout">\n              <form id="budget-form" class="budget-form">\n                <label class="budget-school-field"><span>\u4f30\u7b97\u5b78\u6821</span><select id="budget-school" name="school_name" required></select></label>\n                <label><span>\u5e63\u5225</span><select id="budget-currency" name="currency"><option value="TWD">TWD \u65b0\u53f0\u5e63</option><option value="USD">USD \u7f8e\u5143</option><option value="EUR">EUR \u6b50\u5143</option><option value="JPY">JPY \u65e5\u5713</option><option value="KRW">KRW \u97d3\u5143</option><option value="NZD">NZD \u7d10\u5e63</option><option value="AUD">AUD \u6fb3\u5e63</option></select></label>\n                <label><span>\u7814\u4fee\u6708\u6578</span><input id="budget-months" name="months" type="number" min="1" max="24" value="5" required /></label>\n                <label><span>\u6bcf\u6708\u4f4f\u5bbf</span><input id="budget-housing" name="housing" type="number" min="0" step="100" inputmode="decimal" value="0" /></label>\n                <label><span>\u6bcf\u6708\u98f2\u98df</span><input id="budget-food" name="food" type="number" min="0" step="100" inputmode="decimal" value="0" /></label>\n                <label><span>\u6bcf\u6708\u4ea4\u901a</span><input id="budget-transport" name="transport" type="number" min="0" step="100" inputmode="decimal" value="0" /></label>\n                <label><span>\u6bcf\u6708\u5176\u4ed6\u652f\u51fa</span><input id="budget-other" name="other" type="number" min="0" step="100" inputmode="decimal" value="0" /></label>\n                <label><span>\u6a5f\u7968\u3001\u7c3d\u8b49\u8207\u4fdd\u96aa</span><input id="budget-onetime" name="one_time" type="number" min="0" step="100" inputmode="decimal" value="0" /></label>\n                <label><span>\u9810\u8a08\u88dc\u52a9</span><input id="budget-scholarship" name="scholarship" type="number" min="0" step="100" inputmode="decimal" value="0" /></label>\n                <p id="budget-save-note" class="budget-save-note"><i data-lucide="calculator" aria-hidden="true"></i><span>\u8a66\u7b97\u4e0d\u9700\u767b\u5165\uff1b\u53ea\u6709\u8981\u4fdd\u5b58\u5230\u79c1\u4eba\u5de5\u4f5c\u5340\u6642\u624d\u767b\u5165\uff0c\u8a2a\u5ba2\u8f38\u5165\u4e0d\u6703\u5beb\u5165\u700f\u89bd\u5668\u3002</span></p>\n                <button id="budget-save-button" type="submit" class="primary-button"><i data-lucide="calculator" aria-hidden="true"></i><span>\u767b\u5165\u5f8c\u5132\u5b58\u4f30\u7b97</span></button>\n              </form>\n              <aside class="budget-result-panel" aria-live="polite">\n                <div id="budget-result" class="budget-result"></div>\n                <details class="budget-source-disclosure"><summary><span><i data-lucide="book-open-check" aria-hidden="true"></i><strong>\u5b98\u65b9\u751f\u6d3b\u8cbb\u53c3\u8003</strong></span><i data-lucide="chevron-down" aria-hidden="true"></i></summary><div id="budget-source-summary"></div></details>\n              </aside>\n            </div>\n          </section>\n\n          <section id="eligibility" class="page-section eligibility-section" data-university-page="eligibility" aria-labelledby="eligibility-title" hidden>\n            <div class="section-heading"><div><h2 id="eligibility-title">\u8cc7\u683c\u8207\u5fd7\u9858\u6e05\u55ae</h2><p>\u8cc7\u683c\u521d\u5224\u4f9b\u53c3\u8003\uff0c\u6b63\u5f0f\u7d50\u679c\u4ee5\u6821\u65b9\u8a8d\u5b9a\u70ba\u6e96\u3002</p></div></div>\n            <div class="eligibility-layout">\n              <div id="eligibility-result" class="eligibility-result" role="status" aria-live="polite"><div class="result-placeholder"><i data-lucide="clipboard-check" aria-hidden="true"></i><strong>\u9084\u6c92\u958b\u59cb\u6aa2\u67e5</strong><span>\u586b\u5165\u8cc7\u6599\u5f8c\uff0c\u7cfb\u7d71\u6703\u6bd4\u5c0d\u6821\u5167\u57fa\u672c\u9580\u6abb\u8207\u5408\u4f5c\u6821\u516c\u958b\u689d\u4ef6\u3002</span></div></div>\n            </div>\n          </section>\n\n          <section id="application-center" class="page-section application-center-section" data-university-page="application-center" aria-labelledby="application-center-title" hidden>\n            <header class="application-center-hero">\n              <h2 id="application-center-title">\u7533\u8acb\u6587\u4ef6</h2>\n              <div class="application-center-hero-actions"><a href="#document-check" class="secondary-button"><i data-lucide="scan-search" aria-hidden="true"></i><span>\u6aa2\u67e5\u5df2\u5beb\u6587\u4ef6</span></a><div class="application-center-hero-mark" aria-hidden="true"><i data-lucide="file-check-2"></i></div></div>\n            </header>\n\n            <ol class="application-center-steps" aria-label="\u7533\u8acb\u6587\u4ef6\u8655\u7406\u6d41\u7a0b">\n              <li class="is-active"><span>1</span><strong>\u5efa\u7acb\u7533\u8acb</strong></li>\n              <li><span>2</span><strong>\u586b\u5beb\u6587\u4ef6</strong></li>\n              <li><span>3</span><strong>\u6aa2\u67e5\u7c3d\u6838</strong></li>\n              <li><span>4</span><strong>\u4e0b\u8f09\u5217\u5370</strong></li>\n            </ol>\n\n            <div class="application-center-setup">\n              <form id="application-context-form" class="application-context-form glass-panel">\n                <div class="workspace-heading"><span><i data-lucide="route" aria-hidden="true"></i><strong>\u7533\u8acb\u8a2d\u5b9a</strong></span></div>\n                <div class="application-context-fields">\n                  <label><span>\u7533\u8acb\u985e\u578b</span><select name="program_type"><option value="exchange">\u5b78\u671f\uff0f\u5b78\u5e74\u4ea4\u63db</option><option value="dual_degree">\u96d9\u806f\u5b78\u4f4d</option><option value="internship">\u6d77\u5916\u5be6\u7fd2</option><option value="short_term_credit">\u5883\u5916\u77ed\u671f\u5b78\u5206\u8ab2\u7a0b</option></select></label>\n                  <label><span>\u76ee\u6a19\u5b78\u6821</span><select name="target_school" id="application-target-school"><option value="">\u5c1a\u672a\u6c7a\u5b9a</option></select></label>\n                  <label><span>\u5b78\u5e74\u5ea6</span><input name="academic_year" maxlength="10" placeholder="\u4f8b\u5982 116" /></label>\n                  <label><span>\u9810\u8a08\u51fa\u570b\u5b78\u671f</span><select name="semester"><option value="">\u5c1a\u672a\u6c7a\u5b9a</option><option value="\u7b2c\u4e00\u5b78\u671f">\u7b2c\u4e00\u5b78\u671f</option><option value="\u7b2c\u4e8c\u5b78\u671f">\u7b2c\u4e8c\u5b78\u671f</option><option value="\u4e00\u5b78\u5e74">\u4e00\u5b78\u5e74</option><option value="\u5bd2\u5047\uff0f\u6691\u5047">\u5bd2\u5047\uff0f\u6691\u5047</option></select></label>\n                </div>\n                <div class="application-condition-toggles" aria-label="\u689d\u4ef6\u5f0f\u6587\u4ef6">\n                  <label><input type="checkbox" name="subsidy" /><span><i data-lucide="badge-dollar-sign" aria-hidden="true"></i><strong>\u7533\u8acb\u88dc\u52a9</strong></span></label>\n                  <label><input type="checkbox" name="military_service" /><span><i data-lucide="shield-check" aria-hidden="true"></i><strong>\u5728\u5b78\u5f79\u7537</strong></span></label>\n                  <label><input type="checkbox" name="full_year" /><span><i data-lucide="calendar-range" aria-hidden="true"></i><strong>\u7814\u4fee\u4e00\u5b78\u5e74\u4ee5\u4e0a</strong></span></label>\n                </div>\n              </form>\n\n              <details id="application-profile-panel" class="application-profile-panel glass-panel">\n                <summary><span><i data-lucide="contact-round" aria-hidden="true"></i><span><strong>\u5171\u7528\u8cc7\u6599</strong><small id="application-profile-summary">\u5c1a\u672a\u586b\u5beb</small></span></span><i data-lucide="chevron-down" aria-hidden="true"></i></summary>\n                <form id="application-profile-form" class="application-profile-form" autocomplete="on">\n                  <div class="application-profile-fields">\n                    <label><span>\u4e2d\u6587\u59d3\u540d</span><input name="student_name_zh" autocomplete="name" required /></label>\n                    <label><span>\u8b77\u7167\u82f1\u6587\u59d3\u540d</span><input name="student_name_en" autocomplete="name" required /></label>\n                    <label><span>\u5b78\u865f</span><input name="student_id" required /></label>\n                    <label><span>\u5b78\u9662</span><input name="college" required /></label>\n                    <label><span>\u7cfb\u6240\uff0f\u5b78\u7a0b</span><input name="department" required /></label>\n                    <label><span>\u5b78\u5236</span><select name="degree_level"><option value="">\u8acb\u9078\u64c7</option><option value="\u5927\u5b78\u90e8">\u5927\u5b78\u90e8</option><option value="\u78a9\u58eb\u73ed">\u78a9\u58eb\u73ed</option><option value="\u535a\u58eb\u73ed">\u535a\u58eb\u73ed</option></select></label>\n                    <label><span>\u5e74\u7d1a</span><select name="year_level"><option value="">\u8acb\u9078\u64c7</option><option value="\u4e00\u5e74\u7d1a">\u4e00\u5e74\u7d1a</option><option value="\u4e8c\u5e74\u7d1a">\u4e8c\u5e74\u7d1a</option><option value="\u4e09\u5e74\u7d1a">\u4e09\u5e74\u7d1a</option><option value="\u56db\u5e74\u7d1a">\u56db\u5e74\u7d1a</option><option value="\u4e94\u5e74\u7d1a\u4ee5\u4e0a">\u4e94\u5e74\u7d1a\u4ee5\u4e0a</option></select></label>\n                    <label><span>\u96fb\u5b50\u90f5\u4ef6</span><input name="email" type="email" autocomplete="email" required /></label>\n                    <label><span>\u624b\u6a5f</span><input name="phone" type="tel" autocomplete="tel" required /></label>\n                  </div>\n                  <details class="sensitive-profile-fields">\n                    <summary><span><i data-lucide="lock-keyhole" aria-hidden="true"></i><strong>\u79c1\u5bc6\u8cc7\u6599</strong></span><i data-lucide="chevron-down" aria-hidden="true"></i></summary>\n                    <div class="application-profile-fields">\n                      <label><span>\u8eab\u5206\u8b49\u5b57\u865f</span><input name="id_number" autocomplete="off" /></label>\n                      <label><span>\u51fa\u751f\u65e5\u671f</span><input name="birth_date" type="date" autocomplete="bday" /></label>\n                      <label><span>\u8b77\u7167\u865f\u78bc</span><input name="passport_number" autocomplete="off" /></label>\n                      <label><span>\u901a\u8a0a\u5730\u5740</span><input name="mailing_address" autocomplete="street-address" /></label>\n                      <label><span>\u7dca\u6025\u806f\u7d61\u4eba</span><input name="emergency_contact" /></label>\n                      <label><span>\u7dca\u6025\u806f\u7d61\u96fb\u8a71</span><input name="emergency_phone" type="tel" /></label>\n                      <label><span>\u5bb6\u9577\uff0f\u76e3\u8b77\u4eba\u59d3\u540d</span><input name="guardian_name" /></label>\n                      <label><span>\u8207\u5b78\u751f\u95dc\u4fc2</span><input name="guardian_relation" /></label>\n                      <label><span>\u5bb6\u9577\uff0f\u76e3\u8b77\u4eba\u8eab\u5206\u8b49\u5b57\u865f</span><input name="guardian_id_number" autocomplete="off" /></label>\n                    </div>\n                  </details>\n                  <div class="application-memory-controls">\n                    <label class="application-memory-toggle" for="application-remember-profile"><input id="application-remember-profile" type="checkbox" /><span><strong>\u8a18\u4f4f\u5e38\u7528\u8cc7\u6599</strong><small>\u4e0b\u6b21\u81ea\u52d5\u5e36\u5165\uff0c\u79c1\u5bc6\u8cc7\u6599\u9664\u5916\u3002</small></span></label>\n                    <div><small id="application-profile-memory-status">\u50c5\u4fdd\u7559\u672c\u6b21\u4f7f\u7528</small><button id="clear-application-profile-memory" type="button" class="text-button"><i data-lucide="trash-2" aria-hidden="true"></i><span>\u6e05\u9664</span></button></div>\n                  </div>\n                  <div class="application-profile-actions"><button type="submit" class="primary-button"><i data-lucide="save" aria-hidden="true"></i><span>\u5132\u5b58\u8cc7\u6599</span></button></div>\n                </form>\n              </details>\n            </div>\n\n            <section class="application-requirement-catalog glass-panel" aria-labelledby="application-requirement-title">\n              <div class="concise-heading"><div><h3 id="application-requirement-title">\u7576\u671f\u6587\u4ef6\u8207\u5b98\u65b9\u8868\u683c</h3></div><span id="application-requirement-count" class="count-badge">\u8acb\u9078\u64c7\u5b78\u6821</span></div>\n              <p id="application-requirement-summary" class="application-requirement-summary">\u9078\u64c7\u76ee\u6a19\u5b78\u6821\u5f8c\uff0c\u6703\u4f9d\u5b78\u7cfb\u3001\u5e74\u5ea6\u8207\u68af\u6b21\u5217\u51fa\u6587\u4ef6\uff1b\u6c92\u6709\u78ba\u8a8d\u7684\u4efd\u6578\u6216\u8868\u683c\u4e0d\u6703\u88ab\u7576\u6210\u6b63\u5f0f\u7248\u672c\u3002</p>\n              <div id="application-requirement-list" class="application-requirement-list" aria-live="polite"><p class="workspace-empty">\u5c1a\u672a\u9078\u64c7\u76ee\u6a19\u5b78\u6821\u3002</p></div>\n            </section>\n\n            <section id="application-generation-gate" class="application-generation-gate glass-panel" aria-live="polite" hidden></section>\n\n            <div class="application-center-layout">\n              <section class="application-template-area" aria-labelledby="application-template-title">\n                <div class="concise-heading"><h3 id="application-template-title">\u53ef\u586b\u5beb\u7684\u6e96\u5099\u5de5\u5177</h3><span id="application-template-count" class="count-badge">--</span></div>\n                <label class="document-stage-control" for="application-document-stage"><span>\u5148\u770b\u9019\u500b\u968e\u6bb5</span><select id="application-document-stage" aria-describedby="document-stage-help"></select></label><p id="document-stage-help" class="application-template-note">\u53ef\u5207\u63db\u67e5\u770b\u5176\u4ed6\u968e\u6bb5\uff1b\u9019\u500b\u9078\u9805\u4e0d\u6703\u8b8a\u66f4\u4f60\u7684\u9304\u53d6\u6216\u9001\u4ef6\u72c0\u614b\u3002</p>\n                <p class="application-template-note">\u4ee5\u4e0b\u5de5\u5177\u7528\u4f86\u6574\u7406\u8349\u7a3f\u8207\u5217\u5370\uff0c\u4e0d\u4ee3\u8868\u7576\u671f\u6821\u65b9\u5fc5\u5099\u6587\u4ef6\uff1b\u8acb\u4ee5\u4e0a\u65b9\u5df2\u78ba\u8a8d\u7684\u5b98\u65b9\u898f\u5b9a\u70ba\u6e96\u3002</p>\n                <div id="application-template-list" class="application-template-list" aria-live="polite"><div class="skeleton skeleton-card"></div><div class="skeleton skeleton-card"></div></div>\n              </section>\n\n              <aside class="application-packet-panel glass-panel" aria-labelledby="application-packet-title">\n                <div class="packet-panel-heading"><span class="packet-panel-icon"><i data-lucide="files" aria-hidden="true"></i></span><div><span class="section-kicker">\u6574\u7406\u8207\u532f\u51fa</span><h3 id="application-packet-title">\u6211\u7684\u5217\u5370\u5305</h3></div><span id="application-packet-total" class="packet-total">0 \u4efd</span></div>\n                <p class="packet-panel-description">\u9078\u64c7\u8981\u532f\u51fa\u7684\u6587\u4ef6\uff0c\u586b\u5b8c\u4e26\u6838\u5c0d\u76ee\u524d\u7248\u672c\u5f8c\uff0c\u5373\u53ef\u6574\u7406\u6210\u4e00\u4efd PDF\u3002</p>\n                <div id="application-packet-progress" class="packet-progress" role="status"></div>\n                <div id="application-packet-list" class="application-packet-list"></div>\n                <div class="packet-panel-footer"><div id="application-packet-status" class="application-packet-status" role="status"></div>\n                <button id="download-application-packet" type="button" class="primary-button full-width"><i data-lucide="file-down" aria-hidden="true"></i><span>\u532f\u51fa\u5217\u5370\u5305 PDF</span></button></div>\n                <details class="application-compact-help"><summary><span><i data-lucide="pen-line" aria-hidden="true"></i>\u5217\u5370\u63d0\u9192</span><i data-lucide="chevron-down" aria-hidden="true"></i></summary><p>\u89aa\u7c3d\u8207\u6838\u7ae0\u8655\u6703\u4fdd\u7559\u7a7a\u767d\u3002</p></details>\n              </aside>\n            </div>\n          </section>\n\n          <section id="document-check" class="page-section document-check-section" data-university-page="document-check" aria-labelledby="document-check-title" hidden>\n            <header class="document-check-hero">\n              <div><h2 id="document-check-title">\u6587\u4ef6\u6aa2\u67e5</h2><p>\u627e\u51fa\u6f0f\u586b\u3001\u5b57\u6578\u8207\u7c3d\u540d\u98a8\u96aa\u3002</p></div>\n              <span aria-hidden="true"><i data-lucide="scan-search"></i></span>\n            </header>\n            <section id="document-check-gate" class="document-check-gate glass-panel" aria-live="polite"><div class="skeleton skeleton-card"></div></section>\n            <div id="document-check-content" class="document-check-layout" hidden>\n              <form id="document-check-form" class="document-check-form glass-panel">\n                <label class="document-upload" for="document-check-file">\n                  <input id="document-check-file" name="file" type="file" accept=".pdf,.docx,.txt,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain" required />\n                  <span class="document-upload-icon"><i data-lucide="file-up" aria-hidden="true"></i></span>\n                  <span><strong id="document-upload-title">\u9078\u64c7\u7533\u8acb\u6587\u4ef6</strong><small id="document-upload-meta">PDF\u3001DOCX \u6216 TXT\uff0c10 MB \u4ee5\u5167</small></span>\n                </label>\n                <div class="document-check-fields">\n                  <label><span>\u6587\u4ef6\u985e\u578b</span><select name="document_type"><option value="auto">\u81ea\u52d5\u5224\u65b7</option><option value="study_plan">\u8b80\u66f8\u8a08\u756b</option><option value="recommendation">\u63a8\u85a6\u4fe1</option><option value="resume">\u5c65\u6b77</option><option value="application_form">\u7533\u8acb\u8868</option><option value="other">\u5176\u4ed6\u6587\u4ef6</option></select></label>\n                  <label><span>\u5b57\u6578\u4e0a\u9650</span><input name="expected_word_limit" type="number" min="1" max="20000" placeholder="\u6c92\u6709\u53ef\u7559\u7a7a" /></label>\n                </div>\n                <label class="document-check-toggle"><input name="require_signature" type="checkbox" /><span><strong>\u9019\u4efd\u6587\u4ef6\u9700\u8981\u7c3d\u540d\u6216\u6838\u7ae0</strong></span></label>\n                <label class="document-check-toggle ai-consent is-paused"><input name="use_ai" type="checkbox" disabled /><span><strong>AI \u6df1\u5ea6\u6aa2\u67e5\u66ab\u7de9</strong><small>\u76ee\u524d\u53ea\u57f7\u884c\u975e AI \u898f\u5247\u6aa2\u67e5\uff1b\u4e0d\u6703\u628a\u6587\u5b57\u50b3\u7d66\u5916\u90e8 AI\uff0c\u4e5f\u4e0d\u6703\u555f\u52d5\u672c\u5730\u6a21\u578b\u3002</small></span></label>\n                <label class="document-check-toggle document-transfer-consent"><input id="document-check-consent" name="consent" type="checkbox" required /><span><strong>\u6211\u540c\u610f\u50b3\u9001\u9019\u4e00\u4efd\u6587\u4ef6\u9032\u884c\u672c\u6b21\u6aa2\u67e5</strong><small>\u53ea\u57f7\u884c\u672c\u6b21\u975e AI \u898f\u5247\u6aa2\u67e5\uff0c\u5b8c\u6210\u5f8c\u4e0d\u4fdd\u5b58\u539f\u6a94\uff1b\u767b\u5165\u4e0d\u4ee3\u8868\u540c\u610f\u50b3\u9001\uff0c\u63db\u6a94\u5f8c\u9700\u91cd\u65b0\u52fe\u9078\u3002</small></span></label>\n                <div id="document-check-status" class="form-status" role="status" aria-live="polite"></div>\n                <button id="document-check-submit" type="submit" class="primary-button full-width"><i data-lucide="scan-line" aria-hidden="true"></i><span>\u958b\u59cb\u6aa2\u67e5</span></button>\n                <a href="#writing-assistant" class="secondary-button full-width"><i data-lucide="languages" aria-hidden="true"></i><span>\u6587\u4ef6\u6539\u5beb\u66ab\u7de9\u8aaa\u660e</span></a>\n                <small class="document-privacy-note"><i data-lucide="shield-check" aria-hidden="true"></i>\u539f\u6a94\u4e0d\u6703\u4fdd\u5b58\uff0c\u4e5f\u4e0d\u6703\u4ee3\u66ff\u4f60\u9001\u4ef6\u3002</small>\n              </form>\n              <div id="document-check-result" class="document-check-result" aria-live="polite">\n                <div class="advisor-empty"><span><i data-lucide="file-check-2" aria-hidden="true"></i></span><strong>\u5c1a\u672a\u9078\u64c7\u6587\u4ef6</strong><small>\u6aa2\u67e5\u7d50\u679c\u6703\u4f9d\u91cd\u8981\u7a0b\u5ea6\u6392\u5217\u3002</small></div>\n              </div>\n            </div>\n          </section>\n\n          <section id="writing-assistant" class="page-section document-check-section writing-assistant-section" data-university-page="writing-assistant" aria-labelledby="writing-assistant-title" hidden>\n            <header class="document-check-hero writing-assistant-hero">\n              <div><h2 id="writing-assistant-title">\u6587\u4ef6\u6539\u5beb\u66ab\u7de9</h2><p>\u76ee\u524d\u4e0d\u9023\u63a5\u5916\u90e8 AI\uff0c\u4e5f\u4e0d\u6703\u555f\u52d5\u672c\u5730\u6a21\u578b\u3002</p></div>\n              <span aria-hidden="true"><i data-lucide="languages"></i></span>\n            </header>\n            <div class="document-check-layout">\n              <form id="writing-assistant-form" class="document-check-form writing-assistant-form glass-panel" aria-describedby="writing-assistant-status">\n                <label class="advisor-question-field"><span>\u5b78\u751f\u539f\u6587</span><textarea name="text" minlength="20" maxlength="16000" rows="10" placeholder="\u672c\u5730 AI \u74b0\u5883\u5b8c\u6210\u5f8c\u624d\u6703\u958b\u653e" disabled></textarea></label>\n                <div class="document-check-fields">\n                  <label><span>\u8981\u600e\u9ebc\u8abf\u6574</span><select name="action" disabled><option value="formalize">\u6b63\u5f0f\u8a9e\u6c23</option><option value="translate_en">\u7ffb\u6210\u82f1\u6587</option><option value="shorten">\u58d3\u7e2e\u5b57\u6578</option><option value="grammar">\u6587\u6cd5\u8207\u7528\u5b57</option></select></label>\n                  <label><span>\u6587\u4ef6\u985e\u578b</span><select name="document_type" disabled><option value="study_plan">\u8b80\u66f8\u8a08\u756b</option><option value="motivation">\u7533\u8acb\u52d5\u6a5f</option><option value="resume">\u5c65\u6b77</option><option value="email">\u96fb\u5b50\u90f5\u4ef6</option><option value="other">\u5176\u4ed6</option></select></label>\n                  <label><span>\u76ee\u6a19\u5b57\u6578</span><input name="target_word_limit" type="number" min="20" max="5000" placeholder="\u9700\u8981\u7cbe\u7c21\u6642\u586b\u5beb" disabled /></label>\n                  <label><span>\u76ee\u6a19\u5b78\u6821\uff0f\u8ab2\u7a0b</span><input name="school_context" maxlength="500" placeholder="\u9078\u586b\uff0c\u53ea\u4f5c\u8a9e\u5883\u53c3\u8003" disabled /></label>\n                </div>\n                <div id="writing-assistant-status" class="form-status" role="status" aria-live="polite">AI \u529f\u80fd\u66ab\u7de9\uff0c\u73fe\u5728\u7121\u6cd5\u9001\u51fa\u6587\u5b57\u3002</div>\n                <button id="writing-assistant-submit" type="submit" class="primary-button full-width" disabled><i data-lucide="pause-circle" aria-hidden="true"></i><span>\u7b49\u5f85\u672c\u5730 AI \u74b0\u5883</span></button>\n                <small class="document-privacy-note"><i data-lucide="shield-check" aria-hidden="true"></i>\u9801\u9762\u4e0d\u6703\u9001\u51fa\u6216\u4fdd\u5b58\u4f60\u8f38\u5165\u7684\u6587\u5b57\u3002</small>\n              </form>\n              <div id="writing-assistant-result" class="document-check-result writing-assistant-result" aria-live="polite">\n                <div class="advisor-empty"><span><i data-lucide="hard-drive" aria-hidden="true"></i></span><strong>\u672c\u5730 AI \u5c1a\u672a\u8a2d\u5b9a</strong><small>\u5b8c\u6210\u672c\u6a5f\u74b0\u5883\u8207\u96b1\u79c1\u9a57\u8b49\u5f8c\uff0c\u518d\u53e6\u884c\u958b\u653e\u9019\u9805\u529f\u80fd\u3002</small></div>\n              </div>\n            </div>\n          </section>\n\n          <section id="application-form-page" class="page-section application-form-page" data-university-page="application-form" aria-labelledby="application-form-title" hidden>\n            <header class="application-form-header">\n              <div><span id="application-form-stage" class="section-kicker">\u7533\u8acb\u6587\u4ef6</span><h2 id="application-form-title">\u6587\u4ef6\u540d\u7a31</h2></div>\n              <span id="application-form-official-badge" class="application-official-badge"></span>\n            </header>\n            <div id="document-workbench" class="document-workbench">\n            <p id="document-workbench-context" class="document-workbench-context"></p>\n            <section id="document-flow" class="document-flow" aria-labelledby="document-flow-title">\n              <div class="document-flow-heading"><h3 id="document-flow-title">\u9019\u4efd\u6587\u4ef6\u4e00\u8def\u5b8c\u6210</h3><p id="document-flow-note"></p></div>\n              <ol id="document-flow-steps" class="document-flow-steps"></ol>\n              <div class="document-flow-actions"><button id="document-flow-next" type="button" class="primary-button"></button><button id="document-flow-skip" type="button" class="text-button" hidden>\u7565\u904e\u9019\u4e00\u6b65</button></div>\n              <p class="document-flow-boundary">\u5b8c\u6210\u6bcf\u4e00\u6b65\u53ea\u4ee3\u8868\u4f60\u81ea\u5df1\u7684\u6e96\u5099\u9032\u5ea6\uff1b\u4e0b\u8f09\u3001\u4fdd\u5b58\u6216\u6a19\u793a\u5df2\u5b8c\u6210\u90fd\u4e0d\u4ee3\u8868\u5df2\u9001\u4ef6\u3001\u6821\u65b9\u53d7\u7406\u6216\u9304\u53d6\u3002</p>\n            </section>\n            <nav class="document-workbench-tabs" role="tablist" aria-label="\u9019\u4efd\u6587\u4ef6\u7684\u5de5\u4f5c\u5340">\n              <button id="document-tab-edit" type="button" role="tab" aria-controls="document-pane-edit" aria-selected="true" data-document-tab="edit"><i data-lucide="file-pen-line" aria-hidden="true"></i>\u586b\u5beb\u8207\u6838\u5c0d</button>\n              <button id="document-tab-check" type="button" role="tab" aria-controls="document-pane-check" aria-selected="false" tabindex="-1" data-document-tab="check"><i data-lucide="scan-search" aria-hidden="true"></i>\u6aa2\u67e5\u6210\u54c1</button>\n              <button id="document-tab-vault" type="button" role="tab" aria-controls="document-pane-vault" aria-selected="false" tabindex="-1" data-document-tab="vault"><i data-lucide="file-lock-2" aria-hidden="true"></i>\u79c1\u4eba\u4fdd\u5b58</button>\n              <button id="document-tab-source" type="button" role="tab" aria-controls="document-pane-source" aria-selected="false" tabindex="-1" data-document-tab="source"><i data-lucide="send" aria-hidden="true"></i>\u4f86\u6e90\u8207\u9001\u4ef6</button>\n            </nav>\n            <div id="document-pane-edit" class="application-form-layout" role="tabpanel" aria-labelledby="document-tab-edit" data-document-pane="edit">\n              <form id="application-document-form" class="application-document-form" novalidate>\n                <div id="application-autofill-status" class="application-autofill-status" role="status" aria-live="polite" hidden></div>\n                <div id="application-draft-sync-status" class="application-draft-sync-status" role="status" aria-live="polite"></div>\n                <div id="application-document-fields" class="application-document-fields"></div>\n                <section id="application-review-preview" class="application-review-preview" aria-labelledby="application-review-preview-title" aria-live="polite"></section>\n                <div id="application-document-form-status" class="form-status" role="status" aria-live="polite"></div>\n                <p class="application-form-status-boundary">\u586b\u5b8c\u4e26\u6838\u5c0d\u5f8c\u53ef\u4e0b\u8f09\u8349\u7a3f\uff1b\u4e0b\u8f09\u8207\u5217\u5370\u4e0d\u4ee3\u8868\u5df2\u9001\u4ef6\u3001\u6821\u65b9\u53d7\u7406\u6216\u9304\u53d6\u3002</p>\n                <div class="application-document-actions">\n                  <button type="submit" class="secondary-button"><i data-lucide="save" aria-hidden="true"></i><span>\u5132\u5b58</span></button>\n                  <button id="download-single-application-document" type="button" class="primary-button"><i data-lucide="file-down" aria-hidden="true"></i><span>\u4e0b\u8f09 PDF</span></button>\n                </div>\n              </form>\n            </div>\n            <div id="document-pane-check" role="tabpanel" aria-labelledby="document-tab-check" data-document-pane="check" hidden>\n              <div class="document-workbench-handoff"><p id="document-generated-check-note"></p><button type="button" class="secondary-button" data-check-generated-document hidden>\u4f7f\u7528\u525b\u4e0b\u8f09\u7684 PDF</button></div>\n            </div>\n            <div id="document-pane-vault" role="tabpanel" aria-labelledby="document-tab-vault" data-document-pane="vault" hidden>\n              <p class="document-workbench-vault-note">\u9019\u88e1\u662f\u4f60\u7684\u500b\u4eba\u6587\u4ef6\u5eab\uff0c\u5305\u542b\u4e0d\u540c\u7533\u8acb\u7684\u6a94\u6848\u3002\u8acb\u6838\u5c0d\u540d\u7a31\u8207\u7248\u672c\uff1b\u4fdd\u5b58\u4e0d\u4ee3\u8868\u5df2\u9001\u4ef6\u3002</p>\n            </div>\n            <div id="document-pane-source" role="tabpanel" aria-labelledby="document-tab-source" data-document-pane="source" hidden>\n              <aside class="application-form-guide glass-panel">\n                <details class="application-compact-help"><summary><span><i data-lucide="circle-help" aria-hidden="true"></i>\u586b\u5beb\u8aaa\u660e</span><i data-lucide="chevron-down" aria-hidden="true"></i></summary><p id="application-form-description"></p></details>\n                <div id="application-form-print-guide"></div>\n                <a id="application-form-source" href="#" target="_blank" rel="noreferrer"><i data-lucide="external-link" aria-hidden="true"></i><span>\u5b98\u65b9\u4f86\u6e90</span></a>\n              </aside>\n            </div>\n            </div>\n          </section>\n\n          <dialog id="application-file-consent-dialog" class="application-file-consent-dialog">\n            <form id="application-file-consent-form" method="dialog" novalidate>\n              <header><span><i data-lucide="file-lock-2" aria-hidden="true"></i></span><div><small>\u654f\u611f\u6a94\u6848\u9010\u6a94\u540c\u610f</small><h3>\u9078\u64c7\u662f\u5426\u8de8\u88dd\u7f6e\u4fdd\u5b58</h3></div><button type="button" class="icon-button" data-close-application-file-consent aria-label="\u95dc\u9589"><i data-lucide="x" aria-hidden="true"></i></button></header>\n              <div class="application-file-consent-summary"><strong id="application-file-consent-name">\u5c1a\u672a\u9078\u64c7\u6a94\u6848</strong><small id="application-file-consent-context"></small></div>\n              <p class="application-file-consent-boundary">\u9019\u500b\u6a94\u6848\u76ee\u524d\u53ea\u5b58\u5728\u672c\u6b21\u700f\u89bd\u5668\u5206\u9801\u3002\u767b\u5165\u4e0d\u4ee3\u8868\u540c\u610f\u4e0a\u50b3\uff1b\u53ea\u6709\u5b8c\u6210\u4e0b\u5217\u9078\u64c7\u4e26\u52fe\u9078\u540c\u610f\u5f8c\uff0c\u624d\u6703\u52a0\u5bc6\u4fdd\u5b58\u3002</p>\n              <div class="application-file-consent-fields">\n                <label><span>\u4fdd\u5b58\u76ee\u7684</span><select name="purpose" required><option value="application_preparation">\u6e96\u5099\u8207\u6838\u5c0d\u9019\u4efd\u7533\u8acb</option><option value="cross_device_access">\u8de8\u88dd\u7f6e\u7e7c\u7e8c\u4f7f\u7528</option></select></label>\n                <label><span>\u4fdd\u5b58\u671f\u9650</span><select name="retention_days" required><option value="30">30 \u5929</option><option value="90">90 \u5929</option><option value="180">180 \u5929</option><option value="365">365 \u5929</option></select></label>\n              </div>\n              <label class="application-file-consent-check"><input name="consent" type="checkbox" required /><span><strong>\u6211\u540c\u610f\u4f9d\u4e0a\u8ff0\u76ee\u7684\u8207\u671f\u9650\uff0c\u52a0\u5bc6\u4fdd\u5b58\u9019\u4e00\u500b\u6a94\u6848</strong><small>\u4e0d\u540c\u6a94\u6848\u3001\u65b0\u7248\u672c\u90fd\u8981\u91cd\u65b0\u540c\u610f\uff1b\u4e0d\u5305\u542b\u516c\u958b\u5206\u4eab\u3001\u63d0\u4f9b\u6821\u65b9\u3001\u793e\u7fa4\u5f15\u7528\u6216 AI \u8a13\u7df4\u3002</small></span></label>\n              <div id="application-file-consent-status" class="form-status" role="status" aria-live="polite"></div>\n              <footer><button type="button" class="secondary-button" data-close-application-file-consent>\u7dad\u6301\u672c\u6b21\u4f7f\u7528</button><button type="submit" class="primary-button"><i data-lucide="lock-keyhole" aria-hidden="true"></i><span>\u540c\u610f\u4e26\u52a0\u5bc6\u4fdd\u5b58</span></button></footer>\n            </form>\n          </dialog>\n\n          <dialog id="application-download-dialog" class="application-file-consent-dialog application-download-dialog" aria-labelledby="application-download-title">\n            <section>\n              <header><span><i data-lucide="file-check-2" aria-hidden="true"></i></span><div><small>PDF \u5df2\u7522\u751f\u4e26\u4e0b\u8f09</small><h3 id="application-download-title">\u5217\u5370\u8207\u9001\u4ef6\u524d\u78ba\u8a8d</h3></div><button type="button" class="icon-button" data-close-application-download aria-label="\u95dc\u9589"><i data-lucide="x" aria-hidden="true"></i></button></header>\n              <div id="application-download-stats" class="application-download-stats"></div>\n              <ol id="application-download-list" class="application-download-list"></ol>\n              <p class="application-download-privacy"><i data-lucide="shield-check" aria-hidden="true"></i><span><strong>\u4f3a\u670d\u5668\u4e0d\u6703\u6c38\u4e45\u4fdd\u5b58\u9019\u6b21\u7522\u751f\u7684 PDF</strong><small>\u6a94\u6848\u76ee\u524d\u53ea\u4e0b\u8f09\u5230\u4f60\u7684\u88dd\u7f6e\u4e26\u66ab\u7559\u65bc\u9019\u500b\u700f\u89bd\u5668\u5206\u9801\uff1b\u82e5\u8981\u8de8\u88dd\u7f6e\u4fdd\u5b58\uff0c\u5fc5\u9808\u5230\u79c1\u4eba\u6587\u4ef6\u5eab\u53e6\u5916\u9078\u64c7\u76ee\u7684\u3001\u671f\u9650\u4e26\u540c\u610f\u3002</small></span></p>\n              <footer><button type="button" class="secondary-button" data-close-application-download>\u95dc\u9589</button><button type="button" class="secondary-button" data-generated-document-action="check" hidden>\u6aa2\u67e5\u9019\u4efd PDF</button><button type="button" class="secondary-button" data-generated-document-action="vault" hidden>\u8a2d\u5b9a\u79c1\u4eba\u4fdd\u5b58</button><button type="button" class="primary-button" data-download-application-again><i data-lucide="download" aria-hidden="true"></i><span>\u518d\u6b21\u4e0b\u8f09 PDF</span></button></footer>\n            </section>\n          </dialog>\n\n          <section id="documents" class="page-section" data-university-page="documents" aria-labelledby="documents-title" hidden>\n            <div class="section-heading"><div><h2 id="documents-title">\u6587\u4ef6\u91cd\u9ede\u6574\u7406</h2></div><span class="count-badge" id="document-count">--</span></div>\n            <section id="private-vault" class="private-vault glass-panel" aria-labelledby="private-vault-title">\n              <header class="private-vault-header">\n                <span class="private-vault-mark"><i data-lucide="shield-check" aria-hidden="true"></i></span>\n                <div><h3 id="private-vault-title">\u52a0\u5bc6\u79c1\u4eba\u6587\u4ef6\u5eab</h3><p>\u8de8\u88dd\u7f6e\u4fdd\u5b58\u7533\u8acb\u6a94\u6848\uff1b\u6bcf\u4e00\u500b\u6a94\u6848\u8207\u65b0\u7248\u672c\u90fd\u8981\u53e6\u5916\u540c\u610f\u3002</p></div>\n                <span id="private-vault-usage" class="private-vault-usage"></span>\n              </header>\n              <div id="generated-vault-candidate" class="generated-vault-candidate" hidden></div>\n              <div id="private-vault-gate" class="private-vault-gate"></div>\n              <div id="private-vault-content" class="private-vault-content" hidden>\n                <form id="private-vault-form" class="private-vault-form" novalidate>\n                  <div class="private-vault-form-heading"><div><strong id="private-vault-form-title">\u4fdd\u5b58\u65b0\u6587\u4ef6</strong><small id="private-vault-form-note">\u9078\u64c7\u6a94\u6848\u5f8c\u4ecd\u9808\u52fe\u9078\u672c\u6b21\u4fdd\u5b58\u540c\u610f\u3002</small></div><button id="private-vault-cancel-version" type="button" class="text-button" hidden>\u53d6\u6d88\u65b0\u589e\u7248\u672c</button></div>\n                  <label class="vault-file-picker" for="private-vault-file"><input id="private-vault-file" name="file" type="file" accept=".pdf,.docx,.txt,.jpg,.jpeg,.png,.webp,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain,image/jpeg,image/png,image/webp" /><i data-lucide="file-lock-2" aria-hidden="true"></i><span><strong id="private-vault-file-name">\u9078\u64c7\u79c1\u4eba\u6587\u4ef6</strong><small id="private-vault-file-meta">PDF\u3001DOCX\u3001TXT\u3001JPG\u3001PNG \u6216 WebP\uff0c20 MB \u4ee5\u5167</small></span></label>\n                  <div class="private-vault-fields">\n                    <label><span>\u6587\u4ef6\u540d\u7a31</span><input id="private-vault-label" name="label" type="text" minlength="2" maxlength="100" placeholder="\u4f8b\u5982\uff1a\u6821\u5167\u4ea4\u63db\u7533\u8acb\u8868" required /></label>\n                    <label><span>\u6587\u4ef6\u985e\u578b</span><select id="private-vault-category" name="category" required><option value="application_form">\u7533\u8acb\u8868</option><option value="generated_packet">\u7cfb\u7d71\u7522\u751f\u7684\u5217\u5370\u5305</option><option value="passport">\u8b77\u7167</option><option value="transcript">\u6210\u7e3e\u55ae</option><option value="student_id">\u5b78\u751f\u8b49</option><option value="financial_proof">\u8ca1\u529b\u8b49\u660e</option><option value="recommendation">\u63a8\u85a6\u4fe1</option><option value="study_plan">\u8b80\u66f8\u8a08\u756b</option><option value="other">\u5176\u4ed6</option></select></label>\n                    <label><span>\u4fdd\u5b58\u76ee\u7684</span><select name="purpose" required><option value="application_preparation">\u6e96\u5099\u8207\u6838\u5c0d\u7533\u8acb</option><option value="cross_device_access">\u8de8\u88dd\u7f6e\u5b58\u53d6</option><option value="generated_packet_backup">\u5099\u4efd\u7cfb\u7d71\u7522\u751f\u7684\u5217\u5370\u5305</option></select></label>\n                    <label><span>\u4fdd\u5b58\u671f\u9650</span><select name="retention_days" required><option value="30">30 \u5929</option><option value="90">90 \u5929</option><option value="180">180 \u5