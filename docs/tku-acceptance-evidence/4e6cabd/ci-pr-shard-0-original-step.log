" class="secondary-button">\u5148\u770b\u770b\u5168\u90e8\u4ea4\u63db\u5b78\u6821</button>\n          <button id="confirm-school" type="button" class="primary-button">\n            <span>\u9078\u64c7\u6211\u7684\u5b78\u6821</span><i data-lucide="arrow-right" aria-hidden="true"></i>\n          </button>\n        </div>\n        <small class="privacy-note"><i data-lucide="shield-check" aria-hidden="true"></i>\u700f\u89bd\u516c\u958b\u8cc7\u6599\u4e0d\u9700\u8981\u767b\u5165\uff1b\u6536\u85cf\u3001\u9032\u5ea6\u8207\u793e\u7fa4\u529f\u80fd\u624d\u9700\u8981\u5e33\u865f\u3002</small>\n      </div>\n    </section>\n\n    <section id="auth-dialog" class="account-dialog" role="dialog" aria-modal="true" aria-labelledby="auth-title" hidden>\n      <button type="button" class="dialog-backdrop" data-close-auth aria-label="\u95dc\u9589\u767b\u5165\u8996\u7a97"></button>\n      <div class="account-dialog-shell">\n        <button type="button" class="icon-button dialog-close" data-close-auth aria-label="\u95dc\u9589"><i data-lucide="x" aria-hidden="true"></i></button>\n        <div class="account-dialog-intro">\n          <span class="platform-mark" aria-hidden="true"><img src="/static/assets/brand/uniway-mark.webp?v=20261004-logo-2" alt="" width="48" height="48" decoding="async" /></span>\n          <div><span class="eyebrow">UniWay \u5e33\u865f</span><h1 id="auth-title">\u628a\u7533\u8acb\u9032\u5ea6\u5e36\u8457\u8d70</h1><p>\u767b\u5165\u4ee5\u4fdd\u5b58\u6536\u85cf\u8207\u7533\u8acb\u9032\u5ea6\u3002</p></div>\n        </div>\n        <details class="discovery-recents" data-discovery-recents hidden></details>\n        <div class="auth-mode-switch" role="tablist" aria-label="\u767b\u5165\u6216\u5efa\u7acb\u5e33\u865f">\n          <button type="button" role="tab" aria-selected="true" data-auth-mode="login">\u767b\u5165</button>\n          <button type="button" role="tab" aria-selected="false" data-auth-mode="register">\u5efa\u7acb\u5e33\u865f</button>\n        </div>\n        <div class="terms-consent-row">\n          <label class="terms-consent"><input type="checkbox" id="terms-consent" data-terms-version="2026-10-08" aria-describedby="terms-consent-hint" /><span>\u6211\u5df2\u95b1\u8b80\u4e26\u540c\u610f<a href="/terms" target="_blank" rel="noopener">\u4f7f\u7528\u689d\u6b3e</a>\u8207<a href="/privacy" target="_blank" rel="noopener">\u96b1\u79c1\u6b0a\u653f\u7b56</a>\uff08\u65b0\u8996\u7a97\u958b\u555f\uff09</span></label>\n          <p id="terms-consent-hint" class="terms-consent-hint" role="alert" hidden>\u5efa\u7acb\u5e33\u865f\u6216\u767b\u5165\u524d\uff0c\u8acb\u5148\u52fe\u9078\u540c\u610f\u3002</p>\n        </div>\n        <div id="oauth-provider-list" class="oauth-provider-list" aria-label="\u5feb\u901f\u767b\u5165\u65b9\u5f0f">\n          <button type="button" class="oauth-button" data-oauth-provider="google"><span class="provider-mark google-mark">G</span><span>\u4f7f\u7528 Google \u7e7c\u7e8c</span></button>\n          <button type="button" class="oauth-button" data-oauth-provider="facebook"><span class="provider-mark facebook-mark">f</span><span>\u4f7f\u7528 Facebook \u7e7c\u7e8c</span></button>\n          <button type="button" class="oauth-button" data-oauth-provider="apple" disabled><i data-lucide="apple" aria-hidden="true"></i><span>\u4f7f\u7528 Apple \u7e7c\u7e8c</span><small>\u884c\u52d5\u7248</small></button>\n        </div>\n        <small id="oauth-verification-note" class="oauth-verification-note"><i data-lucide="badge-check" aria-hidden="true"></i>\u7528\u5b78\u6821\u7684 Google \u4fe1\u7bb1\uff08\u4f8b\u5982 @cgu.edu.tw\u3001@gm.ntpu.edu.tw\uff09\u767b\u5165\uff0c\u6703\u81ea\u52d5\u5e36\u5165\u4f60\u7684\u5b78\u6821\uff1b\u7528\u4e00\u822c Gmail \u767b\u5165\u5f8c\u518d\u9078\u5b78\u6821\u3002\u700f\u89bd\u5b78\u6821\u8cc7\u8a0a\u4e0d\u9700\u8981\u767b\u5165\u3002</small>\n        <div class="auth-divider"><span>\u6216\u4f7f\u7528 \u96fb\u5b50\u90f5\u4ef6</span></div>\n        <form id="login-form" class="account-form">\n          <label><span>\u96fb\u5b50\u90f5\u4ef6</span><input name="email" type="email" autocomplete="email" required placeholder="student@example.com" /></label>\n          <label><span>\u5bc6\u78bc</span><input name="password" type="password" autocomplete="current-password" minlength="8" required placeholder="\u81f3\u5c11 8 \u500b\u5b57\u5143" /></label>\n          <div class="form-status" role="status"></div>\n          <button type="submit" class="primary-button full-width"><span>\u767b\u5165</span><i data-lucide="arrow-right" aria-hidden="true"></i></button>\n        </form>\n        <form id="register-form" class="account-form register-flow" hidden>\n          <section id="registration-account-step" class="registration-account-step" aria-labelledby="registration-account-title">\n            <div class="verification-heading">\n              <span class="verification-step-number">1</span>\n              <div><strong id="registration-account-title">\u5efa\u7acb\u4e00\u822c\u5e33\u865f</strong><small>\u5b8c\u6210 \u96fb\u5b50\u90f5\u4ef6 \u9a57\u8b49\u5f8c\u53ef\u6536\u85cf\u3001\u5efa\u7acb\u8a08\u756b\u53ca\u53c3\u8207\u516c\u5171\u793e\u7fa4\u3002</small></div>\n            </div>\n            <label><span>\u516c\u958b\u66b1\u7a31</span><input name="display_name" autocomplete="nickname" minlength="2" maxlength="30" required placeholder="\u4f8b\u5982\uff1a\u6e96\u5099\u53bb\u65e5\u672c\u7684\u5c0f\u6797" /></label>\n            <label><span>\u96fb\u5b50\u90f5\u4ef6</span><input id="registration-email" name="email" type="email" autocomplete="email" required placeholder="student@example.com" /></label>\n            <div class="email-verification-control">\n              <button id="request-email-verification" type="button" class="secondary-button"><i data-lucide="mail-check" aria-hidden="true"></i><span>\u5bc4\u9001 \u96fb\u5b50\u90f5\u4ef6 \u9a57\u8b49\u78bc</span></button>\n              <div id="email-verification-step" class="email-verification-code" hidden>\n                <label><span>\u516d\u4f4d\u6578\u9a57\u8b49\u78bc</span><input id="email-verification-code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" placeholder="000000" /></label>\n                <button id="confirm-email-verification" type="button" class="secondary-button"><span>\u78ba\u8a8d\u9a57\u8b49\u78bc</span></button>\n              </div>\n              <input name="email_verification_token" type="hidden" />\n              <div id="email-verification-status" class="form-status" role="status" aria-live="polite"></div>\n            </div>\n            <label><span>\u5bc6\u78bc</span><input name="password" type="password" autocomplete="new-password" minlength="8" required placeholder="\u81f3\u5c11 8 \u500b\u5b57\u5143" /></label>\n            <label class="consent-row"><input name="accept_terms" type="checkbox" required /><span>\u6211\u540c\u610f\u793e\u7fa4\u898f\u7bc4\uff0c\u4e26\u77e5\u9053\u516c\u958b\u767c\u6587\u4e0d\u53ef\u7559\u4e0b\u500b\u4eba\u806f\u7d61\u65b9\u5f0f\u3002</span></label>\n            <div class="form-status" role="status"></div>\n            <button type="submit" class="primary-button full-width" disabled><span>\u5b8c\u6210 \u96fb\u5b50\u90f5\u4ef6 \u9a57\u8b49\u5f8c\u5efa\u7acb\u5e33\u865f</span><i data-lucide="arrow-right" aria-hidden="true"></i></button>\n          </section>\n        </form>\n        <small class="account-privacy"><i data-lucide="shield-check" aria-hidden="true"></i>\u96fb\u5b50\u90f5\u4ef6 \u4e0d\u6703\u986f\u793a\u5728\u516c\u958b\u8cbc\u6587\u4e2d\u3002</small>\n      </div>\n    </section>\n\n    <section id="notification-dialog" class="account-dialog notification-dialog" role="dialog" aria-modal="true" aria-labelledby="notification-title" hidden>\n      <button type="button" class="dialog-backdrop" data-close-notifications aria-label="\u95dc\u9589\u901a\u77e5\u4e2d\u5fc3"></button>\n      <div class="account-dialog-shell notification-dialog-shell">\n        <button type="button" class="icon-button dialog-close" data-close-notifications aria-label="\u95dc\u9589"><i data-lucide="x" aria-hidden="true"></i></button>\n        <div class="notification-dialog-heading">\n          <div><span class="eyebrow">\u7533\u8acb\u6642\u7a0b</span><h1 id="notification-title">\u901a\u77e5\u4e2d\u5fc3</h1><p>\u7d19\u672c\u9001\u4ef6\u4ee5\u9001\u9054\u65e5\u8a08\u7b97\u3002</p></div>\n          <button id="notification-read-all" type="button" class="text-action">\u5168\u90e8\u6a19\u70ba\u5df2\u8b80</button>\n        </div>\n        <div id="notification-center-status" class="notification-center-status" role="status" aria-live="polite"></div>\n        <div id="notification-center-list" class="notification-center-list"></div>\n        <p class="notification-center-note"><i data-lucide="shield-check" aria-hidden="true"></i><span>\u96fb\u5b50\u90f5\u4ef6 \u53ea\u6709\u5728\u500b\u4eba\u8a2d\u5b9a\u660e\u78ba\u958b\u555f\u5f8c\u624d\u6703\u5bc4\u9001\uff1b\u884c\u52d5\u88dd\u7f6e\u63a8\u64ad\u4ecd\u4fdd\u6301\u95dc\u9589\u3002</span></p>\n      </div>\n    </section>\n\n    <section id="profile-dialog" class="account-dialog" role="dialog" aria-modal="true" aria-labelledby="profile-title" hidden>\n      <button type="button" class="dialog-backdrop" data-close-profile aria-label="\u95dc\u9589\u500b\u4eba\u8a2d\u5b9a"></button>\n      <div class="account-dialog-shell profile-dialog-shell">\n        <button type="button" class="icon-button dialog-close" data-close-profile aria-label="\u95dc\u9589"><i data-lucide="x" aria-hidden="true"></i></button>\n        <div class="profile-heading"><span id="profile-avatar" class="profile-avatar"><i data-lucide="user-round" aria-hidden="true"></i></span><div><span class="eyebrow">\u6211\u7684\u5e33\u865f</span><h1 id="profile-title">\u500b\u4eba\u8a2d\u5b9a</h1><p id="profile-email"></p></div></div>\n        <details class="discovery-recents" data-discovery-recents hidden></details>\n        <div id="profile-entitlement-status" class="profile-entitlement-status" hidden></div>\n        <div id="profile-verification-summary" class="profile-verification-summary" aria-live="polite"></div>\n        <section id="profile-email-verification" class="profile-email-verification" hidden>\n          <p><strong>\u5b8c\u6210 \u96fb\u5b50\u90f5\u4ef6 \u9a57\u8b49\u5f8c\u624d\u80fd\u5728\u516c\u5171\u677f\u767c\u6587\u6216\u7559\u8a00\u3002</strong><span id="profile-email-verification-address"></span></p>\n          <button id="request-profile-email-verification" type="button" class="secondary-button"><i data-lucide="mail-check" aria-hidden="true"></i><span>\u5bc4\u9001\u9a57\u8b49\u78bc</span></button>\n          <div id="profile-email-verification-step" class="email-verification-code" hidden>\n            <label><span>\u516d\u4f4d\u6578\u9a57\u8b49\u78bc</span><input id="profile-email-verification-code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" /></label>\n            <button id="confirm-profile-email-verification" type="button" class="secondary-button">\u78ba\u8a8d</button>\n          </div>\n          <div id="profile-email-verification-status" class="form-status" role="status"></div>\n        </section>\n        <form id="profile-form" class="account-form profile-form">\n          <label><span>\u516c\u958b\u66b1\u7a31</span><input name="display_name" minlength="2" maxlength="30" required /></label>\n          <label><span>\u76ee\u524d\u5c31\u8b80\u5b78\u6821</span><input name="home_university" maxlength="80" value="\u9577\u5e9a\u5927\u5b78" aria-describedby="profile-school-note" /><small id="profile-school-note"></small></label>\n          <label><span>\u76ee\u6a19\u570b\u5bb6</span><input name="target_countries" maxlength="160" placeholder="\u65e5\u672c\u3001\u5fb7\u570b\u3001\u6fb3\u6d32" /><small>\u4ee5\u9813\u865f\u6216\u9017\u865f\u5206\u9694</small></label>\n          <label><span>\u76ee\u524d\u968e\u6bb5</span><select name="application_stage"><option value="exploring">\u63a2\u7d22\u5b78\u6821</option><option value="eligibility">\u78ba\u8a8d\u8cc7\u683c</option><option value="documents">\u6e96\u5099\u6587\u4ef6</option><option value="submitted">\u5df2\u9001\u51fa\u7533\u8acb</option><option value="accepted">\u6e96\u5099\u51fa\u767c</option><option value="abroad">\u6b63\u5728\u6d77\u5916</option><option value="returned">\u5df2\u5b8c\u6210\u4ea4\u63db</option></select></label>\n          <fieldset class="profile-notification-settings">\n            <legend>\u63d0\u9192\u8207\u901a\u77e5</legend>\n            <label class="consent-row"><input name="web_notifications" type="checkbox" /><span>Web \u7ad9\u5167\u622a\u6b62\u63d0\u9192</span></label>\n            <label class="consent-row"><input name="email_notifications" type="checkbox" /><span>\u96fb\u5b50\u90f5\u4ef6 \u622a\u6b62\u63d0\u9192\uff08\u9078\u64c7\u52a0\u5165\uff09</span></label>\n            <label class="consent-row"><input name="content_updates" type="checkbox" /><span>\u5b98\u65b9\u898f\u5b9a\u8207\u6587\u4ef6\u66f4\u65b0\u63d0\u9192</span></label>\n            <span class="profile-setting-label">\u622a\u6b62\u524d\u63d0\u9192\u65e5</span>\n            <div class="profile-reminder-days"><label><input name="reminder_days" type="checkbox" value="30" /><span>30 \u5929</span></label><label><input name="reminder_days" type="checkbox" value="14" /><span>14 \u5929</span></label><label><input name="reminder_days" type="checkbox" value="7" /><span>7 \u5929</span></label><label><input name="reminder_days" type="checkbox" value="3" /><span>3 \u5929</span></label><label><input name="reminder_days" type="checkbox" value="1" /><span>1 \u5929</span></label></div>\n            <small>\u96fb\u5b50\u90f5\u4ef6 \u9810\u8a2d\u95dc\u9589\uff0c\u53ea\u6709\u52fe\u9078\u4e26\u5132\u5b58\u5f8c\u624d\u6392\u5165\u5bc4\u9001\uff1b\u53ef\u96a8\u6642\u95dc\u9589\u3002\u884c\u52d5\u88dd\u7f6e\u63a8\u64ad\u4ecd\u4fdd\u6301\u95dc\u9589\u3002</small>\n          </fieldset>\n          <div class="form-status" role="status"></div>\n          <button type="submit" class="primary-button full-width"><i data-lucide="save" aria-hidden="true"></i><span>\u5132\u5b58\u8a2d\u5b9a</span></button>\n        </form>\n        <div class="profile-account-actions"><button id="logout-button" type="button" class="secondary-button"><i data-lucide="log-out" aria-hidden="true"></i><span>\u767b\u51fa</span></button><button id="delete-account-button" type="button" class="text-action danger"><i data-lucide="trash-2" aria-hidden="true"></i><span>\u522a\u9664\u5e33\u865f</span></button></div>\n      </div>\n    </section>\n\n    <dialog id="workflow-issue-report-dialog" class="application-file-consent-dialog workflow-issue-report-dialog" aria-labelledby="workflow-issue-report-title">\n      <form id="workflow-issue-report-form" novalidate>\n        <header>\n          <span><i data-lucide="message-square-warning" aria-hidden="true"></i></span>\n          <div><small>\u5df2\u9a57\u8b49\u5b78\u751f\u56de\u5831</small><h3 id="workflow-issue-report-title">\u56de\u5831\u7533\u8acb\u898f\u5b9a\u932f\u8aa4</h3></div>\n          <button type="button" class="icon-button" data-close-workflow-issue-report aria-label="\u95dc\u9589"><i data-lucide="x" aria-hidden="true"></i></button>\n        </header>\n        <div id="workflow-issue-report-context" class="workflow-issue-report-context"></div>\n        <p class="workflow-issue-report-boundary"><strong>\u56de\u5831\u4e0d\u6703\u76f4\u63a5\u4fee\u6539\u5b78\u751f\u770b\u5230\u7684\u6b63\u5f0f\u898f\u5b9a\u3002</strong>\u5167\u5bb9\u7ba1\u7406\u54e1\u53ea\u6703\u5148\u5224\u5b9a\u56de\u5831\u662f\u5426\u6210\u7acb\uff1b\u6b63\u5f0f\u66f4\u6b63\u4ecd\u9808\u53e6\u8d70 revision\u3001\u96d9\u4eba\u5be9\u67e5\u8207\u767c\u5e03\u6d41\u7a0b\u3002</p>\n        <div class="workflow-issue-report-fields">\n          <label><span>\u554f\u984c\u985e\u578b</span><select name="category" required><option value="eligibility">\u7533\u8acb\u8cc7\u683c</option><option value="deadline">\u622a\u6b62\u671f\u9650</option><option value="document">\u6587\u4ef6\u6216\u4efd\u6578</option><option value="submission">\u9001\u4ef6\u65b9\u5f0f</option><option value="source">\u5b98\u65b9\u4f86\u6e90</option><option value="other" selected>\u5176\u4ed6</option></select></label>\n          <label><span>\u554f\u984c\u8aaa\u660e</span><textarea name="description" minlength="10" maxlength="1000" rows="5" required placeholder="\u8acb\u63cf\u8ff0\u76ee\u524d\u986f\u793a\u5167\u5bb9\u8207\u5b98\u65b9\u898f\u5b9a\u4e0d\u4e00\u81f4\u7684\u5730\u65b9\uff0c\u4ee5\u53ca\u6b63\u78ba\u8cc7\u8a0a\u4f4d\u65bc\u4f86\u6e90\u7684\u54ea\u4e00\u6bb5\u3002"></textarea><small>\u4e0d\u8981\u586b\u5beb\u59d3\u540d\u3001\u96fb\u5b50\u90f5\u4ef6\u3001\u96fb\u8a71\u3001\u5b78\u865f\u6216\u5176\u4ed6\u806f\u7d61\u8cc7\u6599\u3002</small></label>\n          <label><span>\u5b98\u65b9\u4f86\u6e90\u7db2\u5740</span><input name="official_source_url" type="url" inputmode="url" minlength="12" maxlength="2000" pattern="https://.*" required placeholder="https://\u5b78\u6821\u5b98\u65b9\u7db2\u7ad9/\u898f\u5b9a\u9801\u9762" /><small>\u53ea\u63a5\u53d7\u516c\u958b HTTPS \u7db2\u5740\uff1b\u9001\u51fa\u6642\u4e0d\u6703\u81ea\u52d5\u958b\u555f\u6216\u6293\u53d6\u8a72\u9801\u9762\u3002</small></label>\n        </div>\n        <label class="application-file-consent-check workflow-issue-report-confirm"><input name="confirm_boundary" type="checkbox" required /><span><strong>\u6211\u78ba\u8a8d\u9019\u662f\u898f\u5b9a\u932f\u8aa4\u56de\u5831\uff0c\u4e0d\u542b\u500b\u4eba\u8cc7\u6599\u6216\u79c1\u4eba\u6587\u4ef6</strong><small>\u5e73\u53f0\u6703\u4fdd\u5b58\u56de\u5831\u5167\u5bb9\u3001\u76ee\u6a19\u6d41\u7a0b\u7248\u672c\u8207\u8655\u7406\u7d50\u679c\uff0c\u4ee5\u907f\u514d\u932f\u8aa4\u898f\u5b9a\u6301\u7e8c\u5f71\u97ff\u5b78\u751f\u3002</small></span></label>\n        <div id="workflow-issue-report-status" class="form-status" role="status" aria-live="polite"></div>\n        <footer><button type="button" class="secondary-button" data-close-workflow-issue-report>\u53d6\u6d88</button><button type="submit" class="primary-button"><i data-lucide="send" aria-hidden="true"></i><span>\u9001\u51fa\u56de\u5831</span></button></footer>\n      </form>\n    </dialog>\n\n    <div class="app-shell">\n      <aside class="sidebar" aria-label="\u4e3b\u8981\u5c0e\u89bd">\n        <a class="brand global-brand" href="#home" aria-label="UniWay \u9996\u9801">\n          <span class="brand-mark" aria-hidden="true"><img src="/static/assets/brand/uniway-mark.webp?v=20261004-logo-2" alt="" width="40" height="40" decoding="async" /></span>\n          <span><strong>UniWay</strong><small>\u63a2\u7d22\u4e16\u754c \xb7 \u5b8c\u6210\u7533\u8acb</small></span>\n        </a>\n        <a class="brand university-brand" href="#home" aria-label="\u8fd4\u56de UniWay \u9996\u9801">\n          <span class="brand-mark" aria-hidden="true"><img src="/static/assets/brand/uniway-mark.webp?v=20261004-logo-2" alt="" width="40" height="40" decoding="async" /></span>\n          <span><strong>UniWay</strong><small>\u500b\u4eba\u7533\u8acb\u5de5\u4f5c\u5340</small></span>\n        </a>\n\n        <nav class="global-sidebar-nav" aria-label="\u7559\u5b78\u793e\u7fa4\u529f\u80fd\u9078\u55ae">\n          <a class="nav-item active" href="#forum" data-community-route="all"><i data-lucide="messages-square" aria-hidden="true"></i><span>\u8ad6\u58c7</span></a>\n          <a class="nav-item" href="#following" data-community-route="following"><i data-lucide="rss" aria-hidden="true"></i><span>\u6211\u7684\u8ffd\u8e64</span></a>\n          <button id="sidebar-community-compose" type="button" class="nav-item nav-button"><i data-lucide="square-pen" aria-hidden="true"></i><span>\u767c\u8868\u6587\u7ae0</span></button>\n        </nav>\n\n        <section class="sidebar-board-list" aria-labelledby="sidebar-board-title">\n          <div class="sidebar-board-heading"><span id="sidebar-board-tit